.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 8px 0 calc(8px + env(safe-area-inset-bottom));
  background: white;
  border-top: 1px solid #f0f0f0;
}
.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  min-height: 50px;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: #222;
}
.tab-icon {
  box-sizing: border-box;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 2px solid #111;
}
.tab.active .tab-icon {
  background-color: #ffdd16;
}

.tab-icon {border:0;border-radius:8px;position:relative;width:42px;height:30px}
