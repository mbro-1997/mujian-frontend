.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #090f1e;
  border-top: 1px solid rgba(148, 163, 184, 0.16);
  backdrop-filter: blur(12px);
  display: flex;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
}

.tab-text {
  font-size: 20rpx;
  color: #64748b;
}

.tab-text.selected {
  color: #22d3ee;
  font-weight: 600;
}
