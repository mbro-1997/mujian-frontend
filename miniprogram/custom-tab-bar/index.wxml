<view wx:if="{{!hidden}}" class="tabbar"
  ><view
    wx:for="{{items}}"
    wx:key="path"
    class="tab {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
    ><view class="tab-icon"><image src="{{item.icon}}" mode="aspectFit" aria-hidden="{{true}}"/></view><text>{{item.text}}</text></view
  ></view
>
