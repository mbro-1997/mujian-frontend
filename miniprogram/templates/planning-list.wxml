<view class="pl-screen pl-checklist">
  <view class="pl-hero">
    <view class="pl-intro">
      <view class="pl-heading">我的清单</view>
      <view class="pl-copy">每张清单绑定一段租赁时间。最多保留 3 张未转订单清单，只有当前清单可以继续选品。</view>
    </view>
    <button class="pl-action pl-main pl-create" bindtap="create">选择租期新建清单</button>
  </view>

  <button wx:if="{{filter==='history'}}" class="pl-link" data-value="active" bindtap="filter">返回未转单清单</button>

  <view wx:if="{{message}}" class="pl-feedback">{{message}}
    <button class="pl-action" bindtap="retry">重试</button>
    <button class="pl-action" bindtap="recover">查询原操作结果</button>
  </view>
  <view wx:elif="{{!items.length}}" class="pl-empty">{{busy?'正在加载…':filter==='history'?'暂无历史清单':'暂无清单'}}</view>

  <view wx:for="{{items}}" wx:key="id" class="pl-card">
    <view class="pl-head">
      <view class="pl-intro"><view class="pl-title">{{item.listTitle}}</view>
        <view wx:if="{{item.note}}" class="pl-note">{{item.note}}</view>
      </view>
      <text class="pl-badge {{item.status==='editing'||item.status==='selecting'?'pl-current':''}}">{{item.statusLabel}}</text>
    </view>
    <view class="pl-metrics">
      <view class="pl-metric"><text>道具</text>{{item.quantityTotal}} 件</view>
      <view class="pl-metric"><text>日租</text>{{item.dailyText}}</view>
      <view wx:if="{{item.status==='suspended'}}" class="pl-metric"><text>租期</text>{{item.rentalDays}}天</view>
      <view wx:else class="pl-metric"><text>押金</text>{{item.depositText}}</view>
    </view>
    <view class="pl-actions">
      <button class="pl-action {{item.status==='selecting'?'pl-main':''}}" data-id="{{item.id}}" bindtap="open">查看清单</button>
      <button wx:if="{{item.status==='selecting'}}" class="pl-action" data-id="{{item.id}}" bindtap="continue">继续选品</button>
      <button wx:elif="{{item.status==='suspended'}}" class="pl-action pl-main" data-id="{{item.id}}" bindtap="activate">切换为当前</button>
    </view>
  </view>
  <view wx:if="{{items.length && !message && items.length < total}}" class="pl-empty">{{busy?'正在加载…':'上拉加载更多'}}</view>
  <button wx:if="{{filter==='active'}}" class="pl-link" disabled="{{busy}}" data-value="history" bindtap="filter">查看历史清单</button>
</view>
