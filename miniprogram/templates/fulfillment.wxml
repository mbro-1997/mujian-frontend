<view class="fulfill">
  <view wx:if="{{message}}" class="alert" role="alert">{{message}}<button bindtap="load" disabled="{{busy}}">刷新进度</button><button wx:if="{{pending}}" bindtap="recover" disabled="{{busy}}">查询原操作</button></view>
  <view wx:if="{{!detail && !message}}" class="panel muted"><mj-loading wx:if="{{busy && !returnRefresh}}" label="正在读取履约进度"/><text wx:else>暂无可查看的履约记录</text></view>
  <block wx:if="{{detail}}">
<navigator wx:if="{{(view==='returnCheck'||view==='complete') && root.id}}" url="/pages/service/index?type=return_verification&id={{root.id}}">咨询此归还核验 ›</navigator>
    <list-filters quiet="{{returnRefresh}}" filters="{{stageFilters}}" values="{{ {view:view} }}" disabled="{{busy}}" bindselectfilter="changeStage"/>
    <view class="panel hero">
      <view class="heading"><text>{{view==='outbound'?detail.factoryName:view==='shipment'?(pickup?'工厂取回':'用户送回'):view==='receipt'?'收货核验':view==='returnCheck'?'归还核验':view==='complete'?'核验结果':'履约记录'}}</text><text wx:if="{{view!=='history'}}" class="tag">{{statusText}}</text></view>
      <view class="muted">订单 {{detail.orderNo}} · {{detail.startDate}} 至 {{detail.endDate}}</view>
      <view wx:if="{{view==='outbound' || view==='shipment'}}" class="row"><text>运输方式</text><text>{{modeText}}</text></view>
      <view wx:if="{{context.overdue}}" class="alert">已超过原租期，待归还核验</view>
      <view wx:if="{{!context.disputeProtectionReady}}" class="notice">异议处理尚未开放，正常交接和自动收尾已暂停。如需处理，请联系平台。<button open-type="contact">联系平台客服</button></view>
      <view wx:if="{{view==='receipt' && dates.startAt}}" class="row"><text>核验开始</text><text>{{dates.startAt}}</text></view>
      <view wx:if="{{view==='receipt' && !root.confirmedAt && dates.deadlineAt}}"><view class="row"><text>核验截止</text><text>{{dates.deadlineAt}}</text></view><view class="notice">{{root.paused?'收货核验已暂停':remaining}}</view></view>
      <view wx:if="{{view==='receipt' && dates.confirmedAt}}" class="row"><text>实际收货</text><text>{{dates.confirmedAt}}</text></view>
    </view>
    <view wx:if="{{view==='outbound' || view==='returnCheck'}}" class="panel">
      <view class="heading"><text>{{view==='outbound'?'出库道具核对':'归还道具核对'}}</text><text class="tag">{{progress}} / {{expected}}</text></view>
      <view wx:for="{{items}}" wx:key="itemId" class="item">
        <view class="row"><text class="bold">{{item.name}}</text><text>{{item.checkedQuantity}} / {{item.expectedQuantity}}</text></view>
        <view class="muted">{{item.assetType==='A_ASSET'?'A 类 · 逐件核对实物码':'B 类 · 按数量核对'}}{{item.complete?' · 已齐全':''}}</view>
        <view wx:if="{{item.requirement}}" class="note">{{item.requirement}}</view>
        <view wx:if="{{item.assetType==='B_CONSUMABLE' && actions.set_quantity}}" class="toolbar">
          <input id="field-row-{{index}}-quantityInput" adjust-position="{{false}}" always-embed type="number" value="{{item.quantityInput}}" data-index="{{index}}" bindinput="quantityInput" aria-label="已核对总数量"/>
          <button data-index="{{index}}" bindtap="quantity" disabled="{{busy || pending}}">保存数量</button>
        </view>
      </view>
      <button wx:if="{{actions.scan && hasAsset}}" class="dark" bindtap="scan" disabled="{{busy || pending}}">扫道具码</button>
      <view wx:if="{{records.length}}" class="subhead">已扫实物</view>
      <view wx:for="{{records}}" wx:key="id" class="row"><text>{{item.label}}</text><text class="muted">{{item.time}}</text></view>
      <button wx:if="{{moreRecords}}" bindtap="moreRecords" disabled="{{busy}}">更多扫码记录</button>
    </view>
    <block wx:if="{{factory && view==='returnCheck'}}" wx:for="{{claimStock}}" wx:for-item="claim" wx:for-index="ci" wx:key="claimId">
      <view wx:if="{{claim.canRecord || claim.records.length}}" class="panel">
        <view class="heading">索赔实物核验</view>
        <view wx:for="{{claim.lines}}" wx:key="reservationId" class="item">
          <view class="bold">{{item.name}} {{item.snCode}}</view><view>仍占用 {{item.heldQuantity}} 件，待登记 {{item.unrecordedQuantity}} 件</view>
          <button wx:if="{{claim.canRecord && item.unrecordedQuantity}}" data-claim="{{ci}}" data-line="{{index}}" bindtap="openStock" disabled="{{busy || pending}}">登记核验结果</button>
        </view>
        <view wx:for="{{claim.records}}" wx:key="id" class="item">
          <view>{{item.label}} · {{item.quantity}} 件 · {{item.statusText}}</view><view class="muted">{{item.remark}}</view>
          <button wx:if="{{claim.canRecord && item.status==='repair_pending'}}" data-claim="{{ci}}" data-record="{{index}}" bindtap="openStock" disabled="{{busy || pending}}">登记维修结果</button>
        </view>
      </view>
    </block>
    <view wx:if="{{stockForm}}" class="panel">
      <view class="heading">{{stockForm.name}} {{stockForm.snCode}}</view>
      <dict-select value="{{stockForm.choice}}" range="{{stockChoices}}" range-key="label" data-field="choice" bindchange="editStock" title="实际处置" display="{{stockForm.choice==null?'请选择':stockChoices[stockForm.choice].label}}" quiet="{{returnRefresh}}"/>
      <label>数量<input id="field-stockForm-quantity" adjust-position="{{false}}" always-embed type="number" value="{{stockForm.quantity}}" disabled="{{stockForm.snId || stockForm.replacesId}}" data-field="quantity" bindinput="editStock"/></label>
      <textarea id="field-stockForm-remark" adjust-position="{{false}}" maxlength="500" value="{{stockForm.remark}}" data-field="remark" bindinput="editStock" placeholder="填写实际到厂核验或处置情况"/>
      <button bindtap="submitStock" disabled="{{busy || pending}}">确认登记</button><button bindtap="cancelStock">取消</button>
    </view>
    <view wx:if="{{canReport}}" class="panel">
      <button wx:if="{{!issueOpen}}" bindtap="openIssue" disabled="{{busy || pending}}">{{view==='receipt'?'上报收货问题':'上报使用中异常'}}</button>
      <block wx:else>
        <view class="heading">涉及道具与问题</view>
        <view wx:for="{{issueRows}}" wx:key="index" class="item">
          <dict-select range="{{items}}" range-key="name" value="{{item.itemIndex}}" data-index="{{index}}" data-field="itemIndex" bindchange="editIssueItem" title="道具" display="{{items[item.itemIndex].name}}" quiet="{{returnRefresh}}"/>
          <dict-select range="{{issueTypes}}" range-key="label" value="{{item.typeIndex}}" data-index="{{index}}" data-field="typeIndex" bindchange="editIssueItem" title="问题类型" display="{{issueTypes[item.typeIndex].label}}" quiet="{{returnRefresh}}"/>
          <label>受影响数量<input id="field-row-{{index}}-quantity" adjust-position="{{false}}" always-embed type="number" value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="editIssueItem"/></label>
          <button wx:if="{{issueRows.length>1}}" data-index="{{index}}" bindtap="removeIssueItem">移除此项</button>
        </view>
        <button bindtap="addIssueItem">添加一项</button>
        <textarea id="field-issueSummary" adjust-position="{{false}}" maxlength="1000" placeholder="说明发生了什么，哪些道具受到影响" value="{{issueSummary}}" bindinput="editIssueSummary"/>
        <view class="mj-photo-drafts" wx:if="{{issuePhotos.length}}"><view wx:for="{{issuePhotos}}" wx:key="id" class="mj-photo-frame"><image src="{{item.src}}" mode="aspectFill"/><photo-remove disabled="{{busy || pending}}" identity="{{item.id}}" data-id="{{item.id}}" bindremove="removeDraftPhoto"/></view></view>
      <button bindtap="attachIssuePhoto" disabled="{{busy || pending}}">添加照片{{issuePhotos.length?'（已选 '+issuePhotos.length+' 张）':''}}</button>
        <radio-group bindchange="selectIssueEffect">
          <label><radio value="continue" checked="{{issueEffect==='continue'}}"/>继续履约，请客服跟进</label>
          <label><radio value="paused" checked="{{issueEffect==='paused'}}"/>暂停履约，申请客服介入</label>
        </radio-group>
        <button class="dark" bindtap="submitIssue" disabled="{{busy || pending}}">提交问题</button>
      </block>
    </view>
    <view wx:if="{{view==='receipt' || view==='shipment'}}" class="panel">
      <view class="heading">道具明细</view>
      <view wx:for="{{items}}" wx:key="itemId" class="item"><view class="row"><text>{{item.name}}</text><text>× {{item.expectedQuantity}}</text></view><view wx:if="{{item.requirement}}" class="muted">{{item.requirement}}</view></view>
      <view wx:if="{{detail.transportNotice}}" class="notice">{{detail.transportNotice}}</view>
    </view>
    <view wx:if="{{view==='shipment'}}" class="panel">
      <view class="heading">{{pickup?'取回信息':'发出信息'}}</view>
      <block wx:if="{{pickup}}">
        <view class="row"><text>取回地址</text><text>{{detail.receiver.regionText}} {{detail.receiver.detailAddress}}</text></view>
        <view wx:if="{{!factory}}" class="row"><text>联系人</text><text>{{detail.receiver.name}} {{pickupPhone}}</text></view>
      </block>
      <block wx:if="{{actions.save || actions.start_pickup}}">
        <radio-group wx:if="{{!pickup}}" data-field="handoverMethod" bindchange="edit"><label><radio value="carrier" checked="{{form.handoverMethod==='carrier'}}"/>交给承运人</label><label><radio value="self_delivery" checked="{{form.handoverMethod==='self_delivery'}}"/>自行送回</label></radio-group>
        <label wx:if="{{!pickup}}">交接时间有争议 <switch data-field="disputed" bindchange="edit" checked="{{form.disputed}}"/></label>
        <text class="subhead">{{pickup?'预计到厂时间':(form.handoverMethod==='self_delivery'?'实际开始送回时间':'实际交运时间')}}（北京时间）</text>
        <view class="pickers"><picker mode="date" value="{{form.date}}" data-field="date" bindchange="edit"><view class="mj-system-picker"><text>{{form.date || '选择日期'}}</text></view></picker><picker mode="time" value="{{form.time}}" data-field="time" bindchange="edit"><view class="mj-system-picker"><text>{{form.time || '选择时间'}}</text></view></picker></view>
        <label wx:if="{{!pickup}}">秒（可精确至毫秒）<input id="field-form-seconds" adjust-position="{{false}}" always-embed maxlength="6" value="{{form.seconds}}" placeholder="00" data-field="seconds" bindinput="edit"/></label>
        <block wx:if="{{!pickup}}"><input id="field-form-carrierName" adjust-position="{{false}}" always-embed maxlength="128" value="{{form.carrierName}}" placeholder="承运方（如有）" data-field="carrierName" bindinput="edit"/><input id="field-form-trackingNo" adjust-position="{{false}}" always-embed maxlength="128" value="{{form.trackingNo}}" placeholder="运单号，或在备注填写交接说明" data-field="trackingNo" bindinput="edit"/></block>
      </block>
      <block wx:else><view class="row"><text>{{pickup?'开始取回':'实际发出'}}</text><text>{{dates.sentAt || '待实际交接'}}</text></view><view wx:if="{{dates.expectedArrivalAt}}" class="row"><text>预计到厂</text><text>{{dates.expectedArrivalAt}}</text></view><view wx:if="{{root.carrierName || root.trackingNo}}">{{root.carrierName}} {{root.trackingNo}}</view></block>
      <view wx:if="{{dates.expectedCheckStartAt}}" class="row"><text>预计核验开始</text><text>{{dates.expectedCheckStartAt}}</text></view>
    </view>
    <view wx:if="{{view==='outbound' || view==='receipt' || view==='shipment' || view==='returnCheck'}}" class="panel">
      <block wx:if="{{view==='outbound'}}"><list-filters quiet="{{returnRefresh}}" filters="{{photoFilters}}" values="{{ {photoKind:photoKind} }}" disabled="{{busy}}" bindselectfilter="photoKind"/></block>
      <view class="heading"><text>{{view==='outbound'?(photoKind==='handover'?'交接照片':'出库照片'):view==='receipt'?'收货照片':view==='shipment'?'包装与交接照片':'归还核验照片'}}</text><text class="tag">{{view==='outbound' && photoKind==='outbound'?'至少 3 张':'选填'}}</text></view>
      <view wx:if="{{canPhoto && view==='outbound' && photoKind==='outbound'}}" class="muted">建议拍摄整体、重点部位和装车情况，便于收货时核对。</view>
      <view class="grid"><view wx:for="{{photos}}" wx:key="id" class="tile">
        <image wx:if="{{item.url}}" mode="aspectFill" src="{{item.url}}" data-id="{{item.id}}" bindtap="preview" aria-label="查看交接照片"/>
        <button wx:else bindtap="preview" data-id="{{item.id}}">查看照片</button>
        <photo-remove wx:if="{{canRemove}}" identity="{{item.id}}" bindremove="remove" data-id="{{item.id}}" disabled="{{busy || pending}}"/>
      </view><button wx:if="{{canPhoto}}" class="add" bindtap="photo" disabled="{{busy || pending}}">＋ 添加</button></view>
      <view wx:if="{{!photos.length && !canPhoto}}" class="muted">当前节点尚无照片</view>
      <button wx:if="{{morePhotos}}" bindtap="morePhotos" disabled="{{busy}}">查看更多照片</button>
    </view>
    <view wx:if="{{(view==='outbound' || view==='shipment') && (actions.save || actions.start_pickup || root.remark)}}" class="panel"><view class="heading">备注</view><textarea id="field-form-remark" adjust-position="{{false}}" wx:if="{{actions.save || actions.start_pickup}}" value="{{form.remark}}" data-field="remark" maxlength="500" bindinput="edit" placeholder="填写包装、运输要求或实际交接情况"/><view wx:else>{{root.remark}}</view></view>
    <view wx:if="{{view==='receipt' && actions.confirm}}" class="panel"><view class="heading">核验说明</view>请核对实物的数量和外观。实际收到后可提前确认。</view>
    <view wx:if="{{canRecordPickup && (view==='returnCheck' || view==='shipment')}}" class="panel">
      <view class="heading">实际从买家处接走</view><text>交接时间（北京时间）</text>
      <view class="pickers"><picker mode="date" value="{{form.actualDate}}" data-field="actualDate" bindchange="edit"><view class="mj-system-picker"><text>{{form.actualDate || '选择日期'}}</text></view></picker><picker mode="time" value="{{form.actualTime}}" data-field="actualTime" bindchange="edit"><view class="mj-system-picker"><text>{{form.actualTime || '选择时间'}}</text></view></picker></view>
      <label>秒（可精确至毫秒）<input id="field-actualSeconds" adjust-position="{{false}}" always-embed maxlength="6" placeholder="00" data-field="actualSeconds" bindinput="edit"/></label>
      <input id="field-actualBasis" adjust-position="{{false}}" always-embed data-field="actualBasis" maxlength="500" bindinput="edit" placeholder="填写交接人或签收凭据"/><label>交接时间有争议 <switch data-field="disputed" bindchange="edit"/></label>
      <button class="primary" disabled="{{busy || pending}}" bindtap="recordPickup">确认已接走</button>
    </view>
    <view wx:if="{{fee && (view==='returnCheck' || view==='shipment' || view==='complete')}}" class="panel">
      <view class="heading">归还费用 · {{fee.label}}</view>
      <view>有效归还日 {{fee.dueDate}} · {{fee.method}} {{fee.at}}</view>
      <view>实际逾期 {{fee.elapsed}} · 计费 {{fee.days==null?'待核实':fee.days+' 天'}}</view>
      <view wx:if="{{fee.excludedMs}}">已核实排除 {{fee.excludedMs/1000}} 秒</view>
      <view>{{fee.status==='effective'?'逾期租金':'预估租金'}} {{fee.rent}} · 责任扣款上限 {{fee.cap}}</view>
      <view>核定责任扣款 {{fee.liability}}</view>
      <view>租金：押金抵 {{fee.rentOffset}} · 应补 {{fee.rentDue}} · 已补 {{fee.rentPaid}}</view>
      <view>责任扣款：押金抵 {{fee.liabilityOffset}} · 应补 {{fee.liabilityDue}} · 已补 {{fee.liabilityPaid}}</view>
      <view>可用押金 {{fee.remaining}}</view><view wx:if="{{fee.reviewBasis}}">核定依据 {{fee.reviewBasis}}</view>
      <navigator wx:if="{{fee.receivableId}}" url="/pages/{{factory?'factory':'orders'}}/disputes?kind=compensation-receivables&id={{fee.receivableId}}">查看补缴明细</navigator>
    </view>
    <view wx:if="{{view==='returnCheck'}}" class="panel"><view class="heading">核验时间</view><view class="row"><text>实际开始</text><text>{{dates.startAt || '待开始'}}</text></view><view wx:if="{{dates.warningAt}}" class="row"><text>预警时间</text><text>{{dates.warningAt}}</text></view><view wx:if="{{dates.autoCloseAt && !detail.disputes.terminationActive}}" class="row"><text>预计自动关闭</text><text>{{dates.autoCloseAt}}</text></view><view class="notice">{{root.claimCreated?'本次归还已有索赔。':'请检查数量、外观、清洁及包装。无异常入库无需拍照。'}}</view></view>
    <view wx:if="{{view==='complete'}}" class="panel"><view class="heading">处理结果</view><view class="row"><text>核验状态</text><text>{{statusText}}</text></view><view wx:if="{{dates.closedAt}}" class="row"><text>关闭时间</text><text>{{dates.closedAt}}</text></view><view class="row"><text>押金状态</text><text>{{depositText}}</text></view><view class="row"><text>库存占用</text><text>{{root.inventoryReleased?'已释放':'尚未释放'}}</text></view><block wx:if="{{!factory}}"><button wx:for="{{root.refundIds}}" wx:key="*this" bindtap="refund" data-id="{{item}}">查看退款进度 {{index+1}} ›</button></block></view>
    <view wx:if="{{view==='history'}}" class="panel"><view class="heading">履约时间线</view><view wx:for="{{records}}" wx:key="id" class="event"><text class="bold">{{item.label}}</text><text class="muted">{{item.time}}</text></view><view wx:if="{{!records.length}}" class="muted">尚无履约事件</view><button wx:if="{{moreRecords}}" bindtap="moreRecords" disabled="{{busy}}">加载更多</button></view>
    <view class="foot">
      <button wx:if="{{actions.save}}" bindtap="submit" data-action="save" disabled="{{busy || pending}}">暂存</button>
      <button wx:if="{{view==='outbound' && actions.confirm}}" class="primary" bindtap="submit" data-action="confirm" disabled="{{busy || pending}}">确认出库</button>
      <button wx:if="{{view==='receipt' && actions.confirm}}" class="primary" bindtap="submit" data-action="confirm" disabled="{{busy || pending}}">确认收货</button>
      <button wx:if="{{actions.send}}" class="primary" bindtap="submit" data-action="send" disabled="{{busy || pending}}">确认已发出</button>
      <button wx:if="{{actions.start_pickup}}" class="primary" bindtap="submit" data-action="start_pickup" disabled="{{busy || pending}}">开始取回</button>
      <button wx:if="{{view==='returnCheck' && actions.confirm_termination}}" class="primary" bindtap="submit" data-action="confirm_termination" disabled="{{busy || pending}}">按终止方案确认入库</button>
      <button wx:if="{{factory && view==='returnCheck' && actions.create_claim}}" bindtap="createClaim" disabled="{{busy}}">提出归还索赔</button>
      <button wx:if="{{view==='returnCheck' && actions.confirm_no_issue}}" class="primary" bindtap="submit" data-action="confirm_no_issue" disabled="{{busy || pending}}">无异常入库</button>
      <button wx:if="{{pending}}" bindtap="recover" disabled="{{busy}}">查原操作</button>
      <button wx:if="{{!actions.confirm && !actions.save && !actions.send && !actions.start_pickup && !actions.confirm_termination && !(view==='returnCheck' && actions.confirm_no_issue)}}" bindtap="navigationBack">返回</button>
    </view>
  </block>
</view>
