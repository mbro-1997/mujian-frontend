@import "planning.wxss";
.address-edit{background:#fff;min-height:100vh;padding:16px 16px calc(108px + env(safe-area-inset-bottom))}
.address-edit .card{border:0;padding:0;margin:0}
.address-edit .row{align-items:center;margin:0 0 24px}.address-edit .row>view:last-child{display:flex;align-items:center;gap:6px;font-size:12px;color:#6b7280}
.address-edit .field{display:grid;grid-template-columns:72px minmax(0,1fr);gap:12px;margin:0 0 20px;align-items:start}
.address-edit .field-label{font-size:14px;line-height:44px;color:#111827;margin:0}
.address-edit input,.address-edit picker{box-sizing:border-box;height:44px;margin:0;width:100%;min-width:0;font-size:14px;padding:10px 12px;line-height:22px;border:1px solid #e5e7eb;border-radius:4px;background:white}
.address-edit textarea{width:100%;height:110px;min-height:110px;margin:0;box-sizing:border-box;padding:12px;border:1px solid #e5e7eb;border-radius:4px;background:white;font-size:14px}
.address-list{padding:16px 16px calc(110px + env(safe-area-inset-bottom))}
.address-list .card{padding:16px;margin:0;border:0;border-radius:0;border-bottom:1px solid #eee}
.address-list .title{font-size:16px;line-height:1.5}.address-list .muted{font-size:13px;margin:6px 0}
.address-list .buttons{justify-content:flex-end;margin:8px 0 0;gap:12px}.address-list .buttons button{flex:none;width:auto;min-width:44px;margin:0;padding:8px;font-size:12px;border-radius:4px}
.address-list .footer,.address-edit .footer{padding:12px 16px calc(20px + env(safe-area-inset-bottom));border:0}
.address-list .footer button,.address-edit .footer button{height:54px;border-radius:28px;font-size:18px;font-weight:900;padding:0;line-height:54px}
