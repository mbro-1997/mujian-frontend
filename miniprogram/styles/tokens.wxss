/* 方案 A 的尺度。全小程序共用的颜色、间距与触控尺寸。 */
page {
  --mj-canvas: #f3f5f1;
  --mj-paper: #fff;
  --mj-ink: #242924;
  --mj-muted: #5c665d;
  --mj-line: #dfe4dc;
  --mj-soft: #f5f7f4;
  --mj-accent: #ffe444;
  --mj-active-bg: #e7f0e8;
  --mj-active-ink: #355c43;
  --mj-edge: 16px;
  --mj-card: 14px;
  --mj-control: 10px;
  --mj-tap: 44px;
}
