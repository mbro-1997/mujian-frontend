/* 11 定制购买模块：390px 画布，12px 页面/卡片内距，44px 表单操作。 */
.custom{background:#f5f5f5;min-height:100vh;padding:12px 12px calc(32px + env(safe-area-inset-bottom));color:#111827;box-sizing:border-box;overflow-wrap:anywhere}
.custom .tabs,.custom .bar{display:flex;align-items:center;justify-content:space-between;gap:10px}
.custom button{font-size:14px;line-height:1.3;min-height:44px;margin:8px 0;padding:10px 14px;border-radius:8px;background:#f3f4f6;color:#111827;font-weight:800}
.custom button[disabled]{color:#9ca3af;background:#f3f4f6}
.custom .tabs{margin-bottom:12px}.custom .tabs button{flex:1;min-width:0;margin:0}
.custom .selected,.custom .primary{background:#ffe100;color:#111827}
.custom .card{background:#fff;padding:12px;margin:0 0 12px;border:1px solid #eee;border-radius:8px}
.custom .title{font-size:17px;font-weight:900;line-height:1.4;min-width:0}
.custom .muted,.custom .hint{font-size:12px;line-height:1.6;color:#6b7280;margin:8px 0}
.custom .notice{font-size:12px;line-height:1.6;padding:12px;background:#fff7cc;border-radius:8px;color:#765711;margin:12px 0}
.custom input,.custom textarea,.custom picker{box-sizing:border-box;min-width:0;padding:10px 12px;background:#f8fafc;border:1px solid #e5e7eb;border-radius:8px;margin:8px 0 12px;font-size:14px;line-height:22px}
.custom input,.custom picker{min-height:44px}.custom textarea{width:100%;height:90px}
.custom .field{display:block;margin-top:12px;font-size:13px;font-weight:700}
.custom .line{border-top:1px solid #eee;padding:12px 0;line-height:1.6}
.custom .bar>.title{flex:1}.custom .bar>text:last-child{flex-shrink:0;font-size:12px}
.custom .bar>picker{flex:1;margin:0}.custom .bar>button{flex:none}
.custom .form-actions{display:flex;gap:10px;position:fixed;bottom:0;left:0;right:0;padding:12px 12px calc(12px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid #eee;z-index:10}
.custom .form-actions button{flex:1;margin:0;min-width:0;height:44px}
.custom.has-form-actions{padding-bottom:calc(100px + env(safe-area-inset-bottom))}

.custom .material-preview{width:100%;padding:0;background:transparent;text-align:left;font-size:12px;font-weight:400;color:#6b7280;overflow-wrap:anywhere}
