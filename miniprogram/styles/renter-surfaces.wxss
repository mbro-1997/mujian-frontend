/* 仅由租赁方的独立页面导入；工厂虽使用部分相同 WXML，不导入此文件。 */
page, .custom, .verify-page { background: var(--mj-canvas); color: var(--mj-ink); }
.trade, .trade.order-list, .custom, .planning, .verify-page, .fulfill, .product-page {
  padding-left: var(--mj-edge); padding-right: var(--mj-edge);
}
.trade, .trade.order-list, .custom, .fulfill { padding-top: 16px; }
.trade .section, .trade .order-card, .trade .coupon, .custom .card, .planning .card,
.verify-page .verify-card, .verify-page .verify-hero, .fulfill .panel, .product-page .panel, .date-page .month {
  border: 1px solid var(--mj-line); border-radius: var(--mj-card); background: var(--mj-paper);
}
.trade .section, .custom .card, .fulfill .panel, .product-page .panel { padding: 14px; }
.trade .heading, .custom .title, .planning .title, .verify-card .label { font-weight: 700; overflow-wrap: anywhere; }
.trade .muted, .planning .muted, .custom .muted, .verify-page .description { color: var(--mj-muted); line-height: 1.55; }
.trade .amount, .trade .strong, .pl-metric { font-variant-numeric: tabular-nums; }
.trade .footer button, .custom .form-actions button, .planning .footer button, .planning-detail .footer button.pl-action,
.verify-actions button, .product-page .footer-actions button, .date-actions button {
  width: auto; min-width: 0; min-height: var(--mj-tap); height: auto; line-height: 1.35;
  margin: 0; padding: 10px 12px; border-radius: var(--mj-control); font-size: 15px; font-weight: 650;
}
.verify-actions button { width: 100%; margin-top: 10px; }
.trade button.primary:not([disabled]), .planning button.primary:not([disabled]), .custom button.primary:not([disabled]),
.verify-page button.primary:not([disabled]), .product-page .primary-btn:not([disabled]), .date-actions .date-confirm,
.planning-detail .footer button.pl-main:not([disabled]) { background: var(--mj-accent); color: var(--mj-ink); }
.trade .footer, .planning .footer, .custom .form-actions, .date-actions, .product-page .footer-actions {
  padding-left: var(--mj-edge); padding-right: var(--mj-edge); border-top: 1px solid var(--mj-line);
}
.trade .blank, .address-list .empty, .custom .list-empty {
  margin: 12px 0; padding: 32px 16px; background: var(--mj-paper); border: 1px solid var(--mj-line);
  border-radius: var(--mj-card); text-align: center; font-size: 14px; color: var(--mj-muted); line-height: 1.55;
}
.trade .order-filter.selected, .custom .tabs .selected, .trade .toolbar .selected { background: var(--mj-active-bg); color: var(--mj-active-ink); }
.trade .order-filter { min-height: 44px; padding: 8px 12px; border-radius: 9px; font-weight: 600; }
.trade .order-filter-line { border: 0; padding: 0; }
.trade .order-searchbar button, .trade .order-search, .custom .bar picker, .trade textarea, .planning .field input,
.planning .field textarea, .verify-page .input { border-radius: var(--mj-control); }
.trade .order-search, .planning .field input, .planning .field textarea, .verify-page .input { background: white; border-color: var(--mj-line); }
.trade .blank .clear-order { display: block; width: auto; margin: 8px auto 0; padding: 8px 12px; min-height: 44px; background: transparent; color: var(--mj-active-ink); font-weight: 650; }
.custom .tabs { background: #e8ece6; border-radius: 12px; padding: 3px; gap: 3px; }
.custom .tabs button { background: transparent; font-weight: 600; }
.custom .tabs button.selected { background: white; color: var(--mj-ink); }
.custom .bar > picker { background: white; }
.custom .bar .create-demand { background: var(--mj-accent); }
.custom .card .bar { align-items: flex-start; }
.custom .card .bar > .title { flex: 1; }
.custom .card .bar > .row-status { padding: 3px 7px; border-radius: 6px; background: var(--mj-soft); color: var(--mj-muted); }
.planning.address-list .card { margin: 0 0 10px; }
.planning.address-edit .card { padding: 14px; }
.planning.address-edit { background: var(--mj-canvas); }
.planning-detail .badge.current { color: var(--mj-active-ink); background: var(--mj-active-bg); }
.verify-page .eyebrow { color: var(--mj-muted); font-weight: 600; }
.date-page .date-notice { background: var(--mj-paper); color: var(--mj-muted); }
@media (max-width: 350px) {
  .trade, .trade.order-list, .planning, .custom, .fulfill, .verify-page, .product-page { padding-left: 12px; padding-right: 12px; }
  .trade .row { gap: 8px; }
}
.planning .footer > button:only-child { width:100%; }
.order-card .order-open { justify-content:flex-end; color:var(--mj-active-ink); }
