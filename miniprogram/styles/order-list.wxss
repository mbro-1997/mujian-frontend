@import "trading.wxss";
.trade.order-list{padding:0 12px calc(28px + env(safe-area-inset-bottom))}
.order-secondary{padding:2px 0 12px;color:#6b7280;font-size:12px;text-align:right}
.order-card{border:1px solid #eee;background:white;border-radius:8px;margin-bottom:12px;overflow:hidden}
.order-top,.order-body,.order-stage{display:flex;justify-content:space-between;gap:12px;padding:12px;align-items:center;line-height:1.5}
.order-top{border-bottom:1px solid #eee;align-items:flex-start}.order-title{min-width:0;flex:1;font-size:15px;overflow-wrap:anywhere}
.trade .order-number{font-size:11px;margin-top:3px}
.order-body{font-size:13px}.order-body .strong{flex:none;font-size:16px}
.order-stage{border-top:1px solid #eee;font-size:12px;color:#6b7280}
.order-deadline,.order-refund{font-size:12px;line-height:1.5;padding:0 12px 10px;color:#9a5b19}
.order-controls { padding:0 12px 12px; margin-bottom:12px; background:white; border:1px solid var(--mj-line); border-radius:var(--mj-card); }
