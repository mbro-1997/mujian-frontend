.mask{position:fixed;inset:0;z-index:110;background:rgba(17,24,39,.48)}
.sheet{position:fixed;z-index:111;left:0;right:0;bottom:0;box-sizing:border-box;max-height:92vh;overflow-y:auto;padding:18px 18px max(22px,env(safe-area-inset-bottom));border-radius:22px 22px 0 0;background:#fff;color:#111827;box-shadow:0 -16px 42px rgba(17,24,39,.18);animation:rise .2s ease-out}
@keyframes rise{from{transform:translateY(100%)}to{transform:translateY(0)}}
.head,.summary,.option,.target,.count,.actions,.stepper{display:flex;align-items:center;gap:10px}
.head,.option,.count{justify-content:space-between}
.head{font-size:21px;font-weight:900}.desc,.meta,.empty{color:#596273}.desc{font-size:12px;margin:8px 0 12px;line-height:1.45}
.sheet button{width:auto;min-width:0;margin:0;padding:0 8px;line-height:1.2;font-weight:700;display:flex;align-items:center;justify-content:center}
.sheet button::after{border:0}.sheet button[disabled]{opacity:.48}
.sheet .close{flex:none;width:30px;height:30px;border-radius:50%;font-size:20px;background:#f5f5f5}
.summary,.option,.target{box-sizing:border-box;border:1px solid #eee;border-radius:10px;padding:10px 12px}
.summary{background:#f8fafc;padding:10px}.thumb{width:54px;height:42px;flex:none;overflow:hidden;border-radius:8px;background:#eee}
.copy{flex:1;min-width:0}.name{font-size:15px;font-weight:800;line-height:1.4;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.summary .name{font-size:14px}.meta{font-size:12px;line-height:1.45;margin-top:3px}
.list{max-height:min(190px,30vh);margin-top:12px}.option{min-height:58px;margin-bottom:8px}.option:last-child{margin-bottom:0}.sheet .join{min-width:44px;height:30px;border-radius:16px;background:#111827;color:#ffe100;font-size:12px}
.actions{margin-top:14px}.actions button{height:52px;border-radius:26px;font-size:17px}.actions .secondary{flex:0 1 104px;color:#535c6c;background:#f5f5f5}.actions .primary{flex:1;background:#ffe100;color:#111}
.target{margin:12px 0}.count{font-size:14px;font-weight:bold}.stepper{gap:0;background:#f4f5f7;border-radius:8px;overflow:hidden}.stepper button{height:36px;width:36px}.stepper input{width:55px;text-align:center;font-size:16px}.result{text-align:right}.empty,.error{padding:16px 0;font-size:14px}.empty{text-align:center}.error{color:#9b3625}.error text{text-decoration:underline}

.no-img{display:flex;align-items:center;justify-content:center;height:100%;font-size:10px;color:#596273}
.sheet { color:var(--mj-ink,#242924); padding-left:16px; padding-right:16px; }
.sheet .close { width:44px; height:44px; background:transparent; }
.sheet .summary,.sheet .option,.sheet .target { border-color:var(--mj-line,#dfe4dc); }
.sheet .actions button { min-height:44px; height:auto; padding:12px; border-radius:10px; font-size:15px; }
.sheet .actions .primary { background:var(--mj-accent,#ffe444); }
.sheet .stepper button { min-width:40px; min-height:44px; }
@media (prefers-reduced-motion:reduce) { .sheet { animation:none; } }
