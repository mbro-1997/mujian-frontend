.pl-screen .pl-action, .planning-detail button.pl-action {
  box-sizing: border-box; display: flex; align-items: center; justify-content: center;
  width: 100%; min-width: 0; height: var(--action-h,42px); padding: 0 8px; margin: 0;
  border-radius: 999px; border: 0; background: #f5f5f5; color: #6b7280;
  font-size: 14px; line-height: 1.2; font-weight: 900;
}
.pl-metric { min-height: var(--metric-h,46px); padding: 4px 9px; background: #f8fafc; border-radius: 8px; display: flex; flex-direction: column; justify-content: center; font-size: 14px; font-weight: 900; }

.pl-metric text { display:block; font-size:10px; color:#9ca3af; font-weight:800; margin-bottom:2px; }
.pl-screen .pl-main, .planning-detail button.pl-main { background:#ffe100; color:#111827; }
.planning-detail button.pl-danger { background:#fff1f2; color:#e11d48; }
.planning-detail button.pl-action[disabled] { background:#f5f5f5; color:#9ca3af; }
