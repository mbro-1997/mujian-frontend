<view wx:if="{{file.type==='image' || factoryFile}}" class="material {{compact?'compact':''}}"><image wx:if="{{src}}" src="{{src}}" mode="aspectFill" binderror="failed" lazy-load/><view wx:else class="fallback" catchtap="retry"><mj-loading wx:if="{{loading}}" label="正在加载图片"/><text wx:else>{{message||'参考图片'}}</text></view></view>
