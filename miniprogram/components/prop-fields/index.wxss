.fields-panel{box-sizing:border-box;background:#fff;border:1px solid var(--mj-line,#dfe4dc);border-radius:var(--mj-card,14px);padding:14px;margin-bottom:10px;color:var(--mj-ink,#242924)}.fields-heading{font-size:17px;font-weight:900;margin-bottom:10px}.fields-row{display:grid;grid-template-columns:86px minmax(0,1fr);gap:8px;padding:8px 10px;margin-top:6px;border-radius:8px;background:var(--mj-soft,#f5f7f4);font-size:13px;line-height:1.5}.fields-label{color:#6b7280}.fields-value{min-width:0;overflow-wrap:anywhere;font-weight:650}.fields-images{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.fields-thumb{width:100%;height:78px;border-radius:8px;background:#f0f0f0}.fields-fallback{display:flex;align-items:center;justify-content:center;font-size:12px;color:#6b7280}.fields-error{padding:10px;margin-top:10px;background:#fff0ed;color:#9d231c;font-size:13px;overflow-wrap:anywhere}

.fields-panel.fields-compact { border:0; border-top:1px solid var(--mj-line); border-radius:0; margin:0; padding:12px 0; }
.fields-compact .fields-heading { font-weight:650; font-size:14px; margin-bottom:6px; }
.fields-compact .fields-row { margin:0; background:transparent; padding:4px 0; }
.fields-compact .fields-value { font-weight:500; }
