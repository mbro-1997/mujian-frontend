.fields-panel{box-sizing:border-box;background:#fff;border:1px solid #eee;border-radius:8px;padding:12px;margin-bottom:10px;color:#111827}.fields-heading{font-size:17px;font-weight:900;margin-bottom:10px}.fields-row{display:grid;grid-template-columns:86px minmax(0,1fr);gap:8px;padding:8px 10px;margin-top:6px;border-radius:8px;background:#f8fafc;font-size:13px;line-height:1.5}.fields-label{color:#6b7280}.fields-value{min-width:0;overflow-wrap:anywhere;font-weight:650}.fields-images{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.fields-thumb{width:100%;height:78px;border-radius:8px;background:#f0f0f0}.fields-fallback{display:flex;align-items:center;justify-content:center;font-size:12px;color:#6b7280}.fields-error{padding:10px;margin-top:10px;background:#fff0ed;color:#9d231c;font-size:13px;overflow-wrap:anywhere}
