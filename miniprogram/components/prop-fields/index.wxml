<block wx:if="{{fields}}"><view class="fields-panel {{compact?'fields-compact':''}}" wx:for="{{groups}}" wx:key="title" wx:for-item="group"><view class="fields-heading">{{group.title}}</view><view class="fields-row" wx:for="{{group.rows}}" wx:key="label"><text class="fields-label">{{item.label}}</text><text class="fields-value">{{item.value}}</text></view></view><view class="fields-panel {{compact?'fields-compact':''}}"><view class="fields-heading">道具图片</view><view class="fields-images"><view wx:for="{{images}}" wx:key="index" data-locator="{{item.locator}}" bindtap="preview"><view class="fields-thumb"><prop-image locator="{{item.locator}}"/></view></view></view><view wx:if="{{message}}" class="fields-error">{{message}}</view></view></block>
