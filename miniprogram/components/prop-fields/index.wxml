<block wx:if="{{fields}}"><view class="fields-panel" wx:for="{{groups}}" wx:key="title" wx:for-item="group"><view class="fields-heading">{{group.title}}</view><view class="fields-row" wx:for="{{group.rows}}" wx:key="label"><text class="fields-label">{{item.label}}</text><text class="fields-value">{{item.value}}</text></view></view><view class="fields-panel"><view class="fields-heading">道具图片</view><view class="fields-images"><view wx:for="{{images}}" wx:key="index" data-locator="{{item.locator}}" bindtap="preview"><image wx:if="{{item.preview}}" class="fields-thumb" src="{{item.preview.url}}" mode="aspectFill" binderror="failed" data-index="{{index}}"/><view wx:else class="fields-thumb fields-fallback">查看图片</view></view></view><view wx:if="{{message}}" class="fields-error">{{message}}</view></view></block>
