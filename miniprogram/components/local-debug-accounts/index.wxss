.debug-accounts { padding: 0 12px; margin-top: 10px; }
.actions { display: flex; gap: 10px; }
.actions button { box-sizing: border-box; flex: 1; min-width: 0; margin: 0; padding: 10px 4px; border: 1px solid #dde1e7; border-radius: 24px; background: #fff; color: #172132; font-size: 14px; font-weight: 600; line-height: 22px; }
.actions button::after { border: 0; }
.message { margin-top: 8px; color: #9d3c24; font-size: 13px; }
