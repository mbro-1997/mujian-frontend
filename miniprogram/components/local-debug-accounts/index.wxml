<view wx:if="{{visible}}" class="debug-accounts">
  <view class="actions">
    <button disabled="{{busy}}" data-role="demander" bindtap="choose" aria-label="选择租赁方测试账号">租赁方测试账号<view class="arrow" aria-hidden="true"/></button>
    <button disabled="{{busy}}" data-role="supplier" bindtap="choose" aria-label="选择工厂测试账号">工厂测试账号<view class="arrow" aria-hidden="true"/></button>
  </view>
  <view wx:if="{{message}}" class="message">{{message}}</view>
</view>
