.overlay,.backdrop{position:fixed;inset:0}.overlay{z-index:1000;display:flex;align-items:flex-end}.backdrop{background:rgba(20,26,22,.42)}
.panel{position:relative;box-sizing:border-box;width:100%;border-radius:18px 18px 0 0;padding-bottom:env(safe-area-inset-bottom);background:#fff;color:#222721}
.head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;font-size:18px;font-weight:700;border-bottom:1px solid #e5e8e1}
.close{flex:0 0 42px;text-align:center;box-sizing:border-box;width:42px;height:42px;line-height:42px;margin:0;padding:0;border:0;background:transparent;font-size:24px}
.contents{max-height:65vh;overscroll-behavior:contain}.body{padding:12px 16px 18px}
