:host { position:absolute; top:0; left:0; z-index:1; }
button.hit { display:flex; align-items:flex-start; justify-content:flex-start; box-sizing:border-box; margin:0; padding:4px; width:40px; min-width:40px; height:40px; min-height:40px; background:transparent; border:0; }
button.hit::after { border:0; }
.cross { position:relative; width:22px; height:22px; border-radius:50%; background:rgba(60,64,66,.86); }
.cross::before,.cross::after { content:""; position:absolute; top:10px; left:5px; width:12px; height:2px; border-radius:1px; background:white; transform:rotate(45deg); }
.cross::after { transform:rotate(-45deg); }
