:host { display:block; }
button { width:100%; min-height:44px; margin:8px 0 0; padding:8px 12px; border-radius:10px; background:#f3f5f1; color:#25362a; font-size:15px; font-weight:600; line-height:28px; }
button::after { border:none; }
.print { background:var(--mj-accent,#ffe339); color:#202620; }
.label-image { display:block; width:100%; margin-top:10px; }
.notice { margin-top:8px; color:#675c42; font-size:13px; }
.canvas { position:fixed; top:0; left:-200vw; width:1px; height:1px; pointer-events:none; }
