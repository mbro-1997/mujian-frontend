.prop-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 10px;
}
.prop-card {
  background: #fff;
  border: 1px solid #eee;
  border-radius: 8px;
  overflow: hidden;
  min-height: 206px;
}
.prop-img {
  height: 96px;
  background: linear-gradient(135deg, #aeb8bf, #6f7f88 62%, #303842);
}
.tone-1 {
  background: linear-gradient(135deg, #a86f4d, #e9c46a);
}
.tone-2 {
  background: linear-gradient(135deg, #4b5563, #c7b299);
}
.tone-3 {
  background: linear-gradient(135deg, #0f766e, #d9c8b2);
}
.prop-body {
  padding: 9px 10px 10px;
}
.prop-name {
  font-size: 14px;
  line-height: 1.25;
  font-weight: 900;
  overflow-wrap: anywhere;
}
.style-tags {
  margin-top: 4px;
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}
.style-tag {
  height: 20px;
  padding: 0 6px;
  display: inline-flex;
  align-items: center;
  border-radius: 10px;
  background: #fff7cc;
  font-size: 10px;
  font-weight: 900;
  white-space: nowrap;
}
.prop-meta {
  margin-top: 4px;
  color: #6b7280;
  font-size: 11px;
  font-weight: 800;
}
.prop-foot {
  margin-top: 7px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  flex-wrap: wrap;
}
.price {
  color: #ef4444;
  font-size: 14px;
  font-weight: 900;
}
.join {
  height: 25px;
  padding: 0 8px;
  border-radius: 13px;
  background: #f5f5f5;
  color: #111827;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 900;
}
.feed-state {
  text-align: center;
  background: #fff;
  border-radius: 8px;
  padding: 34px 16px;
  color: #9ca3af;
  font-size: 12px;
  line-height: 1.7;
  margin-top: 10px;
}
.feed-title {
  font-size: 16px;
  color: #6b7280;
  font-weight: 800;
  margin-bottom: 6px;
}
.feed-icon {
  width: 40px;
  height: 40px;
  border-radius: 9px;
  border: 2px solid #d1d5db;
  margin: 0 auto 18px;
}
.example {
  padding: 8px;
  background: #fff7cc;
  color: #6b5900;
  font-size: 12px;
  margin-top: 10px;
}
.prop-img{width:100%;display:block;background:#eee}.fallback{display:flex;align-items:center;justify-content:center;color:#777;font-size:12px}

.prop-foot button.unavailable{margin:0;padding:3px 7px;font-size:12px;line-height:1.5;background:#f3f4f6;color:#6b7280}
.prop-card { display:flex; flex-direction:column; min-height:0; border-color:var(--mj-line,#dfe4dc); border-radius:14px; }
.prop-body { display:flex; flex:1; flex-direction:column; }
.prop-img { position:relative; height:auto; aspect-ratio:1.68; overflow:hidden; }
.prop-img .prop-cover { position:absolute; inset:0; width:100%; height:100%; }
.prop-name { font-weight:700; line-height:1.45; }
.prop-meta,.style-tag { font-weight:550; }
.style-tag { max-width:100%; overflow:hidden; text-overflow:ellipsis; display:block; line-height:20px; }
.prop-foot { margin-top:auto; padding-top:8px; }
.prop-foot .join { width:auto; margin:0; min-width:0; height:auto; min-height:36px; padding:4px 8px; border-radius:8px; font-size:12px; line-height:1.3; }
