<view wx:if="{{example}}" class="example">示例 · 组件预览，不提供真实交易</view><view wx:if="{{state==='ready'}}" class="prop-grid"><view class="prop-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view wx:if="{{item.cover}}" class="prop-img"><public-prop-image class="prop-cover" image="{{item.cover}}" sku-id="{{item.id}}" start-date="{{item.availability.startDate}}" end-date="{{item.availability.endDate}}" bindinaccessible="inaccessible"/></view><view wx:else class="prop-img fallback">图片暂不可预览</view><view class="prop-body"><view class="prop-name">{{item.name}}</view><view class="style-tags"><text class="style-tag" wx:for="{{item.styles}}" wx:for-item="style" wx:key="*this">{{style}}</text></view><view class="prop-meta">类别：{{item.category}}</view><view class="prop-meta" wx:if="{{item.availability}}">{{item.availability.maxRentableQuantity>0?'该租期可租 '+item.availability.maxRentableQuantity+' 件':'该租期不可租'}}</view><view class="prop-meta" wx:if="{{item.joinedQuantity!==null && item.joinedQuantity!==undefined}}">当前清单已加入 {{item.joinedQuantity}} 件</view><view class="prop-foot"><text class="price">¥{{item.price}}/天</text><button wx:if="{{item.availability && item.availability.maxRentableQuantity<=0}}" class="join unavailable" disabled catchtap="ignoreJoin">不可加入</button><button wx:else class="join" data-id="{{item.id}}" catchtap="join">{{item.availability?'加入清单':'加入方案'}}</button></view></view></view></view><view wx:elif="{{state!=='error'}}" class="feed-state"><view class="feed-title"><mj-loading wx:if="{{state==='loading'}}" label="正在加载道具"/><text wx:else>暂无符合条件的道具</text></view><view wx:if="{{state!=='loading'}}">试试调整筛选条件</view></view>
