<view wx:if="{{visible}}" class="overlay"><view class="mask" bindtap="close"></view><view class="sheet" catchtap="stop"><view class="close" bindtap="close">×</view><view class="title">{{conflict ? '微信与手机号账号不一致' : '登录后体验完整功能'}}</view><view wx:if="{{conflict}}" class="description">请使用原账号重新登录，或更换微信账号。小程序不支持合并账号。</view><button class="login {{busy || !agreed || rules.length !== 5 ? 'disabled' : ''}}" open-type="getPhoneNumber" bindgetphonenumber="phone" disabled="{{busy || !agreed || rules.length !== 5}}" loading="{{busy}}">微信快捷登录</button><checkbox-group bindchange="agreement"><label class="consent"><checkbox value="agree" checked="{{agreed}}" color="#e5bf00"/><text>我已阅读并同意全部平台规则</text></label></checkbox-group><view class="link" bindtap="rules">《用户服务协议及平台规则》 ›</view><view class="description">统一包含用户服务、隐私、租赁交易、押金赔付和物流运输规则。</view><view class="error" wx:if="{{message}}">{{message}}</view><button wx:if="{{rules.length !== 5}}" bindtap="loadRules">重新加载规则</button></view></view>
