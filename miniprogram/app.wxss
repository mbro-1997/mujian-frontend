@import "styles/tokens.wxss";
page {
  background: var(--mj-canvas);
  color: var(--mj-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 14px;
}
view,
text,
button,
input {
  box-sizing: border-box;
}
button {
  font-size: 14px;
  line-height: 1.4;
  margin: 0;
  padding: 12px 18px;
  border-radius: var(--mj-control);
}
button::after {
  border: 0;
}
.primary {
  background: var(--mj-accent);
  color: var(--mj-ink);
  font-weight: 650;
}
.secondary {
  background: white;
  color: #111827;
  border: 1px solid #e5e7eb;
}
.muted {
  color: #6b7280;
}
.page-pad {
  padding: 16px 18px calc(24px + env(safe-area-inset-bottom));
}
.with-tabs {
  padding-bottom: calc(90px + env(safe-area-inset-bottom));
}
.feedback {
  padding: 12px;
  margin: 12px;
  background: #fff7cc;
  color: #645300;
  line-height: 1.6;
  border-radius: 8px;
  overflow-wrap: anywhere;
}
.empty {
  padding: 46px 24px;
  text-align: center;
  line-height: 1.7;
  color: #6b7280;
}
.empty-title {
  font-size: 18px;
  color: #111827;
  font-weight: 800;
  margin-bottom: 8px;
}
.empty-art {
  width: 68px;
  height: 68px;
  border: 9px solid #ffe100;
  border-radius: 50%;
  margin: 0 auto 24px;
  background: white;
}
.empty button {
  margin: 24px auto 0;
  max-width: 220px;
}
.mine-hero {
  min-height: 174px;
  padding: 40px 18px 24px;
  background: linear-gradient(135deg, #fff7cc, #fff 72%);
  display: grid;
  grid-template-columns: 66px 1fr;
  gap: 14px;
  align-items: center;
}
.mine-avatar {
  width: 66px;
  height: 66px;
  border-radius: 50%;
  background: linear-gradient(135deg, #e5e7eb, #f8fafc);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: 900;
  border: 2px solid white;
  box-shadow: 0 8px 20px rgba(17, 24, 39, 0.08);
}
.mine-avatar.factory {
  border-radius: 18px;
  background: linear-gradient(135deg, #0f766e, #0e7490);
  color: white;
}
.mine-name {
  font-size: 22px;
  font-weight: 900;
  overflow-wrap: anywhere;
  margin-bottom: 7px;
}
.mine-description {
  color: #6b7280;
  font-size: 13px;
  line-height: 1.6;
}
.mine-section {
  margin: 10px 12px 0;
  background: white;
  border-radius: 8px;
  overflow: hidden;
}
.section-title {
  min-height: 42px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 14px;
  border-bottom: 1px solid #f0f0f0;
  font-size: 16px;
  font-weight: 900;
}
.section-title .muted {
  font-size: 12px;
  font-weight: 500;
}
.mine-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px 4px;
  padding: 14px 6px 16px;
}
.mine-tool {
  text-align: center;
  font-size: 12px;
  font-weight: 800;
  line-height: 1.5;
}
.tool-icon {
  width: 34px;
  height: 34px;
  margin: 0 auto 7px;
  border-radius: 50%;
  background: #fff7cc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}
.mine-row {
  min-height: 48px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 14px;
  border-top: 1px solid #f0f0f0;
  font-size: 15px;
  font-weight: 800;
}
.mine-row:first-child {
  border-top: 0;
}
.chevron {
  font-size: 24px;
  color: #9ca3af;
}
.section-note {
  padding: 0 14px 12px;
  font-size: 12px;
  color: #9ca3af;
}
.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 18px 12px;
}
.action-row button {
  flex: 1;
  min-width: 120px;
}
.status-card {
  background: white;
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 22px;
  margin-bottom: 14px;
}
.status-title {
  font-size: 25px;
  font-weight: 900;
  line-height: 1.4;
  margin: 12px 0;
}
.status-description {
  font-size: 14px;
  line-height: 1.7;
  color: #6b7280;
}
.status-mark {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff2a8;
  font-size: 25px;
  font-weight: 900;
}
.status-mark.rejected {
  background: #fee2e2;
  color: #a31621;
}

.mj-read-state { padding:24px var(--mj-edge); text-align:center; }

.mj-system-picker { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:var(--mj-tap); min-width:0; }
.mj-selected-label,.mj-system-picker text { display:block; min-width:0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.mj-system-picker::after { content:""; flex:none; width:6px; height:6px; margin-right:3px; border:solid var(--mj-muted); border-width:0 1.5px 1.5px 0; transform:rotate(45deg); }
.review-filter dict-select,.filter-row dict-select,.custom .bar > dict-select { flex:1; min-width:0; }

.prop-page button.mj-filter-reset { display:block; width:auto; min-height:var(--mj-tap); margin:0 0 0 auto; padding:6px 8px; color:var(--mj-active-ink); background:transparent; font-size:13px; }

.mj-line-field, .mj-readonly-field { display:flex; align-items:center; min-width:0; height:44px; padding:0 12px; border:1px solid var(--mj-line); border-radius:var(--mj-control); background:var(--mj-paper); }
.mj-line-field input.mj-line-control { flex:1; width:100%; min-width:0; min-height:0; height:1.5em; line-height:1.5; margin:0; padding:0; border:0; background:transparent; font-size:14px; }
.mj-readonly-field { background:var(--mj-soft); }
.mj-list-end { width:100%; text-align:center; color:var(--mj-muted); }
.mj-dropdown-anchor { position:relative; min-width:0; }
.mj-dropdown-open { z-index:12; }
.mj-dropdown-dismiss { position:fixed; inset:0; z-index:10; }
.mj-dropdown-panel { position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:12; max-height:42vh; overflow-y:auto; background:var(--mj-paper); border:1px solid var(--mj-line); border-radius:var(--mj-control); box-shadow:0 6px 18px rgba(24,40,28,.12); }

.mj-photo-frame { position:relative; min-width:0; }
.mj-photo-frame > image { display:block; }
.mj-photo-drafts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
.mj-photo-drafts image { width:100%; height:84px; border-radius:8px; }

.mj-attachment-name { display:block; padding:12px 12px 12px 44px; overflow-wrap:anywhere; }
