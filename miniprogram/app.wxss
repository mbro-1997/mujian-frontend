@import "styles/renter-tokens.wxss";
page {
  background: #f6f6f6;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 14px;
}
view,
text,
button,
input {
  box-sizing: border-box;
}
button {
  font-size: 14px;
  line-height: 1.4;
  margin: 0;
  padding: 12px 18px;
  border-radius: 23px;
}
button::after {
  border: 0;
}
.primary {
  background: #ffe100;
  color: #111;
  font-weight: 900;
}
.secondary {
  background: white;
  color: #111827;
  border: 1px solid #e5e7eb;
}
.muted {
  color: #6b7280;
}
.page-pad {
  padding: 16px 18px calc(24px + env(safe-area-inset-bottom));
}
.with-tabs {
  padding-bottom: calc(90px + env(safe-area-inset-bottom));
}
.feedback {
  padding: 12px;
  margin: 12px;
  background: #fff7cc;
  color: #645300;
  line-height: 1.6;
  border-radius: 8px;
  overflow-wrap: anywhere;
}
.empty {
  padding: 46px 24px;
  text-align: center;
  line-height: 1.7;
  color: #6b7280;
}
.empty-title {
  font-size: 18px;
  color: #111827;
  font-weight: 800;
  margin-bottom: 8px;
}
.empty-art {
  width: 68px;
  height: 68px;
  border: 9px solid #ffe100;
  border-radius: 50%;
  margin: 0 auto 24px;
  background: white;
}
.empty button {
  margin: 24px auto 0;
  max-width: 220px;
}
.mine-hero {
  min-height: 174px;
  padding: 40px 18px 24px;
  background: linear-gradient(135deg, #fff7cc, #fff 72%);
  display: grid;
  grid-template-columns: 66px 1fr;
  gap: 14px;
  align-items: center;
}
.mine-avatar {
  width: 66px;
  height: 66px;
  border-radius: 50%;
  background: linear-gradient(135deg, #e5e7eb, #f8fafc);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: 900;
  border: 2px solid white;
  box-shadow: 0 8px 20px rgba(17, 24, 39, 0.08);
}
.mine-avatar.factory {
  border-radius: 18px;
  background: linear-gradient(135deg, #0f766e, #0e7490);
  color: white;
}
.mine-name {
  font-size: 22px;
  font-weight: 900;
  overflow-wrap: anywhere;
  margin-bottom: 7px;
}
.mine-description {
  color: #6b7280;
  font-size: 13px;
  line-height: 1.6;
}
.mine-section {
  margin: 10px 12px 0;
  background: white;
  border-radius: 8px;
  overflow: hidden;
}
.section-title {
  min-height: 42px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 14px;
  border-bottom: 1px solid #f0f0f0;
  font-size: 16px;
  font-weight: 900;
}
.section-title .muted {
  font-size: 12px;
  font-weight: 500;
}
.mine-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px 4px;
  padding: 14px 6px 16px;
}
.mine-tool {
  text-align: center;
  font-size: 12px;
  font-weight: 800;
  line-height: 1.5;
}
.tool-icon {
  width: 34px;
  height: 34px;
  margin: 0 auto 7px;
  border-radius: 50%;
  background: #fff7cc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}
.mine-row {
  min-height: 48px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 14px;
  border-top: 1px solid #f0f0f0;
  font-size: 15px;
  font-weight: 800;
}
.mine-row:first-child {
  border-top: 0;
}
.chevron {
  font-size: 24px;
  color: #9ca3af;
}
.section-note {
  padding: 0 14px 12px;
  font-size: 12px;
  color: #9ca3af;
}
.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 18px 12px;
}
.action-row button {
  flex: 1;
  min-width: 120px;
}
.status-card {
  background: white;
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 22px;
  margin-bottom: 14px;
}
.status-title {
  font-size: 25px;
  font-weight: 900;
  line-height: 1.4;
  margin: 12px 0;
}
.status-description {
  font-size: 14px;
  line-height: 1.7;
  color: #6b7280;
}
.status-mark {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff2a8;
  font-size: 25px;
  font-weight: 900;
}
.status-mark.rejected {
  background: #fee2e2;
  color: #a31621;
}
