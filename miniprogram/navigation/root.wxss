@import "../styles/warehouse-entries.wxss";
.factory-root {
  min-height:100vh; padding:16px var(--mj-edge) calc(88px + env(safe-area-inset-bottom));
  background:var(--mj-canvas); color:var(--mj-ink); overflow-wrap:anywhere;
}
.factory-identity { display:flex; align-items:center; gap:12px; margin-bottom:16px; }
.factory-identity > view:last-child,.publish-copy { min-width:0; }
.factory-avatar,.asset-letter { flex:none; display:flex; align-items:center; justify-content:center; width:44px; height:44px; border-radius:11px; background:var(--mj-active-bg); color:var(--mj-active-ink); font-weight:700; font-size:22px; }
.factory-name { font-size:21px; font-weight:700; line-height:1.4; }
.factory-root .heading,.factory-task-title { font-size:16px; font-weight:700; line-height:1.45; }
.factory-root .muted,.factory-root .arrow { color:var(--mj-muted); }
.factory-root .muted { font-size:13px; line-height:1.5; }
.factory-root .panel,.factory-root .factory-publish,.factory-root .secondary-btn {
  background:var(--mj-paper); border:1px solid var(--mj-line); border-radius:var(--mj-card);
}
.factory-root .panel { padding:14px; margin:0 0 12px; }
.factory-order-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:4px; margin-top:8px; }
.factory-order-grid > view { display:flex; flex-direction:column; justify-content:center; align-items:center; min-height:70px; border-radius:9px; font-size:25px; font-weight:700; font-variant-numeric:tabular-nums; background:var(--mj-soft); }
.factory-order-grid > view:first-child { background:var(--mj-active-bg); color:var(--mj-active-ink); }
.factory-order-grid text { font-size:12px; font-weight:500; margin-top:3px; }
.factory-root button.factory-text-action { width:auto; min-width:0; min-height:44px; padding:0; margin:0; background:transparent; color:var(--mj-active-ink); font-size:13px; font-weight:600; }
.factory-root button.factory-refunds { width:100%; text-align:right; margin-top:8px; border-radius:0; border-top:1px solid var(--mj-line); }
.factory-home-state,.factory-root .empty { padding:24px 8px; text-align:center; color:var(--mj-muted); }
.factory-task { padding:12px 0; border-top:1px solid var(--mj-line); }
.factory-task-top,.factory-task-bottom,.factory-root .row,.factory-root .pager { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.factory-task-title { margin:6px 0; }.factory-task-bottom { margin-top:10px; color:#805b00; font-size:12px; }
.factory-root .pill { background:var(--mj-soft); color:var(--mj-muted); padding:3px 7px; font-size:12px; border-radius:6px; flex:none; }
.factory-task-bottom .factory-task-action { background:var(--mj-accent); color:var(--mj-ink); border-radius:var(--mj-control); font-size:14px; font-weight:650; min-height:44px; }
.factory-task-bottom .factory-task-action { width:auto; padding:8px 14px; margin:0; }
.factory-root .factory-publish { display:grid; align-items:center; grid-template-columns:44px minmax(0,1fr) auto; gap:12px; width:100%; max-width:100%; padding:16px; margin:12px 0; text-align:left; white-space:normal; }
.factory-root .factory-publish .heading { margin:0 0 3px; }
.asset-letter.quantity { background:#fff4af; color:#594b13; }
.factory-publish[disabled] { opacity:.55; }
.factory-root .arrow { font-size:19px; font-weight:400; }
.menu-title { margin:16px 0 6px; font-size:14px; font-weight:650; }
.factory-root .factory-menu.mine-grid { padding:14px 6px; }
.factory-root .secondary-btn { width:100%; min-height:44px; margin:0; }
.factory-root .prop-page { padding:0; }
.factory-root .row { margin:7px 0; }.factory-root .row .heading { min-width:0; }
.factory-root .warehouse-pager { display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); font-size:12px; }
.factory-root .warehouse-page-button { width:100%; min-width:0; min-height:44px; margin:0; padding:8px 4px; }
.factory-root .feedback { margin:10px 0; }.factory-root .error { background:#fff0ed; color:#9d231c; }
