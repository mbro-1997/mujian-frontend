<import src="warehouse.wxml"/>
<template name="factory-root">
<view class="factory-root" bindtouchstart="activity">
<view wx:if="{{rootLoading&&!factoryProfile}}" class="empty"><mj-loading label="正在加载工厂状态"/></view>
<view wx:if="{{factoryProfile}}" class="factory-identity"><view class="factory-avatar">厂</view><view><view class="factory-name">{{factoryProfile.materials.factoryName}}</view><view class="muted">{{factoryProfile.factoryStatus==='active'?'已入驻':factoryProfile.factoryStatus==='suspended'?'经营暂停':'工厂已停用'}}</view></view></view>
<view wx:if="{{factoryContext.accessMode==='restricted'||(factoryProfile&&factoryProfile.factoryStatus!=='active')}}" class="feedback">当前账号或工厂使用受限。已有资料与记录按权限查看，业务操作以页面可用动作为准。</view>
<block wx:if="{{rootIndex===0}}">
  <view class="panel">
    <mj-heading title="租赁订单">
      <button class="factory-text-action" bindtap="factoryOrderList">全部订单{{tradeOverview?' '+tradeOverview.allOrderCount:''}} ›</button></mj-heading>
    <view class="factory-order-grid">
      <view data-view="pending_accept" bindtap="factoryOrderList">{{tradeOverview?tradeOverview.pendingAcceptCount:'—'}}<text>待接单</text></view>
      <view data-view="pending_outbound" bindtap="factoryOrderList">{{tradeOverview?tradeOverview.pendingOutboundCount:'—'}}<text>待出库</text></view>
      <view data-view="return_checking" bindtap="factoryOrderList">{{tradeOverview?tradeOverview.returnCheckingCount:'—'}}<text>待核验</text></view>
      <view data-view="exceptions" bindtap="factoryOrderList">{{tradeOverview?tradeOverview.exceptionOrderCount:'—'}}<text>异常处理</text></view>
    </view>
    <button class="factory-text-action factory-refunds" data-view="refund_exception" bindtap="factoryOrderList">退款异常 {{tradeOverview?tradeOverview.refundExceptionCount:'—'}} ›</button>
  </view>
  <view wx:if="{{tradeMessage}}" class="feedback">{{tradeMessage}}<button bindtap="factoryOrdersRetry">重试读取</button></view>
  <view class="panel">
    <mj-heading title="待处理租赁订单">
      <button class="factory-text-action" data-view="factory_pending" bindtap="factoryOrderList">查看全部 ›</button></mj-heading>
    <view wx:for="{{tradeOrders}}" wx:key="id" class="factory-task" data-id="{{item.id}}" bindtap="factoryOrder">
      <view class="factory-task-top"><text class="pill">{{item.label}}</text><text class="muted">租赁订单</text></view>
      <view class="factory-task-title">{{item.orderNo}}</view>
      <view class="muted">{{item.startDate}} 至 {{item.endDate}} · ¥{{item.paid}}</view>
      <view class="factory-task-bottom"><text>{{item.nextDeadlineText}}</text>
        <button class="factory-task-action" data-id="{{item.id}}" catchtap="factoryOrder">查看订单</button></view>
    </view>
    <view wx:if="{{!tradeOrders.length && !tradeMessage}}" class="factory-home-state">
      <view><mj-loading wx:if="{{tradeBusy && !tradePage}}" label="正在读取待处理订单"/><text wx:else>暂无待处理订单</text></view>

    </view>
    <button wx:if="{{!tradeExhausted && tradeOrders.length<tradeTotal}}" bindtap="factoryOrdersMore" disabled="{{tradeBusy}}">加载更多待处理订单</button>
  </view>
</block>
<block wx:elif="{{rootIndex===1}}">
  <mj-heading title="发布道具" subtitle="选择管理方式，填写资料后提交审核。"/>
  <button wx:for="{{['A','B']}}" wx:key="*this" class="factory-publish" data-type="{{item==='A'?'A_ASSET':'B_CONSUMABLE'}}"
    bindtap="factoryCreate" hover-stay-time="{{0}}" disabled="{{!factoryProfile||factoryProfile.factoryStatus!=='active'||factoryContext.accessMode==='restricted'}}">
    <text class="asset-letter {{item==='B'?'quantity':''}}">{{item}}</text>
    <view class="publish-copy"><view class="heading">{{item}} 类道具</view><text class="muted">{{item==='A'?'逐件追踪实物，每件都有独立标签。':'按同款规格记录库存数量。'}}</text></view>
    <text class="arrow">›</text>
  </button>
</block>
<template wx:elif="{{rootIndex===2}}" is="warehouse" data="{{items,message,busy,tab,keyword,submittedKeyword,page,total,assetType,hasPendingLabel,selection,warehouseFilters,warehouseLoaded}}"/>
<block wx:elif="{{rootIndex===3}}">
  <block wx:for="{{factoryMenus}}" wx:key="title" wx:for-item="group">
    <view class="menu-title">{{group.title}}</view>
    <view class="panel factory-menu mine-grid">
      <view wx:for="{{group.items}}" wx:key="key" class="mine-tool" aria-role="button" data-key="{{item.key}}" bindtap="factoryOpen">
        <view class="tool-icon tool-{{item.icon}}" aria-hidden="true"></view><text>{{item.label}}</text>
      </view>
    </view>
  </block>
  <button class="secondary-btn" bindtap="factoryLogout">退出登录</button>
</block>
</view></template>
