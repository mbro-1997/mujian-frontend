/* Formal 01 #screen-limited-tab: shared by renter plan/checklist only. */
.renter-empty{min-height:calc(100vh - 78px - env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:center;padding:24px 24px 64px;background:#fff;text-align:center;box-sizing:border-box}.renter-empty-content{width:100%}.renter-empty-art{width:112px;height:112px;margin:0 auto 20px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fff3a8 0 18px,transparent 19px),radial-gradient(circle at 70% 70%,#f59e0b 0 7px,transparent 8px),linear-gradient(135deg,#ffe668,#ffbd23);position:relative}.renter-empty-art::before{content:"No~";position:absolute;right:-8px;top:8px;padding:4px 9px;border-radius:14px;background:#222;color:#fff;font-size:14px;font-weight:900;transform:rotate(8deg)}.renter-empty-title{margin:0 0 10px;font-size:22px;font-weight:900;line-height:1.4;color:#111827}.renter-empty-description{margin:0 0 20px;color:#a3a3a3;font-size:16px;font-weight:500;line-height:1.5}.renter-empty button.renter-empty-login{display:inline-flex;align-items:center;justify-content:center;width:auto;min-width:104px;max-width:100%;height:44px;margin:0;padding:0 28px;border-radius:24px;background:#ffe100;color:#111;font-size:18px;font-weight:800;line-height:44px}
