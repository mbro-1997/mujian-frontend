page {
  background: #070b16;
}

.orders-page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at 100% 16%, rgba(56, 189, 248, 0.08), transparent 28%),
    #070b16;
  color: #f8fafc;
}

.top-panel {
  padding-bottom: 18rpx;
}

.page-tip {
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(34, 211, 238, 0.1);
  border: 1rpx solid rgba(34, 211, 238, 0.22);
  color: #67e8f9;
  font-size: 23rpx;
  line-height: 1.45;
}

.search-box {
  margin-top: 18rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  box-sizing: border-box;
}

.search-icon {
  color: #22d3ee;
  font-size: 30rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  color: #f8fafc;
  font-size: 25rpx;
}

.search-placeholder {
  color: #64748b;
}

.clear-search {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 34rpx;
}

.status-tabs {
  margin-top: 18rpx;
  white-space: nowrap;
}

.status-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.72);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  color: #94a3b8;
  font-size: 24rpx;
}

.status-tab.active {
  background: rgba(34, 211, 238, 0.12);
  border-color: rgba(34, 211, 238, 0.4);
  color: #22d3ee;
  font-weight: 700;
}

.filter-bar {
  display: grid;
  grid-template-columns: 1fr 1fr 120rpx;
  gap: 14rpx;
  margin: 10rpx 0 18rpx;
}

.filter-chip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  color: #e2e8f0;
  font-size: 23rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-chip.ghost {
  color: #22d3ee;
}

.list-meta {
  margin-bottom: 14rpx;
  color: #64748b;
  font-size: 22rpx;
}

.order-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  box-shadow: 0 14rpx 38rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
  backdrop-filter: blur(14px);
}

.order-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.order-no {
  color: #f8fafc;
  font-size: 29rpx;
  font-weight: 600;
}

.order-status {
  flex: 0 0 auto;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.status-pending-confirm {
  background: rgba(251, 191, 36, 0.14);
  color: #fbbf24;
}

.status-renting {
  background: rgba(34, 211, 238, 0.14);
  color: #22d3ee;
}

.status-return {
  background: rgba(129, 140, 248, 0.14);
  color: #818cf8;
}

.status-completed {
  background: rgba(52, 211, 153, 0.14);
  color: #34d399;
}

.status-rejected {
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
}

.status-default {
  background: rgba(148, 163, 184, 0.12);
  color: #94a3b8;
}

.order-card-body {
  margin-top: 18rpx;
}

.info-row,
.info-pair,
.money-row,
.order-card-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.info-row {
  margin-top: 8rpx;
}

.info-pair {
  margin-top: 14rpx;
}

.info-pair > view,
.money-row > view,
.order-card-progress > view {
  flex: 1;
  min-width: 0;
}

.info-label,
.money-label {
  margin-right: 10rpx;
  color: #64748b;
  font-size: 23rpx;
}

.info-value {
  color: #e2e8f0;
  font-size: 24rpx;
}

.money-row {
  margin-top: 16rpx;
  padding: 16rpx 0 0;
  border-top: 1rpx solid rgba(148, 163, 184, 0.12);
}

.money-value {
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 700;
}

.order-card-progress {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.42);
}

.progress-item {
  color: #94a3b8;
  font-size: 23rpx;
}

.progress-item text {
  color: #22d3ee;
  font-weight: 700;
}

.review-progress {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(34, 211, 238, 0.1);
  color: #67e8f9;
  font-size: 23rpx;
}

.order-card-actions {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  min-width: 42%;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.action-btn::after,
.mini-scan-btn::after {
  border: none;
}

.action-btn.primary,
.mini-scan-btn.primary {
  background: #22d3ee;
  color: #03111a;
}

.action-btn.secondary {
  background: rgba(30, 41, 59, 0.92);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  color: #e2e8f0;
}

.action-btn.secondary.danger {
  background: rgba(251, 113, 133, 0.14);
  border-color: rgba(251, 113, 133, 0.22);
  color: #fb7185;
}

.action-btn.ghost {
  background: transparent;
  border: 1rpx solid rgba(34, 211, 238, 0.28);
  color: #22d3ee;
}

.empty-state {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  background: rgba(15, 23, 42, 0.72);
}

.empty-title {
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-subtitle,
.load-state {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 23rpx;
  text-align: center;
}

.load-state {
  padding: 24rpx 0;
}

.load-state.error {
  color: #fb7185;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(3, 7, 18, 0.72);
  box-sizing: border-box;
}

.modal-content {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.98);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  box-sizing: border-box;
}

.modal-title {
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.form-item {
  margin-top: 22rpx;
}

.form-label {
  margin-bottom: 12rpx;
  color: #e2e8f0;
  font-size: 24rpx;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.72);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  color: #f8fafc;
  font-size: 26rpx;
  padding: 18rpx 20rpx;
}

.reject-textarea {
  min-height: 180rpx;
  line-height: 1.5;
}

.planet-rate {
  display: flex;
  gap: 12rpx;
  padding: 6rpx 0;
}

.planet {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  font-size: 40rpx;
  filter: grayscale(1);
  opacity: 0.38;
  transform: scale(0.92);
  transition: all 0.18s ease;
}

.planet.active {
  filter: none;
  opacity: 1;
  transform: scale(1.08);
  text-shadow: 0 0 16rpx rgba(251, 191, 36, 0.52);
}

.modal-buttons {
  margin-top: 24rpx;
  display: flex;
  gap: 14rpx;
}

.modal-button {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.modal-button.primary {
  background: #22d3ee;
  color: #03111a;
}

.modal-button.primary.danger {
  background: rgba(251, 113, 133, 0.14);
  border: 1rpx solid rgba(251, 113, 133, 0.22);
  color: #fb7185;
}

.modal-button.secondary {
  background: rgba(30, 41, 59, 0.92);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  color: #e2e8f0;
}

.scan-order-id {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.scan-list {
  margin-top: 16rpx;
  max-height: 420rpx;
  overflow-y: auto;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 18rpx;
  padding: 0 14rpx;
  background: rgba(30, 41, 59, 0.42);
}

.scan-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.14);
}

.scan-item:last-child {
  border-bottom: none;
}

.scan-main {
  flex: 1;
  min-width: 0;
}

.scan-name {
  color: #f8fafc;
  font-size: 25rpx;
  font-weight: 600;
}

.scan-meta {
  margin-top: 4rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.mini-scan-btn {
  min-width: 96rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.mini-scan-btn.disabled {
  background: rgba(30, 41, 59, 0.7);
  color: #64748b;
}
