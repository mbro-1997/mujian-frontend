page {
  background: #070b16;
}

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at 100% 16%, rgba(56, 189, 248, 0.08), transparent 28%),
    #070b16;
}

.summary,
.card {
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  color: #f8fafc;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
  backdrop-filter: blur(14px);
}

.summary {
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.title {
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.line {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.45;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.action-btn {
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0;
}

.action-btn::after {
  border: none;
}

.action-btn.supplier,
.action-btn.admin {
  background: #22d3ee;
  color: #03111a;
}

.action-btn.ghost {
  background: rgba(30, 41, 59, 0.92);
  color: #e2e8f0;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
}

.empty-list {
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.72);
}
