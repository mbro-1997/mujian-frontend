page {
  background: #070b16;
}

.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at 100% 16%, rgba(56, 189, 248, 0.08), transparent 28%),
    #070b16;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.create-btn {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  background: #22d3ee;
  color: #03111a;
  font-size: 28rpx;
  font-weight: 800;
}

.create-btn::after,
.revoke-btn::after {
  border: none;
}

.card {
  margin-top: 20rpx;
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  padding: 24rpx;
  color: #f8fafc;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
  backdrop-filter: blur(14px);
}

.row.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.suffix {
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 700;
}

.status {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status.unused {
  background: rgba(34, 211, 238, 0.12);
  color: #22d3ee;
}

.status.locked {
  background: rgba(251, 191, 36, 0.14);
  color: #fbbf24;
}

.status.used {
  background: rgba(52, 211, 153, 0.12);
  color: #34d399;
}

.status.revoked,
.status.expired {
  background: rgba(251, 113, 133, 0.12);
  color: #fb7185;
}

.line {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.5;
}

.revoke-btn {
  margin-top: 18rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
  border: 1rpx solid rgba(251, 113, 133, 0.22);
  font-size: 25rpx;
  font-weight: 700;
}

.empty-list {
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.72);
  margin-top: 20rpx;
}
