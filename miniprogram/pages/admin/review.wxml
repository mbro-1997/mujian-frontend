<view class="page">
  <view class="hint-card">评价管理按订单聚合展示，点进订单后可查看租赁方和工厂方双方评价。</view>

  <view class="card" wx:for="{{list}}" wx:key="orderId" data-id="{{item.orderId}}" bindtap="openDetail">
    <view class="card-head">
      <view class="title">{{item.orderNo}}</view>
      <view class="status">{{item.reviewCount}} 条评价</view>
    </view>
    <view class="line">订单ID：{{item.orderId}}</view>
    <view class="review-row">
      <view class="review-chip {{item.demanderReview ? 'done' : ''}}">租赁方：{{item.demanderReview ? '已评价' : '未评价'}}</view>
      <view class="review-chip {{item.supplierReview ? 'done' : ''}}">工厂方：{{item.supplierReview ? '已评价' : '未评价'}}</view>
    </view>
    <view class="line">最近评价：{{item.latestAt || '-'}}</view>
    <view class="arrow">查看双方评价 ›</view>
  </view>

  <view class="empty-list" wx:if="{{!list.length}}">暂无评价数据</view>
</view>
