page {
  background: #070b16;
}

.admin-page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at 100% 16%, rgba(56, 189, 248, 0.08), transparent 28%),
    #070b16;
  color: #f8fafc;
  box-sizing: border-box;
}

.header-card,
.metric,
.menu-card {
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
  backdrop-filter: blur(14px);
}

.header-card {
  padding: 24rpx;
  border-color: rgba(125, 211, 252, 0.22);
}

.title {
  color: #f8fafc;
  font-size: 36rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.5;
}

.grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.metric {
  padding: 22rpx;
}

.num {
  color: #22d3ee;
  font-size: 44rpx;
  font-weight: 700;
}

.label {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.quick-row {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.btn {
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.btn::after {
  border: none;
}

.primary {
  background: #22d3ee;
  color: #03111a;
}

.secondary {
  margin-top: 20rpx;
  background: rgba(30, 41, 59, 0.92);
  color: #e2e8f0;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
}

.menu-card {
  margin-top: 20rpx;
  overflow: hidden;
}

.menu-item {
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.14);
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #e2e8f0;
  font-size: 26rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #22d3ee;
}
