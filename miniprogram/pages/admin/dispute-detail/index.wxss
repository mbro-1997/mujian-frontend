@import "../dispute.wxss";

.page {
  padding-bottom: 180rpx;
}

.hero {
  background: rgba(15, 23, 42, 0.92);
}

.hero-head,
.row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.sub {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.section-title {
  margin-bottom: 12rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.12);
  color: #94a3b8;
  font-size: 24rpx;
}

.row text:last-child {
  color: #e2e8f0;
  text-align: right;
}

.money {
  color: #67e8f9 !important;
  font-weight: 800;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.evidence-img {
  width: 190rpx;
  height: 190rpx;
}

.empty-inline {
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 24rpx;
}

.result-type {
  display: inline-block;
  height: 42rpx;
  line-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.result-type.approved {
  background: rgba(52, 211, 153, 0.14);
  color: #34d399;
}

.result-type.rejected {
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(15, 23, 42, 0.94);
  border-top: 1rpx solid rgba(148, 163, 184, 0.16);
}

.bottom-btn {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 800;
}

.bottom-btn.approve {
  background: #22d3ee;
  color: #03111a;
}

.bottom-btn.reject {
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(2, 6, 23, 0.72);
}

.modal-title {
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 800;
}

.modal-tip {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(251, 191, 36, 0.1);
  color: #fbbf24;
  font-size: 23rpx;
  line-height: 1.55;
}

.amount-field {
  margin-top: 18rpx;
}

.amount-label {
  display: block;
  margin-bottom: 10rpx;
  color: #cbd5e1;
  font-size: 24rpx;
  font-weight: 700;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.72);
  box-sizing: border-box;
}

.amount-input {
  flex: 1;
  height: 76rpx;
  color: #f8fafc;
  font-size: 26rpx;
}

.amount-unit {
  margin-left: 12rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.reason-input {
  margin-top: 18rpx;
  width: 100%;
  min-height: 220rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.72);
  color: #f8fafc;
  font-size: 25rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.modal-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 800;
}

.modal-btn.secondary {
  background: rgba(30, 41, 59, 0.92);
  color: #94a3b8;
}

.modal-btn.primary {
  background: #22d3ee;
  color: #03111a;
}
