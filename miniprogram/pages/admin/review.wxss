page {
  background: #070b16;
}

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at 100% 16%, rgba(56, 189, 248, 0.08), transparent 28%),
    #070b16;
}

.hint-card,
.card,
.empty-list {
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
}

.hint-card {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.6;
}

.card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  color: #f8fafc;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  flex: 1;
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 700;
}

.status {
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(34, 211, 238, 0.12);
  color: #22d3ee;
  font-size: 21rpx;
  font-weight: 700;
}

.line {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.review-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.review-chip {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 16rpx;
  text-align: center;
  color: #64748b;
  background: rgba(30, 41, 59, 0.72);
  font-size: 23rpx;
}

.review-chip.done {
  color: #34d399;
  background: rgba(52, 211, 153, 0.12);
}

.arrow {
  margin-top: 16rpx;
  color: #22d3ee;
  font-size: 24rpx;
  font-weight: 700;
}

.empty-list {
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 25rpx;
}
