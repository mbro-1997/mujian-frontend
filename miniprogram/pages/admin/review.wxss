page {
  background: #070b16;
}

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at 100% 16%, rgba(56, 189, 248, 0.08), transparent 28%),
    #070b16;
}

.card {
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  color: #f8fafc;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
  backdrop-filter: blur(14px);
}

.title {
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.line {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.45;
}

.row {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn::after {
  border: none;
}

.hide {
  background: #22d3ee;
  color: #03111a;
}

.del {
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
  border: 1rpx solid rgba(251, 113, 133, 0.22);
}

.empty-list {
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.72);
}
