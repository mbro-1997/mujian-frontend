page {
  background: #070b16;
}

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at 100% 16%, rgba(56, 189, 248, 0.08), transparent 28%),
    #070b16;
}

.hint-card,
.card,
.empty-list,
.modal-content {
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
}

.hint-card {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.6;
}

.card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  color: #f8fafc;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  flex: 1;
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.line {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.45;
}

.status {
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.status.pending {
  background: rgba(251, 191, 36, 0.14);
  color: #fbbf24;
}

.status.resolved {
  background: rgba(52, 211, 153, 0.12);
  color: #34d399;
}

.status.closed {
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
}

.amount-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.amount-card {
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.56);
}

.amount-label {
  color: #94a3b8;
  font-size: 22rpx;
}

.amount-value {
  margin-top: 8rpx;
  color: #f8fafc;
  font-size: 34rpx;
  font-weight: 700;
}

.content,
.resolution {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.56);
  color: #e2e8f0;
  font-size: 25rpx;
  line-height: 1.6;
}

.evidence-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.evidence-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.72);
}

.resolution {
  border: 1rpx solid rgba(52, 211, 153, 0.18);
  color: #bbf7d0;
}

.btn {
  margin-top: 18rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #22d3ee;
  color: #03111a;
  font-size: 26rpx;
  font-weight: 700;
}

.btn::after {
  border: none;
}

.empty-list {
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 25rpx;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(2, 6, 23, 0.72);
}

.modal-content {
  width: 100%;
  padding: 26rpx;
}

.modal-title {
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 700;
}

.resolve-input {
  margin-top: 18rpx;
  width: 100%;
  min-height: 220rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.72);
  color: #f8fafc;
  font-size: 25rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.modal-btn {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
}

.modal-btn.secondary {
  background: rgba(30, 41, 59, 0.92);
  color: #94a3b8;
}

.modal-btn.primary {
  background: #22d3ee;
  color: #03111a;
}
