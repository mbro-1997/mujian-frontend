.page {
  min-height: 100vh;
  background: #070b16;
  box-sizing: border-box;
}

.content-scroll {
  height: 100vh;
}

.card {
  margin: 20rpx 24rpx;
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  padding: 24rpx;
  color: #f8fafc;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  backdrop-filter: blur(14px);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-title {
  margin-top: 26rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid #22d3ee;
  font-size: 29rpx;
  font-weight: 700;
  color: #f8fafc;
}

.line {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #94a3b8;
  line-height: 1.55;
}

.status {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.status.pending {
  background: rgba(34, 211, 238, 0.12);
  color: #22d3ee;
}

.status.approved {
  background: rgba(52, 211, 153, 0.12);
  color: #34d399;
}

.status.rejected {
  background: rgba(251, 113, 133, 0.12);
  color: #fb7185;
}

.license {
  margin-top: 18rpx;
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  background: #0f172a;
}

.empty-license {
  margin-top: 16rpx;
  min-height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(148, 163, 184, 0.32);
  border-radius: 16rpx;
  color: #94a3b8;
}

.reject-box {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: rgba(239, 68, 68, 0.12);
  color: #fb7185;
  font-size: 25rpx;
  line-height: 1.55;
}

.field {
  margin-top: 24rpx;
}

.label {
  font-size: 25rpx;
  color: #e2e8f0;
  margin-bottom: 10rpx;
}

.textarea {
  width: 100%;
  min-height: 190rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(15, 23, 42, 0.9);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  color: #e2e8f0;
  font-size: 27rpx;
  padding: 18rpx 20rpx;
}

.row {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
}

.audit-btn {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.audit-btn::after {
  border: none;
}

.ok {
  background: #22d3ee;
  color: #03111a;
}

.no {
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
  border: 1rpx solid rgba(251, 113, 133, 0.22);
}

.modal {
  position: fixed;
  inset: 0;
  background: rgba(2, 6, 23, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 88%;
  background: rgba(15, 23, 42, 0.98);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.modal-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #f8fafc;
  margin-bottom: 18rpx;
}

.form-item {
  margin-top: 12rpx;
}

.form-label {
  margin-bottom: 10rpx;
  font-size: 25rpx;
  color: #e2e8f0;
}

.modal-buttons {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.modal-button {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.modal-button.secondary {
  background: rgba(30, 41, 59, 0.95);
  color: #e2e8f0;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
}

.modal-button.primary.danger {
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
  border: 1rpx solid rgba(251, 113, 133, 0.22);
}
