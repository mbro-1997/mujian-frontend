.page {
  min-height: 100vh;
  background: #070b16;
  padding: 20rpx 24rpx 140rpx;
  box-sizing: border-box;
}

.card {
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  padding: 24rpx;
  color: #f8fafc;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  backdrop-filter: blur(14px);
}

.card-head {
  display: flex;
  gap: 18rpx;
}

.prop-swiper,
.prop-image {
  width: 168rpx;
  height: 168rpx;
}

.prop-swiper {
  border-radius: 18rpx;
  background: rgba(15, 23, 42, 0.8);
  overflow: hidden;
}

.prop-image {
  display: block;
}

.head-info {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

.line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.45;
}

.section {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.42);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #f8fafc;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.field,
.field-row,
.wide-field {
  padding: 12rpx;
  border-radius: 14rpx;
  background: rgba(15, 23, 42, 0.72);
}

.field-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 10rpx;
}

.wide-field {
  margin-top: 12rpx;
}

.label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
}

.value {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #e2e8f0;
  line-height: 1.45;
  word-break: break-all;
}

.field-row .value {
  margin-top: 0;
  text-align: right;
}

.status {
  margin-top: 12rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status.pending {
  background: rgba(34, 211, 238, 0.12);
  color: #22d3ee;
}

.status.approved {
  background: rgba(52, 211, 153, 0.12);
  color: #34d399;
}

.status.rejected {
  background: rgba(251, 113, 133, 0.12);
  color: #fb7185;
}

.row {
  margin-top: 20rpx;
  display: flex;
  gap: 14rpx;
}

.audit-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  padding: 0;
  text-align: center;
  letter-spacing: 1rpx;
}

.audit-btn::after {
  border: none;
}

.ok {
  background: #22d3ee;
  color: #03111a;
}

.no {
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
  border: 1rpx solid rgba(251, 113, 133, 0.22);
}

.empty-list {
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.72);
}
