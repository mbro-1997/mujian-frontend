<view class="container" style="padding-bottom: 120rpx;">
  <view class="warehouse-top-panel">
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input
        class="search-input"
        placeholder="搜索道具名称 / ID / 风格 / 类型"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="handleKeywordInput"
        confirm-type="search"
        bindconfirm="submitSearch"
      />
      <text wx:if="{{keyword}}" class="clear-search" bindtap="clearSearch">×</text>
    </view>

    <scroll-view scroll-x class="status-tabs" show-scrollbar="{{false}}">
      <view
        wx:for="{{statusTabs}}"
        wx:key="value"
        class="status-tab {{activeStatus === item.value ? 'active' : ''}}"
        data-status="{{item.value}}"
        bindtap="changeStatus"
      >{{item.label}}</view>
    </scroll-view>

    <view class="filter-bar">
      <picker mode="selector" range="{{styleOptions}}" value="{{styleIndex}}" bindchange="changeStyle">
        <view class="filter-chip">{{styleOptions[styleIndex]}}</view>
      </picker>
      <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="changeType">
        <view class="filter-chip">{{typeOptions[typeIndex]}}</view>
      </picker>
      <view class="filter-chip ghost" bindtap="resetFilters">重置</view>
    </view>
  </view>

  <view class="warehouse-panel">
    <view class="card-title">我的仓库</view>
    <view class="list">
      <view class="list-item" wx:for="{{warehouseProps}}" wx:key="id" bindtap="viewPropDetail" data-id="{{item.id}}">
        <image src="{{item.image}}" class="img warehouse-img" mode="aspectFill" />
        <view class="prop-info">
          <view class="prop-name">{{item.name}}</view>
          <view class="prop-meta"><text>尺寸: {{item.size}}</text><text>材质: {{item.material}}</text></view>
          <view class="prop-price"><text class="price">¥{{item.price}}/天</text><text class="deposit">押金: ¥{{item.deposit}}</text></view>
          <view class="prop-status-row">
            <view class="status-tag {{item.statusClass}}">{{item.statusText}}</view>
            <view class="prop-action-wrap">
              <button wx:if="{{item.canToggle}}" class="btn {{item.status === 'offline' ? 'btn-primary' : 'btn-secondary'}} prop-action-btn" size="mini" catchtap="toggleStatus" data-id="{{item.id}}">{{item.actionText}}</button>
              <button wx:else class="btn btn-disabled prop-action-btn" size="mini" disabled>{{item.actionDisabledText}}</button>
            </view>
          </view>
        </view>
      </view>
      <view class="empty-panel warehouse-empty" wx:if="{{!warehouseProps.length}}">暂无符合条件的道具</view>
    </view>
  </view>
</view>
