page {
  background: #070b16;
}

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at 100% 16%, rgba(56, 189, 248, 0.08), transparent 28%),
    #070b16;
}

.header-card,
.card,
.empty-card {
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
}

.title,
.review-title {
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 700;
}

.sub,
.line {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.5;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.status {
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.status.visible {
  color: #34d399;
  background: rgba(52, 211, 153, 0.12);
}

.status.hidden {
  color: #94a3b8;
  background: rgba(148, 163, 184, 0.12);
}

.content {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.56);
  color: #e2e8f0;
  font-size: 25rpx;
  line-height: 1.6;
}

.actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn::after {
  border: none;
}

.btn.hide {
  background: rgba(34, 211, 238, 0.12);
  color: #22d3ee;
}

.btn.del {
  background: rgba(251, 113, 133, 0.12);
  color: #fb7185;
}

.empty-card {
  min-height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 25rpx;
}
