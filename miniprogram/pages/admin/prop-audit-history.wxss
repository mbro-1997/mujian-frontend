page {
  background: #070b16;
}

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at 100% 16%, rgba(56, 189, 248, 0.08), transparent 28%),
    #070b16;
}

.card {
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  color: #f8fafc;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
  backdrop-filter: blur(14px);
}

.row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  flex: 1;
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.line {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.45;
}

.enter-tip {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(34, 211, 238, 0.12);
  color: #67e8f9;
  font-size: 24rpx;
  text-align: center;
  font-weight: 600;
}

.status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 86rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.status.pending {
  background: rgba(34, 211, 238, 0.12);
  color: #22d3ee;
}

.status.approved {
  background: rgba(52, 211, 153, 0.12);
  color: #34d399;
}

.status.rejected {
  background: rgba(251, 113, 133, 0.12);
  color: #fb7185;
}

.empty-list {
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.72);
}
