page {
  background: #070b16;
}

.container {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    radial-gradient(circle at 100% 16%, rgba(56, 189, 248, 0.08), transparent 28%),
    #070b16;
}

.action-card {
  min-height: 180rpx;
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(125, 211, 252, 0.22);
  border-radius: 28rpx;
  padding: 28rpx;
  margin: 0 0 24rpx !important;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
  backdrop-filter: blur(14px);
}

.action-title {
  color: #f8fafc;
  font-size: 32rpx;
  font-weight: 600;
}

.action-subtitle {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin: 0 !important;
}

.metric-card {
  min-height: 148rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  background: rgba(15, 23, 42, 0.88);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
  backdrop-filter: blur(14px);
}

.metric-label {
  color: rgba(226, 232, 240, 0.72);
  font-size: 24rpx;
  font-weight: 500;
}

.metric-value {
  margin-top: 12rpx;
  color: #f8fafc;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.1;
}

.metric-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
}

.metric-cyan .metric-value,
.metric-teal .metric-value,
.metric-main .metric-value {
  color: #67e8f9;
}

.metric-orange .metric-value {
  color: #fbbf24;
}

.metric-purple .metric-value {
  color: #c4b5fd;
}

.metric-green .metric-value {
  color: #34d399;
}
