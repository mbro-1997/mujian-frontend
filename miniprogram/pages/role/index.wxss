.role-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f172a 0%, #111827 55%, #0b1020 100%);
  color: #f8fafc;
  position: relative;
  padding: 24rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

.bg-glow {
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  filter: blur(48rpx);
  opacity: 0.35;
  animation: pulseGlow 5s ease-in-out infinite;
  pointer-events: none;
}

.bg-glow-left {
  left: -120rpx;
  top: 120rpx;
  background: rgba(34, 211, 238, 0.6);
}

.bg-glow-right {
  right: -140rpx;
  top: 220rpx;
  background: rgba(96, 165, 250, 0.5);
  animation-delay: 1.2s;
}

.hero-box {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.3);
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  z-index: 2;
}

.brand {
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.45);
}

.subtitle {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #dbeafe;
  letter-spacing: 1rpx;
}

.panel {
  margin-top: 32rpx;
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(148, 163, 184, 0.28);
  border-radius: 20rpx;
  padding: 28rpx;
  backdrop-filter: blur(8px);
}

.title {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 22rpx;
  letter-spacing: 1rpx;
}

.account-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(15, 118, 110, 0.24), rgba(14, 165, 233, 0.18));
  border: 1px solid rgba(103, 232, 249, 0.32);
}

.account-label {
  font-size: 22rpx;
  color: #bae6fd;
  letter-spacing: 1rpx;
}

.account-main {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.account-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #cbd5e1;
  line-height: 1.5;
}

.account-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.account-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #e0f2fe;
  background: rgba(15, 23, 42, 0.55);
  border: 1px solid rgba(147, 197, 253, 0.28);
}

.role-btn {
  border-radius: 16rpx;
  padding: 30rpx 26rpx;
  margin-bottom: 18rpx;
  border: 1px solid transparent;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.role-btn:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: inset 0 0 0 999rpx rgba(255, 255, 255, 0.04);
}

.role-btn:last-child {
  margin-bottom: 0;
}

.role-btn.supplier {
  background: linear-gradient(135deg, rgba(14, 116, 144, 0.28), rgba(8, 145, 178, 0.22));
  border-color: rgba(34, 211, 238, 0.45);
}

.role-btn.demander {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.28), rgba(99, 102, 241, 0.22));
  border-color: rgba(96, 165, 250, 0.45);
}

.role-btn.wechat {
  background: linear-gradient(135deg, rgba(22, 163, 74, 0.26), rgba(20, 184, 166, 0.2));
  border-color: rgba(52, 211, 153, 0.42);
}

.role-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.role-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #cbd5e1;
  line-height: 1.5;
  letter-spacing: 0.6rpx;
}

.footer {
  margin-top: 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  letter-spacing: 1rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(2, 6, 23, 0.72);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  border-radius: 28rpx 28rpx 0 0;
  padding: 30rpx 24rpx 34rpx;
  background: linear-gradient(180deg, #111b31, #0f172a);
  border-top: 1px solid rgba(148, 163, 184, 0.26);
  box-sizing: border-box;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.sheet-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #cbd5e1;
  letter-spacing: 0.8rpx;
}

.sheet-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 14rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1.2rpx;
}

.sheet-btn::after {
  border: none;
}

.sheet-btn-supplier {
  background: linear-gradient(135deg, #22d3ee, #38bdf8);
  color: #031226;
}

.sheet-btn-admin {
  background: linear-gradient(135deg, #60a5fa, #818cf8);
  color: #0c1130;
}

.sheet-btn-ghost {
  background: rgba(30, 41, 59, 0.95);
  color: #e2e8f0;
  border: 1px solid rgba(148, 163, 184, 0.3);
}

.account-sheet-item {
  margin-top: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(15, 23, 42, 0.82);
  border: 1px solid rgba(148, 163, 184, 0.22);
}

.account-sheet-item.active {
  border-color: rgba(96, 165, 250, 0.6);
  background: linear-gradient(135deg, rgba(30, 64, 175, 0.36), rgba(14, 165, 233, 0.28));
}

.account-sheet-name {
  font-size: 30rpx;
  font-weight: 700;
}

.account-sheet-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #cbd5e1;
  line-height: 1.5;
}

.reveal {
  opacity: 0;
  transform: translateY(18rpx);
  animation: revealUp 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.reveal-1 { animation-delay: 50ms; }
.reveal-3 { animation-delay: 240ms; }
.reveal-4 { animation-delay: 320ms; }
.reveal-5 { animation-delay: 400ms; }
.reveal-6 { animation-delay: 480ms; }
.reveal-7 { animation-delay: 560ms; }

@keyframes revealUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulseGlow {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.28;
  }

  50% {
    transform: scale(1.08);
    opacity: 0.42;
  }
}
