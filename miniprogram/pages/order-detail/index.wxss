.order-detail-page {
  min-height: 100vh;
  padding: 16rpx 16rpx 140rpx;
  box-sizing: border-box;
}

.hero-card,
.info-card,
.prop-card {
  margin-bottom: 16rpx;
}

.hero-card {
  background: linear-gradient(135deg, rgba(30, 64, 175, 0.38), rgba(15, 23, 42, 0.86));
}

.hero-rejected {
  border-color: rgba(248, 113, 113, 0.48);
  background: linear-gradient(135deg, rgba(127, 29, 29, 0.58), rgba(15, 23, 42, 0.9));
}

.hero-top {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: flex-start;
}

.page-title {
  font-size: 36rpx;
  font-weight: 900;
}

.order-no {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #cbd5e1;
}

.reject-panel {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: rgba(127, 29, 29, 0.56);
  border: 1px solid rgba(248, 113, 113, 0.48);
}

.review-panel {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(59, 130, 246, 0.14);
  color: #bfdbfe;
  font-size: 25rpx;
}

.reject-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #fecaca;
}

.reject-reason {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #fee2e2;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.detail-item {
  display: flex;
  gap: 18rpx;
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.14);
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  width: 150rpx;
  color: #94a3b8;
  font-size: 25rpx;
}

.detail-value {
  flex: 1;
  color: #e2e8f0;
  font-size: 25rpx;
  line-height: 1.45;
}

.price {
  color: #38bdf8;
  font-weight: 800;
}

.deposit {
  color: #93c5fd;
  font-weight: 800;
}

.prop-item {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.14);
}

.prop-item:last-child {
  border-bottom: none;
}

.prop-image {
  width: 132rpx;
  height: 132rpx;
  border-radius: 14rpx;
  background: #1e293b;
}

.prop-main {
  flex: 1;
  min-width: 0;
}

.prop-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.prop-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 800;
  color: #f8fafc;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.prop-arrow {
  color: #64748b;
  font-size: 34rpx;
  line-height: 1;
}

.prop-money-row,
.prop-meta-row,
.prop-scan-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.prop-money-row {
  margin-top: 8rpx;
}

.prop-price {
  color: #38bdf8;
  font-size: 25rpx;
  font-weight: 800;
}

.prop-deposit {
  color: #cbd5e1;
  font-size: 24rpx;
  font-weight: 700;
}

.prop-meta-row {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 23rpx;
}

.prop-meta-row text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.prop-scan-row {
  margin-top: 10rpx;
  justify-content: flex-start;
}

.prop-scan-row text {
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.scan-done {
  background: rgba(52, 211, 153, 0.14);
  color: #34d399;
}

.scan-wait {
  background: rgba(251, 191, 36, 0.14);
  color: #fbbf24;
}

.empty-card {
  min-height: 180rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #94a3b8;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(15, 23, 42, 0.94);
  border-top: 1px solid rgba(148, 163, 184, 0.18);
  box-sizing: border-box;
  display: flex;
  gap: 14rpx;
}

.bottom-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 18rpx;
  text-align: center;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.bottom-btn.secondary {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}

.planet-rate {
  display: flex;
  gap: 12rpx;
  padding: 6rpx 0;
}

.planet {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  font-size: 40rpx;
  filter: grayscale(1);
  opacity: 0.38;
  transform: scale(0.92);
  transition: all 0.18s ease;
}

.planet.active {
  filter: none;
  opacity: 1;
  transform: scale(1.08);
  text-shadow: 0 0 16rpx rgba(251, 191, 36, 0.52);
}

.review-textarea {
  min-height: 170rpx;
  line-height: 1.5;
  padding-top: 18rpx;
}
