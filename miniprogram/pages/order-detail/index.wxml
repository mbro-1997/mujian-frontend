<view class="container order-detail-page" wx:if="{{order}}">
  <view class="card hero-card {{rejected ? 'hero-rejected' : ''}}">
    <view class="hero-top">
      <view>
        <view class="page-title">订单详情</view>
        <view class="order-no">订单号：{{order.orderNo || order.id}}</view>
      </view>
      <view class="status-tag {{order.statusClass}}">{{order.statusText}}</view>
    </view>

    <view wx:if="{{rejected}}" class="reject-panel">
      <view class="reject-title">订单已被工厂驳回</view>
      <view class="reject-reason">驳回理由：{{order.cancelReason || '工厂未填写具体理由'}}</view>
    </view>
    <view wx:if="{{order.status === 'wait_review'}}" class="review-panel">
      <view>评价进度：租赁方{{order.demanderReviewed ? '已评' : '待评'}} / 工厂{{order.supplierReviewed ? '已评' : '待评'}}</view>
    </view>
  </view>

  <view class="card info-card">
    <view class="section-title">租赁信息</view>
    <view class="detail-item"><text class="detail-label">租赁日期</text><text class="detail-value">{{order.rentalStartDate || '-'}} 至 {{order.rentalEndDate || '-'}}</text></view>
    <view class="detail-item"><text class="detail-label">租赁天数</text><text class="detail-value">{{order.rentalDays || 1}} 天</text></view>
    <view class="detail-item"><text class="detail-label">地址</text><text class="detail-value">{{order.contactAddress || '未填写'}}</text></view>
    <view class="detail-item"><text class="detail-label">使用场景</text><text class="detail-value">{{order.useScene || '未填写'}}</text></view>
    <view class="detail-item"><text class="detail-label">备注</text><text class="detail-value">{{order.specialRemark || '无'}}</text></view>
    <view class="detail-item"><text class="detail-label">租金</text><text class="detail-value price">¥{{order.price}}</text></view>
    <view class="detail-item"><text class="detail-label">押金</text><text class="detail-value deposit">¥{{order.deposit}}</text></view>
  </view>

  <view class="card prop-card">
    <view class="section-title">订单道具</view>
    <view class="prop-item" wx:for="{{order.props}}" wx:key="id" data-id="{{item.id}}" bindtap="openPropDetail">
      <image src="{{item.image}}" class="prop-image" mode="aspectFill" />
      <view class="prop-main">
        <view class="prop-top">
          <view class="prop-name">{{item.name}}</view>
          <view class="prop-arrow">›</view>
        </view>
        <view class="prop-money-row">
          <text class="prop-price">¥{{item.price}}/天</text>
          <text class="prop-deposit">押金 ¥{{item.deposit}}</text>
        </view>
        <view class="prop-meta-row">
          <text>{{item.size || item.type || '规格未填写'}}</text>
          <text>{{item.material || '材质未填写'}}</text>
        </view>
        <view class="prop-scan-row">
          <text class="{{item.outboundScanned ? 'scan-done' : 'scan-wait'}}">出库{{item.outboundScanned ? '已扫' : '未扫'}}</text>
          <text class="{{item.returnScanned ? 'scan-done' : 'scan-wait'}}">归还{{item.returnScanned ? '已扫' : '未扫'}}</text>
        </view>
      </view>
    </view>
    <view class="empty-card" wx:if="{{!order.props.length}}">暂无道具</view>
  </view>

  <view class="bottom-actions">
    <view class="scan-action-row" wx:if="{{isSupplier && (order.showOutboundScan || order.showReturnScan)}}">
      <view wx:if="{{order.showOutboundScan && order.canScanOutboundNow}}" class="bottom-btn scan-btn half" data-mode="outbound" bindtap="openScanModal">出库扫码</view>
      <view wx:if="{{order.showOutboundScan && !order.canScanOutboundNow}}" class="bottom-btn disabled half">{{order.outboundDisabledText}}</view>
      <view wx:if="{{order.showReturnScan && order.canScanReturnNow}}" class="bottom-btn scan-btn half" data-mode="return" bindtap="openScanModal">入库扫码</view>
      <view wx:if="{{order.showReturnScan && !order.canScanReturnNow}}" class="bottom-btn disabled half">{{order.returnDisabledText}}</view>
    </view>
    <view wx:if="{{order.canReview}}" class="bottom-btn secondary full" bindtap="openReviewModal">评价订单</view>
    <view wx:if="{{order.canApplyDispute}}" class="bottom-btn subtle full" bindtap="openDisputeModal">申请仲裁</view>
    <view class="bottom-btn full" bindtap="goBack">关闭</view>
  </view>

  <view class="modal" wx:if="{{showScanModal}}">
    <view class="modal-content" catchtap="true">
      <view class="modal-title">{{scanMode === 'outbound' ? '确认出库扫码' : '确认入库扫码'}}</view>
      <view class="scan-order-id">订单号：{{order.orderNo || order.id}}</view>
      <view class="scan-order-id" wx:if="{{scanMode === 'outbound'}}">出库进度：{{order.outboundScannedCount}} / {{order.propCount}}</view>
      <view class="scan-order-id" wx:else>入库进度：{{order.returnScannedCount}} / {{order.propCount}}</view>

      <view class="scan-confirm">
        <view class="scan-confirm-title">已识别小程序码</view>
        <view class="scan-confirm-code">{{scanQrCodeId}}</view>
        <view class="scan-confirm-prop" wx:if="{{scanPropName}}">道具：{{scanPropName}}</view>
        <view class="scan-confirm-tip">请核对道具属于当前订单和当前工厂，确认后才会提交扫码结果。</view>
      </view>

      <view class="modal-buttons">
        <view class="modal-button secondary" bindtap="closeScanModal">取消</view>
        <view class="modal-button primary" bindtap="confirmScannedQr">{{scanMode === 'outbound' ? '确认出库' : '确认入库'}}</view>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showReviewModal}}" bindtap="closeReviewModal">
    <view class="modal-content" catchtap="true">
      <view class="modal-title">订单评价</view>
      <view class="form-item">
        <view class="form-label">道具本身评分</view>
        <view class="planet-rate">
          <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-score="{{item}}" bindtap="updateReviewPropScore" class="planet {{reviewPropScore >= item ? 'active' : ''}}">🌟</text>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">履约体验评分</view>
        <view class="planet-rate">
          <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-score="{{item}}" bindtap="updateReviewCounterpartyScore" class="planet {{reviewCounterpartyScore >= item ? 'active' : ''}}">🌟</text>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">评价内容</view>
        <textarea class="form-input review-textarea" placeholder="请输入评价内容" value="{{reviewContent}}" bindinput="updateReviewContent" />
      </view>
      <view class="modal-buttons">
        <view class="modal-button secondary" bindtap="closeReviewModal">取消</view>
        <view class="modal-button primary" bindtap="submitReview">提交评价</view>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showDisputeModal}}">
    <view class="modal-content" catchtap="true">
      <view class="modal-title">订单仲裁申请</view>
      <view class="dispute-tip">请写清楚争议原因、发生节点和期望处理方式。仲裁金额不能超过当前订单押金总额 ¥{{order.deposit}}。</view>
      <view class="form-item">
        <view class="form-label">仲裁原因</view>
        <textarea class="form-input review-textarea" placeholder="例如：归还时双方对道具破损责任存在争议" value="{{disputeReason}}" bindinput="updateDisputeReason" />
      </view>
      <view class="form-item">
        <view class="form-label">仲裁金额（元）</view>
        <input class="form-input" type="digit" placeholder="可填 0，最高不超过押金总额" value="{{disputeAmount}}" bindinput="updateDisputeAmount" />
      </view>
      <view class="form-item">
        <view class="form-label">证明图片（最多 3 张，选填）</view>
        <view class="evidence-grid">
          <view class="evidence-item" wx:for="{{disputeImages}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill" class="evidence-img" bindtap="previewDisputeImage" data-url="{{item}}" />
            <view class="evidence-remove" bindtap="removeDisputeImage" data-index="{{index}}">×</view>
          </view>
          <view wx:if="{{disputeImages.length < 3}}" class="evidence-add" bindtap="chooseDisputeImages">+ 上传</view>
        </view>
      </view>
      <view class="modal-buttons">
        <view class="modal-button secondary" bindtap="closeDisputeModal">取消</view>
        <view class="modal-button primary" bindtap="submitDispute">提交仲裁</view>
      </view>
    </view>
  </view>
</view>
