<view class="page">
  <view class="card">
    <view class="title">工厂入驻</view>
    <view class="desc">请输入管理员提供的邀请码，验证通过后可提交工厂入驻资料。</view>

    <input
      class="input"
      placeholder="请输入邀请码"
      value="{{code}}"
      bindinput="onInput"
    />

    <button class="btn primary" loading="{{loading}}" bindtap="nextStep">下一步</button>
    <button class="btn ghost" bindtap="contactAdmin">联系管理员</button>
  </view>
</view>
