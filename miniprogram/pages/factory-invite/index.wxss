.page { min-height: 100vh; background: #0b1220; padding: 24rpx; box-sizing: border-box; }
.card { margin-top: 80rpx; background: #101a2c; border: 1px solid #2a3f67; border-radius: 20rpx; padding: 30rpx; color: #e2e8f0; }
.title { font-size: 40rpx; font-weight: 700; }
.desc { margin-top: 14rpx; font-size: 26rpx; color: #b6c5dd; line-height: 1.6; }
.input { margin-top: 28rpx; height: 108rpx; line-height: 108rpx; border-radius: 18rpx; background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(96, 165, 250, 0.28); padding: 0 24rpx; color: #e2e8f0; font-size: 31rpx; box-sizing: border-box; }
.btn { margin-top: 20rpx; height: 82rpx; line-height: 82rpx; border-radius: 14rpx; font-size: 28rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; padding: 0; text-align: center; }
.btn::after { border: none; }
.primary { background: linear-gradient(135deg, #38bdf8, #0ea5e9); color: #072033; }
.ghost { background: #1d2a45; color: #dbeafe; }
