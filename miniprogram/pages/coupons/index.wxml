<view class="trade"><view class="toolbar"><button class="{{status==='available'?'selected':''}}" data-status="available" bindtap="filter">可用 {{availableCount}}</button><button class="{{status==='unavailable'?'selected':''}}" data-status="unavailable" bindtap="filter">不可用 {{unavailableCount}}</button><button bindtap="openOffers">领取优惠券</button><button bindtap="records">使用记录 ›</button></view><view class="notice">结算时按实际节省金额推荐最省的一张，可手动更换或不使用。</view><view wx:if="{{message}}" class="feedback">{{message}}<button bindtap="retry">重试</button></view><view wx:for="{{items}}" wx:key="id" class="coupon" data-id="{{item.id}}" bindtap="detail"><view class="coupon-value">{{item.value}}</view><view class="coupon-info"><view class="item-title">{{item.name}}</view><view class="muted">租金满 ¥{{item.threshold}} 可用 · {{item.label}}</view><view class="muted">{{item.validUntilText}} 到期</view><view class="link">查看规则 ›</view></view></view><view wx:if="{{!items.length && !message}}" class="blank">{{busy?'正在读取…':'当前暂无优惠券'}}</view></view>
<coupon-offers id="couponOffers" bindclaimed="refreshWallet"/>
