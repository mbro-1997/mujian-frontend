<view class="trade"><list-filters resettable="{{status !== 'available'}}" bindresetfilters="resetFilters" quiet="{{returnRefresh}}" filters="{{[{key:'status',title:'使用状态',options:[{code:'available',label:'可用 '+availableCount},{code:'unavailable',label:'不可用 '+unavailableCount}]}]}}" values="{{ {status:status} }}" disabled="{{busy}}" bindselectfilter="filter"/><view class="toolbar"><button bindtap="openOffers">领取优惠券</button><button bindtap="records">使用记录 ›</button></view><view class="notice">结算时按实际节省金额推荐最省的一张，可手动更换或不使用。</view><view wx:if="{{message}}" class="feedback">{{message}}<button bindtap="retry">重试</button></view><view wx:for="{{items}}" wx:key="id" class="coupon" data-id="{{item.id}}" bindtap="detail"><view class="coupon-value">{{item.value}}</view><view class="coupon-info"><view class="item-title">{{item.name}}</view><view class="muted">租金满 ¥{{item.threshold}} 可用 · {{item.label}}</view><view class="muted">{{item.validUntilText}} 到期</view><view class="link">查看规则 ›</view></view></view><view wx:if="{{!items.length && !message}}" class="blank"><mj-loading wx:if="{{busy && !returnRefresh}}" label="正在读取"/><text wx:else>当前暂无优惠券</text></view></view>
<coupon-offers id="couponOffers" bindclaimed="refreshWallet"/>
