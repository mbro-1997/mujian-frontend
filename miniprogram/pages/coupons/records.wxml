<view class="trade"><view class="notice">返还后再次使用会新增记录，历史不会被覆盖。</view><view wx:if="{{message}}" class="feedback">{{message}}<button bindtap="retry">重试</button></view><view wx:for="{{items}}" wx:key="usageId" class="section" data-id="{{item.batchId}}" bindtap="open"><view class="row"><text class="heading">{{item.couponName}}</text><text class="badge">{{item.label}}</text></view><view class="row"><text>本次优惠</text><text>¥{{item.discount}}</text></view><view class="muted">使用时间 {{item.usedAtText||'尚未核销'}}</view><view wx:if="{{item.returnedAtText}}" class="muted">返还时间 {{item.returnedAtText}}</view><view class="link">查看原付款批次 ›</view></view><view wx:if="{{!items.length && !message}}" class="blank">{{busy?'正在读取…':'暂无使用记录'}}</view></view>