.account-page {
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
}
.role-wrap {
  padding: 14px 16px 24px;
  background: #f5f5f5;
}
.role-hero {
  height: 220px;
  overflow: hidden;
  background: white;
  position: relative;
  padding: 28px 20px 0;
  border-bottom: 1px solid #eee;
}
.beam {
  position: absolute;
  top: 76px;
  width: 52px;
  height: 118px;
  clip-path: polygon(50% 0, 0 100%, 100% 100%);
  opacity: 0.55;
}
.beam.a {
  left: 14%;
  background: #9bd6dc;
}
.beam.b {
  left: 45%;
  background: #bbc4ff;
}
.beam.c {
  right: 14%;
  background: #a9c7f4;
}
.stage-line {
  position: absolute;
  left: 28px;
  right: 28px;
  bottom: 32px;
  height: 42px;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.08);
}
.role-brand {
  position: relative;
  font-size: 34px;
  font-weight: 900;
  margin-bottom: 7px;
}
.role-subtitle {
  position: relative;
  font-size: 16px;
  font-weight: 900;
  color: #6b7280;
}
.role-hint {
  position: relative;
  margin-top: 12px;
  color: #9ca3af;
  font-size: 13px;
  line-height: 1.55;
}
.role-panel {
  margin-top: 12px;
  padding-top: 20px;
  background: white;
}
.role-heading {
  padding: 0 18px 18px;
  font-size: 23px;
  font-weight: 900;
}
.role-card {
  min-height: 104px;
  display: grid;
  grid-template-columns: 54px minmax(0, 1fr) 18px;
  gap: 14px;
  align-items: center;
  padding: 18px;
  border-top: 1px solid #f0f0f0;
}
.role-icon {
  width: 54px;
  height: 54px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: 900;
  color: white;
}
.role-icon.rent {
  background: linear-gradient(135deg, #1d4ed8, #312e81);
}
.role-icon.factory {
  background: linear-gradient(135deg, #0f766e, #0e7490);
}
.role-name {
  font-size: 22px;
  font-weight: 900;
  margin-bottom: 7px;
}
.role-card .muted {
  font-size: 14px;
  line-height: 1.5;
}
.role-note {
  margin-top: 14px;
  background: #fff;
  padding: 12px 18px;
  color: #6b7280;
  font-size: 13px;
}
.state-detail {
  margin-top: 16px;
}

.role-card:last-child {
  border-bottom: 1px solid #f0f0f0;
}


.account-settings{padding:16px 16px 0}.account-settings-card{background:#fff;border:1px solid #eee;border-radius:8px;margin-bottom:16px;padding:0 16px}.account-setting-row{min-height:54px;display:flex;justify-content:space-between;align-items:center;gap:16px;border-bottom:1px solid #eee;font-size:15px}.account-setting-row:last-child{border-bottom:0}.account-setting-row>text:last-child{color:#6b7280;overflow-wrap:anywhere;text-align:right;min-width:0}.account-settings button.account-logout{width:100%;margin:20px 0;background:#fff;color:#111827;border-radius:8px;min-height:48px}
.account-settings.renter-account { min-height:100vh; background:var(--mj-canvas); color:var(--mj-ink); }
.renter-account .account-settings-card { border-color:var(--mj-line); border-radius:var(--mj-card); }
.renter-account button.account-logout { margin:0 0 16px; border:1px solid var(--mj-line); border-radius:var(--mj-control); }
