.page { min-height: 100vh; background: #0b1220; padding: 24rpx; box-sizing: border-box; }
.card { margin-top: 60rpx; background: #101a2c; border: 1px solid #2a3f67; border-radius: 20rpx; padding: 30rpx; color: #e2e8f0; }
.title { font-size: 40rpx; font-weight: 700; }
.desc { margin-top: 14rpx; font-size: 25rpx; color: #b6c5dd; line-height: 1.6; }
.info-line { margin-top: 16rpx; font-size: 26rpx; color: #dbeafe; }
.reject-box { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: rgba(239, 68, 68, 0.12); color: #fecaca; font-size: 25rpx; line-height: 1.6; }
.btn {
  width: 72%;
  margin: 22rpx auto 0;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.btn::after { border: none; }
.primary { background: linear-gradient(135deg, #38bdf8, #0ea5e9); color: #072033; }
.ghost { background: #1d2a45; color: #dbeafe; }
