.page { min-height: 100vh; background: #0b1220; box-sizing: border-box; }
.card { margin: 24rpx; background: #101a2c; border: 1px solid #2a3f67; border-radius: 20rpx; padding: 28rpx; color: #e2e8f0; }
.title { font-size: 38rpx; font-weight: 700; }
.desc { margin-top: 10rpx; font-size: 24rpx; color: #b6c5dd; line-height: 1.6; }
.field { margin-top: 22rpx; }
.label { margin-bottom: 10rpx; font-size: 25rpx; color: #dbeafe; }
.input, .textarea { width: 100%; box-sizing: border-box; border-radius: 14rpx; background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(96, 165, 250, 0.28); color: #e2e8f0; font-size: 28rpx; padding: 20rpx 22rpx; }
.input { height: 88rpx; line-height: 88rpx; }
.textarea { min-height: 180rpx; }
.upload-row { display: flex; align-items: center; gap: 16rpx; }
.upload-btn { margin: 0; width: 240rpx; height: 74rpx; line-height: 74rpx; border-radius: 14rpx; background: #1d4ed8; color: #eff6ff; font-size: 26rpx; }
.upload-tip { color: #b6c5dd; font-size: 24rpx; }
.submit-btn { margin-top: 28rpx; height: 82rpx; line-height: 82rpx; border-radius: 14rpx; background: linear-gradient(135deg, #38bdf8, #0ea5e9); color: #072033; font-size: 28rpx; font-weight: 700; }
