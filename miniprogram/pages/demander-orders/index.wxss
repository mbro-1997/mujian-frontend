.header-card {
  margin: 0 16rpx 16rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 800;
}

.order-card {
  margin: 0 16rpx 16rpx;
}

.order-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-id {
  font-size: 27rpx;
  font-weight: 800;
}

.order-date {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #cbd5e1;
}

.order-meta {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
}

.order-price {
  color: #38bdf8;
  font-weight: 800;
}

.order-deposit {
  color: #93c5fd;
}

.order-actions {
  margin-top: 14rpx;
}

.reject-banner {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(127, 29, 29, 0.52);
  border: 1px solid rgba(248, 113, 113, 0.46);
}

.reject-title {
  color: #fecaca;
  font-size: 27rpx;
  font-weight: 900;
}

.reject-reason {
  margin-top: 8rpx;
  color: #fee2e2;
  font-size: 24rpx;
  line-height: 1.45;
}

.empty-card {
  min-height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
}

.detail-item {
  display: flex;
  margin-bottom: 8rpx;
}

.detail-label {
  width: 130rpx;
  color: #cbd5e1;
}

.detail-value {
  flex: 1;
}

.prop-list {
  max-height: 420rpx;
  overflow-y: auto;
}

.prop-item {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.prop-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
}

.prop-details {
  flex: 1;
}

.prop-name {
  font-size: 26rpx;
  font-weight: 800;
}

.prop-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #94a3b8;
}

.prop-price {
  margin-top: 8rpx;
  color: #38bdf8;
  font-weight: 800;
}

.review-textarea {
  min-height: 170rpx;
  line-height: 1.5;
  padding-top: 18rpx;
}

.planet-rate {
  display: flex;
  gap: 12rpx;
  padding: 6rpx 0;
}

.planet {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  font-size: 40rpx;
  filter: grayscale(1);
  opacity: 0.38;
  transform: scale(0.92);
  transition: all 0.18s ease;
}

.planet.active {
  filter: none;
  opacity: 1;
  transform: scale(1.08);
  text-shadow: 0 0 16rpx rgba(251, 191, 36, 0.52);
}
