<view class="trade">
  <view wx:if="{{busy && !detail && !message}}" class="mj-read-state"><mj-loading label="正在读取退款记录"/></view><view wx:if="{{message}}" class="feedback">{{message}}</view><block wx:if="{{detail}}"><view class="section hero"><view class="heading">退款{{detail.label}}</view><view class="amount">¥{{detail.total}}</view><view class="muted">{{detail.status==='success'?'原路退款已确认成功':'本笔为应退金额，实际到账请以成功状态为准'}}</view></view><view class="section"><view class="heading">退款明细</view><view class="row"><text>{{detail.businessType==='custom_order'?'定制商品':'租金'}}</text><text>¥{{detail.rent}}</text></view><view class="row"><text>押金</text><text>¥{{detail.deposit}}</text></view><view class="row"><text>运费</text><text>¥{{detail.freight}}</text></view><view class="muted">{{detail.reason}}</view></view><view class="section"><view class="heading">退款进度</view><view class="muted">退款号 {{detail.refundNo}}</view><view class="muted">申请 {{detail.requestedAtText}}</view><view wx:if="{{detail.successAtText}}" class="muted">成功 {{detail.successAtText}}</view></view><view wx:if="{{detail.status==='failed'}}" class="notice">渠道结果仍需处理，平台继续核实原退款，请勿重复申请。</view><view wx:if="{{detail.couponReturn.status==='returned'}}" class="section" bindtap="coupon"><view class="heading">原优惠券已返还 ›</view><view>有效期至 {{detail.couponReturn.validUntilText}}</view></view><view wx:elif="{{detail.couponReturn.status==='not_returned'}}" class="notice">原券尚未返还。同次付款全部原款退完且无扣款，才会返还。</view></block><button bindtap="load" disabled="{{busy}}">查询最新退款状态</button>
<navigator class="service-entry" wx:if="{{detail}}" url="/pages/service/index?type=refund_order&id={{id}}">咨询平台客服 ›</navigator>
</view>
