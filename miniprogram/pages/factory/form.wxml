<view class="factory-page" bindtouchstart="activity"><view class="hero"><view class="heading">{{mode === 'change' ? '修改工厂资料' : previous ? '重新提交工厂资料' : '完善工厂资料'}}</view><view class="muted">填写真实资料，审核通过后生效。* 为必填项</view></view><view class="feedback" wx:if="{{message}}">{{message}}</view><view wx:if="{{busy && !fields && !message}}" class="mj-read-state"><mj-loading label="正在读取工厂资料"/></view><block wx:if="{{fields}}"><view class="card"><view class="section-title">基础信息</view><text class="label">工厂名称 *</text><input id="field-factoryName" adjust-position="{{false}}" always-embed data-key="factoryName" value="{{fields.factoryName}}" bindinput="input" maxlength="128"/><text class="label">工厂头像 *</text><view wx:if="{{fields.factoryAvatar}}" class="image-row"><view class="mj-photo-frame"><private-material factory-file="{{fields.factoryAvatar}}" compact/><photo-remove identity="{{fields.factoryAvatar.localPath || fields.factoryAvatar.locator}}" data-field="factoryAvatar" disabled="{{busy || locked}}" bindremove="remove"/></view><button size="mini" data-field="factoryAvatar" bindtap="preview">查看头像</button></view><button data-field="factoryAvatar" bindtap="choose">{{fields.factoryAvatar ? '更换头像' : '选择头像'}}</button><text class="label">统一社会信用代码 *</text><input id="field-unifiedSocialCreditCode" adjust-position="{{false}}" always-embed data-key="unifiedSocialCreditCode" value="{{fields.unifiedSocialCreditCode}}" bindinput="input" maxlength="18"/><text class="label">营业执照 *</text><view wx:if="{{fields.businessLicense}}" class="image-row"><view class="mj-photo-frame"><private-material factory-file="{{fields.businessLicense}}" compact/><photo-remove identity="{{fields.businessLicense.localPath || fields.businessLicense.locator}}" data-field="businessLicense" disabled="{{busy || locked}}" bindremove="remove"/></view><button size="mini" data-field="businessLicense" bindtap="preview">查看执照</button></view><button data-field="businessLicense" bindtap="choose">选择营业执照</button><text class="label">工厂实景 *（1～3张）</text><view class="image-row" wx:for="{{fields.factoryPhotos}}" wx:key="index"><view class="mj-photo-frame"><private-material factory-file="{{item}}" compact/><photo-remove identity="{{item.localPath || item.locator}}" data-field="factoryPhotos" data-index="{{index}}" disabled="{{busy || locked}}" bindremove="remove"/></view><button size="mini" data-field="factoryPhotos" data-index="{{index}}" bindtap="preview">查看图片 {{index+1}}</button></view><button wx:if="{{fields.factoryPhotos.length < 3}}" data-field="factoryPhotos" bindtap="choose">添加实景照片</button><view class="note">JPEG / PNG，每张不超过5MiB、2000万像素。最终确认提交后上传。</view></view><view class="card"><view class="section-title">联系与经营信息</view><text class="label">联系人 *</text><input id="field-contactName" adjust-position="{{false}}" always-embed data-key="contactName" value="{{fields.contactName}}" bindinput="input" maxlength="64"/><text class="label">联系电话</text><view class="readonly">{{fields.contactPhone || '使用当前账号已验证手机号，提交时自动带入'}}</view><view class="note">联系电话更换暂未开放，可继续修改其他资料</view><text class="label">工厂地址 *</text><textarea id="field-factoryAddress" adjust-position="{{false}}" data-key="factoryAddress" value="{{fields.factoryAddress}}" bindinput="input" maxlength="255"/><text class="label">主营业务</text><textarea id="field-mainBusiness" adjust-position="{{false}}" data-key="mainBusiness" value="{{fields.mainBusiness}}" bindinput="input" maxlength="255"/><text class="label">工人数 *</text><input id="field-workerCount" adjust-position="{{false}}" always-embed type="number" data-key="workerCount" value="{{fields.workerCount}}" bindinput="input" maxlength="10"/><text class="label">擅长品类 *</text><checkbox-group bindchange="category"><label class="option" wx:for="{{options}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.selected}}" disabled="{{!item.enabled && !item.retained}}"/>{{item.label}}{{!item.enabled ? '（停用，原值可保留）' : ''}}</label></checkbox-group></view><view class="card"><view class="section-title">服务案例（最多10组）</view><view class="case" wx:for="{{fields.cases}}" wx:key="index" wx:for-item="entry" wx:for-index="caseIndex"><text class="label">案例 {{caseIndex+1}}</text><input id="field-title-{{caseIndex}}" adjust-position="{{false}}" always-embed placeholder="案例标题" value="{{entry.title}}" data-index="{{caseIndex}}" data-key="title" bindinput="caseInput" maxlength="128"/><textarea id="field-description-{{caseIndex}}" adjust-position="{{false}}" placeholder="案例描述" value="{{entry.description}}" data-index="{{caseIndex}}" data-key="description" bindinput="caseInput" maxlength="2000"/><view class="image-row" wx:for="{{entry.images}}" wx:key="index"><view class="mj-photo-frame"><private-material factory-file="{{item}}" compact/><photo-remove identity="{{item.localPath || item.locator}}" data-field="cases" data-caseindex="{{caseIndex}}" data-index="{{index}}" disabled="{{busy || locked}}" bindremove="remove"/></view><button size="mini" data-field="cases" data-caseindex="{{caseIndex}}" data-index="{{index}}" bindtap="preview">查看案例图 {{index+1}}</button></view><button wx:if="{{entry.images.length < 3}}" data-field="cases" data-index="{{caseIndex}}" bindtap="choose">添加案例图片（最多3张）</button><button data-index="{{caseIndex}}" bindtap="removeCase">删除此案例</button></view><button wx:if="{{fields.cases.length < 10}}" bindtap="addCase">＋ 添加案例</button></view><view class="card"><text class="label">备注</text><textarea id="field-remark" adjust-position="{{false}}" data-key="remark" value="{{fields.remark}}" bindinput="input" maxlength="500"/></view><button class="primary" bindtap="next" disabled="{{busy || locked}}" loading="{{busy && !returnRefresh}}">{{mode === 'change' ? '确认提交变更' : '下一步：阅读入驻规则'}}</button></block></view>
