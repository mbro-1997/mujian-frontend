<view class="factory-page" bindtouchstart="activity"><view wx:if="{{body}}" class="card"><view class="heading">{{body.title}}</view><view class="muted">版本 {{body.version}}</view><rich-text nodes="{{body.contentText}}"/><button bindtap="close">返回规则确认</button></view><block wx:else><view class="hero"><view class="heading">{{readOnly?'平台规则':'确认工厂入驻规则'}}</view><view class="muted">{{readOnly?'查看工厂服务相关规则。':'请阅读两份规则全文，并由本人确认同意。'}}</view></view><checkbox-group bindchange="check"><view class="card" wx:for="{{rules}}" wx:key="documentId"><view class="rule-link" data-id="{{item.documentId}}" bindtap="open">《{{item.title}}》 ›</view><view class="note">版本 {{item.version}}</view><label wx:if="{{!readOnly}}"><checkbox value="{{item.documentId}}" checked="{{item.selected}}"/>我已阅读并同意本规则</label></view></checkbox-group><view class="feedback" wx:if="{{message}}">{{message}}</view><mj-loading wx:if="{{loadingRules}}" label="正在读取入驻规则"/><button wx:elif="{{!rulesReady}}" bindtap="load">重新加载规则</button><button wx:if="{{!readOnly}}" class="primary" bindtap="submit" loading="{{busy && !returnRefresh}}" disabled="{{busy || !rulesReady || !allSelected}}">同意规则并提交入驻申请</button></block></view>