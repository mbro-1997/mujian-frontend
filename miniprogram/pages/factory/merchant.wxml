<view class="trade">
<button wx:if="{{pending}}" bindtap="recover" disabled="{{busy}}">查询原操作结果</button>

  <view wx:if="{{busy && !detail && !message}}" class="mj-read-state"><mj-loading label="正在读取收款账户"/></view><view wx:if="{{message}}" class="feedback">{{message}}<button bindtap="load">刷新账户</button></view><block wx:if="{{detail}}"><view class="section hero"><view class="row"><text class="heading">微信平台收付通</text><text class="badge">{{detail.label}}</text></view><view class="muted">完成商户进件和分账能力开通后，才可参与新的租赁付款。</view></view><view class="section"><view class="heading">收款主体</view><view class="row"><text>主体名称</text><text>{{detail.subjectName || '暂未提供'}}</text></view></view><view class="section"><view class="heading">渠道信息</view><view class="row"><text>二级商户号</text><text>{{detail.subMerchantMasked||'尚未取得'}}</text></view><view class="row"><text>分账能力</text><text>{{detail.profitLabel}}</text></view><view class="row"><text>最近同步</text><text>{{detail.lastSyncedAtText||'暂无'}}</text></view></view><view wx:if="{{!detail.onboardingAvailable && detail.nextAction==='contact_platform'}}" class="notice">自助进件尚未开放，可联系平台办理。</view><view class="notice">银行卡等敏感资料由微信收集。账户受限时，既有订单仍可查询和处理合法退款。</view><button wx:if="{{detail.actionUrl}}" bindtap="copy">复制微信办理链接</button><view wx:if="{{detail.actionUrl}}" class="muted">使用浏览器打开微信提供的链接继续办理。</view><view class="footer"><button class="secondary" bindtap="sync" disabled="{{busy}}">同步收款状态</button><button wx:if="{{detail.onboardingAvailable}}" class="primary" bindtap="onboard" disabled="{{busy}}">开始微信进件</button></view></block></view>