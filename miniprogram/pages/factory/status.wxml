<import src="details.wxml"/><view class="factory-page" bindtouchstart="activity"><view wx:if="{{busy && !label && !message}}" class="mj-read-state"><mj-loading label="正在读取审核状态"/></view><view class="hero"><view class="heading">{{label}}</view><view class="muted">{{mode === 'change' ? '工厂资料变更' : '工厂入驻申请'}}</view></view><view class="feedback" wx:if="{{message}}">{{message}}</view><view class="card" wx:if="{{application}}"><view>申请编号：{{application.applicationNo}}</view><view class="note">提交时间：{{application.submittedAtText}}</view><view wx:if="{{application.reviewedAtText}}">审核时间：{{application.reviewedAtText}}</view><view wx:if="{{application.rejectReason}}" class="feedback">驳回原因：{{application.rejectReason}}</view><view class="note" wx:if="{{application.auditStatus === 'pending'}}">资料审核中，请耐心等待。当前申请只读，不可重复新建。</view><button wx:if="{{application.previousApplicationId}}" bindtap="history">查看上一份申请</button></view><template wx:if="{{fields}}" is="factory-details" data="{{fields}}"/><button class="primary" wx:if="{{application.auditStatus === 'rejected' && !historyId}}" bindtap="edit">修改后重新提交</button><button wx:if="{{application.auditStatus === 'approved'}}" bindtap="profile">查看当前工厂资料</button><button bindtap="load" loading="{{busy && !returnRefresh}}">刷新审核结果</button></view>
<navigator wx:if="{{mode==='onboarding' && application.id}}" url="/pages/service/index?type=factory_onboarding&id={{application.id}}">咨询入驻申请 ›</navigator>
