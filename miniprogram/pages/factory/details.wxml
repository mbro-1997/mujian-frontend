<template name="factory-details"><view class="card" wx:if="{{fields}}"><view class="section-title">{{fields.factoryName}}</view><view class="row">信用代码：{{fields.unifiedSocialCreditCode}}</view><view class="row">联系人：{{fields.contactName}}</view><view class="row">联系电话：{{fields.contactPhone}}</view><view class="row">地址：{{fields.factoryAddress}}</view><view class="row">主营业务：{{fields.mainBusiness || '未填写'}}</view><view class="row">工人数：{{fields.workerCount}}</view><view class="row">擅长品类：<text wx:for="{{fields.specialtyCategoryNames}}" wx:key="*this">{{item}} </text></view><view class="row">备注：{{fields.remark || '未填写'}}</view><button data-locator="{{fields.factoryAvatar}}" bindtap="preview">查看工厂头像</button><button data-locator="{{fields.businessLicense}}" bindtap="preview">查看营业执照</button><button wx:for="{{fields.factoryPhotos}}" wx:key="index" data-locator="{{item}}" bindtap="preview">查看实景照片 {{index+1}}</button><view class="case" wx:for="{{fields.cases}}" wx:key="index" wx:for-item="entry"><view class="label">{{entry.title}}</view><view>{{entry.description}}</view><button wx:for="{{entry.images}}" wx:key="index" data-locator="{{item}}" bindtap="preview">查看案例图 {{index+1}}</button></view></view></template>