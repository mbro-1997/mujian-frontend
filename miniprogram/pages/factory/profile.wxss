page,.profile-body { background:var(--mj-canvas); color:var(--mj-ink); }
.profile-body { padding:0 var(--mj-edge) calc(28px + env(safe-area-inset-bottom)); }
.profile-body .factory-profile-head { min-height:96px; background:transparent; border:0; padding:16px 0; }
.profile-body .factory-logo { background:var(--mj-active-bg); color:var(--mj-active-ink); border-radius:12px; }
.profile-body .profile-list { margin:0 0 12px; padding:0 14px; background:var(--mj-paper); border:1px solid var(--mj-line); border-radius:var(--mj-card); }
.profile-body .profile-actions { padding:0; }
.profile-body .profile-primary,.profile-body .profile-secondary { min-height:var(--mj-tap); border-radius:var(--mj-control); }
.profile-body .profile-primary:not([disabled]) { background:var(--mj-accent); color:var(--mj-ink); }
