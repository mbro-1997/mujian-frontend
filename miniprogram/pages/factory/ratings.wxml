<view class="trade"><view class="toolbar"><button class="{{direction==='received'?'selected':''}}" data-direction="received" bindtap="filter">收到的评价</button><button class="{{direction==='given'?'selected':''}}" data-direction="given" bindtap="filter">给出的评价</button></view>
<view wx:if="{{message}}" class="feedback">{{message}}<button bindtap="load">重试</button></view><view wx:elif="{{busy && !items.length}}">正在读取评价…</view><view wx:elif="{{!items.length}}">暂无评价</view>
<navigator class="section" wx:for="{{items}}" wx:key="id" url="/pages/reviews/detail?id={{item.id}}">{{item.businessType==='custom_order'?'定制':'租赁'}} · {{item.rating}} 星<view wx:if="{{item.content}}">{{item.content}}</view></navigator></view>
