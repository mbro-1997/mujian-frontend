<view class="trade"><list-filters resettable="{{direction !== 'received'}}" bindresetfilters="resetFilters" quiet="{{returnRefresh}}" filters="{{filterGroups}}" values="{{ {direction:direction} }}" disabled="{{busy}}" bindselectfilter="filter"/>
<view wx:if="{{message}}" class="feedback">{{message}}<button bindtap="load">重试</button></view><view class="blank" wx:elif="{{busy && !returnRefresh && !items.length}}"><mj-loading label="正在读取评价"/></view><view class="blank" wx:elif="{{!items.length}}">暂无评价</view>
<navigator class="section" wx:for="{{items}}" wx:key="id" url="/pages/reviews/detail?id={{item.id}}">{{item.businessType==='custom_order'?'定制':'租赁'}} · {{item.rating}} 星<view wx:if="{{item.content}}">{{item.content}}</view></navigator></view>
