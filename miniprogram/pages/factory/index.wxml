<view class="factory-page" bindtouchstart="activity">
  <view class="card">
    <mj-heading title="工厂服务" subtitle="{{context ? identity : ''}}"/>
    <mj-loading wx:if="{{busy && !returnRefresh}}" label="正在读取账号状态"/>
    <view wx:elif="{{message}}" class="feedback">{{message}}</view>
    <view wx:else class="muted">{{restricted ? '账号使用受限，请查看账号状态。' : '请使用已入驻的工厂账号进入工作台。'}}</view>
    <button class="primary" bindtap="goAccount" disabled="{{busy}}">{{context ? '账号管理' : '登录 / 选择身份'}}</button>
    <button wx:if="{{context}}" bindtap="logout" disabled="{{busy}}">退出登录</button>
    <button wx:if="{{message}}" bindtap="load" disabled="{{busy}}">重新读取</button>
  </view>
  <button bindtap="back">返回我的</button>
</view>
