<view class="profile-body" bindtouchstart="activity"><view wx:if="{{busy&&!fields}}" class="profile-state">正在加载工厂资料</view><view wx:if="{{message}}" class="feedback">{{message}}<button bindtap="load" loading="{{busy}}">重试</button></view><block wx:if="{{fields}}"><view class="factory-profile-head"><view class="factory-logo" data-locator="{{fields.factoryAvatar}}" bindtap="preview">厂</view><view class="factory-profile-info"><view class="factory-profile-name">{{fields.factoryName}}</view><view class="factory-profile-meta">统一代码：{{creditSummary}}<view>地址：{{fields.factoryAddress}}</view></view></view></view><view wx:if="{{profile.factoryStatus==='disabled'||profile.factoryStatus === 'suspended'}}" class="feedback">工厂经营能力{{profile.factoryStatus === 'suspended'?'已暂停':'已停用'}}。账号正常时仍可修改资料；审核通过不会自动恢复经营。</view>
<view class="profile-list"><view class="profile-row"><text>工厂名称</text><text class="profile-value">{{fields.factoryName}}</text></view><view class="profile-row actionable" data-locator="{{fields.businessLicense}}" bindtap="preview"><text>营业执照</text><text class="profile-value">已上传</text><text class="profile-chevron">›</text></view><view class="profile-row actionable" bindtap="photos"><text>厂房照片</text><text class="profile-value">{{fields.factoryPhotos.length}} 张</text><text class="profile-chevron">›</text></view><view class="profile-row"><text>工人数量</text><text class="profile-value">{{fields.workerCount}} 人</text></view><view class="profile-row"><text>主营类型</text><text class="profile-value">{{fields.mainBusiness||'未填写'}}</text></view></view>
<view class="profile-list"><view class="profile-row"><text>联系人</text><text class="profile-value emphasized">{{fields.contactName}}</text></view><view class="profile-row actionable" bindtap="phone"><text>联系电话</text><text class="profile-value emphasized">{{fields.contactPhone}}</text><text class="profile-chevron">›</text></view><view class="profile-row actionable" bindtap="toggleCases"><text>服务案例</text><text class="profile-value">{{caseSummary}}</text><text class="profile-chevron">{{casesOpen?'⌄':'›'}}</text></view><view wx:if="{{casesOpen}}" class="profile-cases"><view wx:if="{{!fields.cases.length}}" class="factory-profile-meta">暂无服务案例</view><view class="profile-case" wx:for="{{fields.cases}}" wx:key="index" wx:for-item="entry"><view class="profile-case-title">{{entry.title||'服务案例'}}</view><view class="factory-profile-meta">{{entry.description}}</view><button wx:for="{{entry.images}}" wx:key="index" data-locator="{{item}}" bindtap="preview">查看案例图片 {{index+1}}</button></view></view><view class="profile-row"><text>擅长品类</text><text class="profile-value">{{categorySummary}}</text></view><view wx:if="{{fields.remark}}" class="profile-row"><text>备注</text><text class="profile-value">{{fields.remark}}</text></view></view>
<view class="profile-actions"><button class="profile-primary" bindtap="edit" disabled="{{!profile.canEdit}}">编辑资料并提交审核</button><button class="profile-secondary" bindtap="status">查看资料申请状态</button><view class="profile-version">资料版本 {{profile.profileVersion}}<text bindtap="load">刷新资料</text></view></view></block></view>