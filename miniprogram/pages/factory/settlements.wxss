page{background:#f5f5f5;color:#111827}
.screen{padding:12px 12px calc(96px + env(safe-area-inset-bottom));min-height:100vh;box-sizing:border-box;font-size:14px;line-height:1.5}
.hero,.panel{border:1px solid #eee;border-radius:8px;padding:12px;margin-bottom:12px;background:#fff}
.hero .title{font-size:17px;font-weight:900;margin:0 0 10px}
.caption,.muted{font-size:12px;color:#6b7280}.title{font-size:26px;font-weight:900;margin:8px 0}
.heading,.strong,.price{font-weight:900}.heading{font-size:16px;margin-bottom:10px}.heading text{float:right;font-size:11px;color:#6b7280;font-weight:500}
.row{display:flex;gap:10px;justify-content:space-between;align-items:baseline;padding:9px 0}
.row>text{min-width:0;overflow-wrap:anywhere}.row>text:last-child{text-align:right}
.amounts>view{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-top:1px solid #eee;color:#6b7280;font-size:13px}
.amounts>view:first-child{border:0}.amounts text{font-weight:900;color:#111827;overflow-wrap:anywhere}
.entry{border:1px solid #e5e7eb;border-radius:8px;padding:12px;margin-top:8px;line-height:1.6}.entry .row{padding:0 0 4px}
.price{white-space:nowrap}.number{overflow-wrap:anywhere;min-width:0}
.empty{text-align:center;padding:30px 12px;color:#6b7280}.screen button{font-size:14px;min-height:42px}
.screen .settlement-rules{position:fixed;bottom:calc(16px + env(safe-area-inset-bottom));left:16px;right:16px;width:auto;height:42px;padding:0;border-radius:22px;line-height:42px;font-weight:900;color:#6b7280;background:#f5f5f5}
