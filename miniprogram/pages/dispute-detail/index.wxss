page {
  background: #070b16;
}

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 180rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 16% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    #070b16;
}

.card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  color: #f8fafc;
  box-sizing: border-box;
}

.hero {
  background: rgba(15, 23, 42, 0.92);
}

.hero-head,
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 800;
}

.sub {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.status,
.result-type {
  height: 42rpx;
  line-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.status.pending {
  background: rgba(251, 191, 36, 0.14);
  color: #fbbf24;
}

.status.resolved,
.result-type.approved {
  background: rgba(52, 211, 153, 0.14);
  color: #34d399;
}

.status.closed,
.result-type.rejected {
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
}

.section-title {
  margin-bottom: 12rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.12);
  color: #94a3b8;
  font-size: 24rpx;
}

.row text:last-child {
  color: #e2e8f0;
  text-align: right;
}

.money {
  color: #67e8f9 !important;
  font-weight: 800;
}

.content {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.56);
  color: #e2e8f0;
  font-size: 25rpx;
  line-height: 1.6;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.evidence-img {
  width: 190rpx;
  height: 190rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.72);
}

.empty-inline {
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 24rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(15, 23, 42, 0.94);
  border-top: 1rpx solid rgba(148, 163, 184, 0.16);
}

.bottom-btn {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 800;
}

.bottom-btn.primary {
  background: #22d3ee;
  color: #03111a;
}

.bottom-btn.secondary {
  background: rgba(30, 41, 59, 0.92);
  color: #94a3b8;
}
