<view class="credit-page">
  <view class="score-card">
    <view>
      <view class="score-label">当前信用分</view>
      <view class="score-desc">用于展示工厂履约、评价与纠纷处理记录</view>
    </view>
    <view class="score-value">{{creditScore}}</view>
  </view>

  <view class="section-title">信用分变动</view>

  <view class="log-list" wx:if="{{logs.length}}">
    <view class="log-card" wx:for="{{logs}}" wx:key="id">
      <view class="log-top">
        <view>
          <view class="log-title">{{item.reason}}</view>
          <view class="log-type">{{item.changeTypeText}}</view>
        </view>
        <view class="delta {{item.deltaClass}}">{{item.deltaText}}</view>
      </view>
      <view class="log-meta">
        <text>变动前 {{item.beforeScore}}</text>
        <text>变动后 {{item.afterScore}}</text>
      </view>
      <view class="log-time">{{item.createdAt}}</view>
    </view>
  </view>

  <view class="empty-card" wx:elif="{{!loading}}">
    <view class="empty-title">暂无信用分变动</view>
    <view class="empty-desc">后续订单履约、评价、纠纷处理会在这里记录。</view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
