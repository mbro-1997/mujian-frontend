@import "../../styles/trading.wxss";
.service-list .row{margin:0}.service-list .heading{font-size:16px}
.service-list .service-item{display:block;box-sizing:border-box;width:100%;min-width:0;margin:0;padding:14px 0;border:0;border-bottom:1px solid #eee;border-radius:0;background:#fff;text-align:left;white-space:normal;overflow-wrap:anywhere;line-height:1.5}
.service-list .service-item:last-child{border-bottom:0}.service-list .service-item .item-title{font-size:14px;font-weight:900}
.trade .service-direct{width:100%;background:#fff;text-align:left;padding:12px 0;border-top:1px solid #eee;border-radius:0;font-size:13px}
