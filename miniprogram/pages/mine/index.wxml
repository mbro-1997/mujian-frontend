<view class="container mine-page" style="padding: 16rpx 16rpx 140rpx;">
  <view class="card profile-card">
    <view class="profile-top">
      <image src="{{user.avatar || user.avatarUrl}}" class="avatar" />
      <view class="user-details">
        <view class="user-name">{{user.name || user.nickname}}</view>
        <view class="user-role">{{user.role}} · {{user.certification}}</view>
        <view class="user-role">{{user.accountName}}</view>
      </view>
    </view>
    <view class="credit-wrap" wx:if="{{!isAdmin}}">
      <view class="credit-label">信用分</view>
      <view class="credit-score">{{user.credit}}</view>
    </view>
  </view>

  <block wx:if="{{isAdmin}}">
    <view class="card section-card">
      <view class="menu-item" bindtap="viewCreditLogs">
        <text>我的信用分</text>
        <text class="arrow">></text>
      </view>
    </view>

    <view class="card section-card">
      <view class="section-title">管理快捷入口</view>
      <view class="admin-action-row">
        <button class="admin-action-btn" bindtap="goAdminOrders">订单</button>
        <button class="admin-action-btn" bindtap="goAdminWarehouse">仓库</button>
        <button class="admin-action-btn" bindtap="goAdminPublish">发布</button>
      </view>
    </view>

    <view class="card section-card">
      <view class="section-title">码池管理</view>
      <view class="admin-action-row">
        <button class="admin-action-btn qr-btn" bindtap="goAdminQrPool">二维码</button>
        <button class="admin-action-btn invite-btn" bindtap="goAdminInvitePool">邀请码</button>
      </view>
    </view>

    <view class="card section-card">
      <view class="menu-item logout" bindtap="logout">
        <text>退出登录</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="card section-card">
      <view class="menu-item" bindtap="viewOrders" wx:if="{{isDemander}}">
        <text>我的订单</text>
        <text class="arrow">></text>
      </view>

      <view class="menu-item" bindtap="viewCreditLogs">
        <text>我的信用分</text>
        <text class="arrow">></text>
      </view>

      <view class="menu-item" bindtap="viewProjects" wx:if="{{isDemander}}">
        <text>我的方案</text>
        <text class="arrow">></text>
      </view>

      <view class="menu-item" bindtap="viewCertification" wx:if="{{isDemander}}">
        <text>实名认证</text>
        <text class="arrow">></text>
      </view>

      <view class="menu-item" bindtap="viewStudentCertification" wx:if="{{isDemander}}">
        <text>学生认证</text>
        <text class="arrow">></text>
      </view>

      <view class="menu-item" bindtap="viewSettings">
        <text>设置</text>
        <text class="arrow">></text>
      </view>
    </view>

    <view class="card section-card">
      <view class="menu-item logout" bindtap="logout">
        <text>退出登录</text>
      </view>
    </view>
  </block>
</view>
