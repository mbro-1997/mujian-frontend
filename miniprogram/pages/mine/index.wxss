@import "../../navigation/root.wxss";

.mine-page { padding-bottom: calc(90px + env(safe-area-inset-bottom)); }
.mine-page .with-tabs, .mine-page .factory-root { padding-bottom: 0; }

/* 原型身份区含顶部留白，微信居中导航已占其中 44px。 */
.mine-page .mine-hero { min-height:130px; padding:10px 18px 16px; }
.mine-page .mine-description { line-height:1.45; font-weight:700; }
.mine-page .mine-tool { line-height:1.2; }
.mine-page .with-tabs { background:var(--mj-canvas); color:var(--mj-ink); padding:16px var(--mj-edge); }
.mine-page .with-tabs .mine-hero { min-height:80px; padding:0 0 12px; grid-template-columns:54px minmax(0,1fr); background:transparent; }
.with-tabs .mine-avatar { width:54px; height:54px; border:0; box-shadow:none; border-radius:15px; color:var(--mj-active-ink); background:var(--mj-active-bg); }
.with-tabs .mine-section { margin:10px 0 0; border:1px solid var(--mj-line); border-radius:var(--mj-card); }
.mine-page .mine-grid { padding:10px 6px 14px; gap:10px 4px; }
.mine-page .mine-tool { min-width:0; min-height:48px; font-weight:550; }
.mine-page .tool-icon { border-radius:10px; color:var(--mj-active-ink); background-color:var(--mj-soft); background-position:center; background-size:22px; background-repeat:no-repeat; }
.with-tabs .section-title,.with-tabs .mine-row { font-weight:650; }
.with-tabs .action-row { margin:16px 0 0; }
.with-tabs .action-row button { min-height:44px; border-radius:var(--mj-control); }

