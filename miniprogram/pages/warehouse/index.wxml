<view class="container" style="padding-bottom: 120rpx;">
  <block wx:if="{{showAuditCenter}}">
    <view class="admin-header">
      <view class="admin-title">审核中心</view>
      <view class="admin-desc">这里仅展示最新 5 条待处理记录，点击查看更多后进入完整审核列表。</view>
    </view>

    <view class="audit-card">
      <view class="audit-head">
        <view class="audit-title">入驻审核</view>
      </view>
      <scroll-view wx:if="{{factoryAudits.length}}" scroll-y class="audit-scroll">
        <view class="audit-item" wx:for="{{factoryAudits}}" wx:key="id">
          <view class="audit-item-head">
            <view class="audit-item-title">{{item.company}}</view>
            <view class="status-tag {{item.status === 'pending' ? 'status-pending' : item.status === 'approved' ? 'status-free' : 'status-renting'}}">{{item.statusText}}</view>
          </view>
          <view class="audit-item-meta">联系人：{{item.contact}}</view>
          <view class="audit-item-meta">联系方式：{{item.phone || '未填写'}}</view>
          <view class="audit-item-meta">申请时间：{{item.createdAt}}</view>
        </view>
      </scroll-view>
      <view wx:else class="empty-panel">暂无入驻审核数据</view>
      <button class="more-btn" bindtap="goFactoryAuditMore">查看更多</button>
    </view>

    <view class="audit-card">
      <view class="audit-head">
        <view class="audit-title">道具审核</view>
      </view>
      <scroll-view wx:if="{{propAudits.length}}" scroll-y class="audit-scroll">
        <view class="audit-item" wx:for="{{propAudits}}" wx:key="id">
          <view class="audit-item-head">
            <view class="audit-item-title">{{item.propName}}</view>
            <view class="status-tag {{item.status === 'pending' ? 'status-pending' : item.status === 'approved' ? 'status-free' : 'status-renting'}}">{{item.statusText}}</view>
          </view>
          <view class="audit-item-meta">提交人：{{item.supplierName || '未知工厂账号'}}</view>
          <view class="audit-item-meta">申请备注：{{item.remark || '无'}}</view>
          <view class="audit-item-meta">申请时间：{{item.createdAt}}</view>
        </view>
      </scroll-view>
      <view wx:else class="empty-panel">暂无道具审核数据</view>
      <button class="more-btn" bindtap="goPropAuditMore">查看更多</button>
    </view>
  </block>

  <block wx:else>

    <view class="warehouse-top-panel">
      <view class="search-box">
        <text class="search-icon">⌕</text>
        <input
          class="search-input"
          placeholder="搜索道具名称 / ID / 风格 / 类型"
          placeholder-class="search-placeholder"
          value="{{keyword}}"
          bindinput="handleKeywordInput"
          confirm-type="search"
          bindconfirm="submitSearch"
        />
        <text wx:if="{{keyword}}" class="clear-search" bindtap="clearSearch">×</text>
      </view>

      <scroll-view scroll-x class="status-tabs" show-scrollbar="{{false}}">
        <view
          wx:for="{{statusTabs}}"
          wx:key="value"
          class="status-tab {{activeStatus === item.value ? 'active' : ''}}"
          data-status="{{item.value}}"
          bindtap="changeStatus"
        >{{item.label}}</view>
      </scroll-view>

      <view class="filter-bar">
        <picker mode="selector" range="{{styleOptions}}" value="{{styleIndex}}" bindchange="changeStyle">
          <view class="filter-chip">{{styleOptions[styleIndex]}}</view>
        </picker>
        <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="changeType">
          <view class="filter-chip">{{typeOptions[typeIndex]}}</view>
        </picker>
        <view class="filter-chip ghost" bindtap="resetFilters">重置</view>
      </view>
    </view>
    <view class="warehouse-panel">
      <view class="card-title">我的仓库</view>
      <view class="list">
        <view class="list-item" wx:for="{{warehouseProps}}" wx:key="id" bindtap="viewPropDetail" data-id="{{item.id}}">
          <image src="{{item.image}}" class="img warehouse-img" mode="aspectFill" />
          <view class="prop-info">
            <view class="prop-name">{{item.name}}</view>
            <view class="prop-meta"><text>尺寸: {{item.size}}</text><text>材质: {{item.material}}</text></view>
            <view class="prop-price"><text class="price">¥{{item.price}}/天</text><text class="deposit">押金: ¥{{item.deposit}}</text></view>
            <view class="stock-grid">
              <view class="stock-chip"><text>总库存</text><strong>{{item.totalStock || 0}}</strong></view>
              <view class="stock-chip available"><text>可租</text><strong>{{item.availableStock || 0}}</strong></view>
              <view class="stock-chip locked"><text>锁定</text><strong>{{item.lockedStock || 0}}</strong></view>
              <view class="stock-chip rented"><text>租赁中</text><strong>{{item.rentedStock || 0}}</strong></view>
              <view class="stock-chip"><text>资产</text><strong>{{item.assetTotalStock || 0}}</strong></view>
              <view class="stock-chip"><text>维修</text><strong>{{item.repairingStock || 0}}</strong></view>
              <view class="stock-chip"><text>丢失</text><strong>{{item.lostStock || 0}}</strong></view>
              <view class="stock-chip"><text>报废</text><strong>{{item.scrappedStock || 0}}</strong></view>
            </view>
            <view class="prop-status-row">
              <view class="status-tag {{item.statusClass}}">{{item.statusText}}</view>
              <view class="prop-action-wrap">
                <button wx:if="{{item.canToggle}}" class="btn {{item.status === 'offline' ? 'btn-primary' : 'btn-secondary'}} prop-action-btn" size="mini" catchtap="toggleStatus" data-id="{{item.id}}">{{item.actionText}}</button>
                <button wx:else class="btn btn-disabled prop-action-btn" size="mini" disabled>{{item.actionDisabledText}}</button>
                <button class="btn btn-secondary prop-action-btn" size="mini" catchtap="goManageInstances" data-id="{{item.id}}">管理实物</button>
              </view>
            </view>
          </view>
        </view>
        <view class="empty-panel warehouse-empty" wx:if="{{!warehouseProps.length}}">暂无符合条件的道具</view>
      </view>
    </view>

  </block>
</view>
