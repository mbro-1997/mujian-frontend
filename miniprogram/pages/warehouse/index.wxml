<view class="container" style="padding-bottom: 120rpx;">
  <block wx:if="{{showAuditCenter}}">
    <view class="admin-header">
      <view class="admin-title">审核中心</view>
      <view class="admin-desc">这里仅展示最新 5 条待处理记录，点击查看更多后进入完整审核列表。</view>
    </view>

    <view class="audit-card">
      <view class="audit-head">
        <view class="audit-title">入驻审核</view>
      </view>
      <scroll-view wx:if="{{factoryAudits.length}}" scroll-y class="audit-scroll">
        <view class="audit-item" wx:for="{{factoryAudits}}" wx:key="id">
          <view class="audit-item-head">
            <view class="audit-item-title">{{item.company}}</view>
            <view class="status-tag {{item.status === 'pending' ? 'status-pending' : item.status === 'approved' ? 'status-free' : 'status-renting'}}">{{item.statusText}}</view>
          </view>
          <view class="audit-item-meta">联系人：{{item.contact}}</view>
          <view class="audit-item-meta">联系方式：{{item.phone || '未填写'}}</view>
          <view class="audit-item-meta">申请时间：{{item.createdAt}}</view>
        </view>
      </scroll-view>
      <view wx:else class="empty-panel">暂无入驻审核数据</view>
      <button class="more-btn" bindtap="goFactoryAuditMore">查看更多</button>
    </view>

    <view class="audit-card">
      <view class="audit-head">
        <view class="audit-title">道具审核</view>
      </view>
      <scroll-view wx:if="{{propAudits.length}}" scroll-y class="audit-scroll">
        <view class="audit-item" wx:for="{{propAudits}}" wx:key="id">
          <view class="audit-item-head">
            <view class="audit-item-title">{{item.propName}}</view>
            <view class="status-tag {{item.status === 'pending' ? 'status-pending' : item.status === 'approved' ? 'status-free' : 'status-renting'}}">{{item.statusText}}</view>
          </view>
          <view class="audit-item-meta">提交人：{{item.supplierName || '未知工厂账号'}}</view>
          <view class="audit-item-meta">申请备注：{{item.remark || '无'}}</view>
          <view class="audit-item-meta">申请时间：{{item.createdAt}}</view>
        </view>
      </scroll-view>
      <view wx:else class="empty-panel">暂无道具审核数据</view>
      <button class="more-btn" bindtap="goPropAuditMore">查看更多</button>
    </view>
  </block>

  <block wx:else>
    <view class="scan-panel">
      <view class="scan-buttons">
        <view class="scan-button" bindtap="scanBorrow">
          <image src="/images/icons/goods.png" class="scan-icon" />
          <text class="scan-text">借出扫码</text>
        </view>
        <view class="scan-button" bindtap="scanReturn">
          <image src="/images/icons/goods-active.png" class="scan-icon" />
          <text class="scan-text">归还扫码</text>
        </view>
      </view>
    </view>

    <view class="warehouse-panel">
      <view class="card-title">我的仓库</view>
      <view class="list">
        <view class="list-item" wx:for="{{warehouseProps}}" wx:key="id" bindtap="viewPropDetail" data-id="{{item.id}}">
          <image src="{{item.image}}" class="img warehouse-img" mode="aspectFill" />
          <view class="prop-info">
            <view class="prop-name">{{item.name}}</view>
            <view class="prop-meta"><text>尺寸: {{item.size}}</text><text>材质: {{item.material}}</text></view>
            <view class="prop-price"><text class="price">¥{{item.price}}/天</text><text class="deposit">押金: ¥{{item.deposit}}</text></view>
            <view class="prop-status-row">
              <view class="status-tag {{item.statusClass}}">{{item.statusText}}</view>
              <view class="prop-action-wrap">
                <button wx:if="{{item.canToggle}}" class="btn {{item.status === 'offline' ? 'btn-primary' : 'btn-secondary'}} prop-action-btn" size="mini" bindtap="toggleStatus" data-id="{{item.id}}">{{item.actionText}}</button>
                <button wx:else class="btn btn-disabled prop-action-btn" size="mini" disabled>{{item.actionDisabledText}}</button>
              </view>
            </view>
          </view>
        </view>
        <view class="empty-panel" wx:if="{{!warehouseProps.length}}">暂无道具</view>
      </view>
    </view>

    <view class="modal" wx:if="{{showScanModal}}" bindtap="closeScanModal">
      <view class="modal-content" catchtap="true">
        <view class="modal-title">{{scanType === 'borrow' ? '借出扫码' : '归还扫码'}}</view>
        <view style="text-align: center; margin: 24rpx 0; color: #cbd5e1;">模拟扫码演示</view>
        <view class="modal-buttons">
          <view class="modal-button secondary" bindtap="closeScanModal">取消</view>
          <view class="modal-button primary" bindtap="simulateScan">确认</view>
        </view>
      </view>
    </view>
  </block>
</view>
