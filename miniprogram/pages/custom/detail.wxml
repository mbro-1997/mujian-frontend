<view class="custom">
 <view class="notice" wx:if="{{message}}">{{message}}</view><button wx:if="{{message || !detail}}" bindtap="refresh" disabled="{{busy}}">重新加载</button>
 <block wx:if="{{detail}}">
 <view class="card"><view class="bar"><text class="title">{{detail.title || '定制购买订单'}}</text><text>{{detail.label}}</text></view>
 <view class="muted">{{detail.number}}</view><view wx:if="{{detail.latestReason}}">{{detail.latestReason}}</view>
 <view wx:if="{{detail.responseTime}}">工厂响应期限 {{detail.responseTime}}</view>
 <view wx:if="{{needsSupport}}"><text wx:if="{{overdueReview}}">已到响应期限，可联系平台协助。</text><button open-type="contact" session-from="{{detail.number}}">联系平台客服</button></view>
 <button wx:if="{{detail.orderId}}" bindtap="order">查看原购买订单</button></view>
 <view class="card" wx:if="{{detail.form}}"><view class="title">需求明细</view><view>{{detail.form.usageScene}} · {{detail.form.deliveryCity}} · {{detail.form.expectedCompletionDate}}</view><view>{{detail.form.remark}}</view><view wx:if="{{detail.form.budgetRangeFen}}">预算 {{detail.budgetText}}</view>
 <button wx:for="{{detail.form.attachments}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button>
 <view class="line" wx:for="{{detail.form.items}}" wx:key="id"><view>{{item.title}} × {{item.quantity}}</view><view>{{item.dimension}} · {{item.material}} · {{item.style}}</view><view>验收要求 {{item.acceptanceNotes}}</view><button wx:for="{{item.attachments}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button></view></view>
 <view class="card" wx:for="{{detail.quotes}}" wx:key="id"><navigator url="/pages/service/index?type=custom_quote&id={{item.id}}">咨询此报价 ›</navigator><view class="title">报价 V{{item.quoteVersion}} · {{item.label}}</view>
 <view wx:if="{{item.validUntilText}}">有效至 {{item.validUntilText}}</view><view class="line" wx:for="{{item.terms.items}}" wx:key="itemId"><view>{{item.title}}　¥{{item.price}} × {{item.quantity}}</view><view>{{item.dimension}} · {{item.material}} · {{item.style}}</view><view>验收标准 {{item.acceptanceStandard}}</view></view>
 <view>商品 ¥{{item.goods}}　运费 ¥{{item.freight}}　合计 ¥{{item.amount}}</view><view>{{item.terms.deliveryMode==='buyer_pickup'?'买家自提':'工厂配送'}} · 工期 {{item.terms.productionDays}} 天 · 承诺 {{item.terms.promisedDate}}</view>
 <view>修改约定 {{item.terms.revisionTerms}}</view><view>报价范围 {{item.terms.includedAndExcluded}}</view><view>售后约定 {{item.terms.afterSaleTerms}}</view><view wx:if="{{item.terms.remark}}">{{item.terms.remark}}</view></view>
 <view class="card" wx:if="{{kind==='orders'}}"><view class="title">付款与履约</view><view>{{detail.payLabel}} · {{detail.payment.paymentNo}}</view><view>实退 ¥{{detail.refundAmount}}</view><view>承诺交付日 {{detail.promisedDate}}</view><view wx:if="{{detail.addressSnapshot}}">配送至 {{detail.addressSnapshot}}</view><view wx:if="{{detail.productionTime}}">开工 {{detail.productionTime}}</view><view wx:if="{{detail.acceptanceTime}}">验收截止 {{detail.acceptanceTime}}</view><view wx:if="{{detail.remainingSeconds!==null && detail.acceptanceState==='paused'}}">暂停验收 · 剩余 {{detail.remainingSeconds}} 秒</view></view>
 <button wx:for="{{refunds}}" wx:key="id" data-id="{{item.id}}" bindtap="refund">{{item.label}} ¥{{item.amount}} · 查看退款进度</button>
 <view class="card" wx:for="{{detail.deliveries}}" wx:key="id"><view class="title">第 {{item.deliveryVersion}} 次交付 · {{item.label}}</view><view>{{item.deliveryTime}}</view><view>{{item.remark}}</view><button wx:for="{{item.evidence}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button></view>
 <view class="card" wx:for="{{detail.extensions}}" wx:key="id"><view class="title">延期 · {{item.label}}</view><view>{{item.originalDate}} → {{item.requestedDate}}</view><view>{{item.reason}} {{item.decisionNote}}</view><button wx:for="{{item.evidence}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button></view>
 <view class="card" wx:for="{{detail.afterSales}}" wx:key="id"><navigator url="/pages/service/index?type=custom_after_sale&id={{item.id}}">咨询此售后 ›</navigator><view class="title">售后 · {{item.label}}</view><view>{{item.problem}}</view><button wx:if="{{factory}}" data-id="{{item.id}}" bindtap="facts">工厂情况说明与凭证</button><view>{{item.resolutionNote}}</view><view>商品退款 ¥{{item.goods}}　运费退款 ¥{{item.freight}}</view><view wx:if="{{item.refundId}}">退款单 {{item.refundId}}</view><button wx:for="{{item.evidence}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button></view>
 <view class="card" wx:if="{{report}}"><view class="title">工厂情况说明</view><view class="line" wx:for="{{report.items}}" wx:key="id"><view>{{item.timeText}}　{{item.summary}}</view><button wx:for="{{item.evidence}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button></view><block wx:if="{{report.canSubmit}}"><textarea value="{{reportText}}" data-path="reportText" bindinput="edit" placeholder="说明生产、交付或返工事实"/><view wx:for="{{reportFiles}}" wx:key="materialId">{{item.name}}</view><button disabled="{{busy}}" bindtap="proof">添加工厂凭证</button><button disabled="{{busy || !reportText}}" bindtap="addStatement">提交说明</button></block></view>
 <button wx:for="{{buttons}}" wx:key="k" data-k="{{item.k}}" disabled="{{busy}}" bindtap="choose">{{item.label}}</button>
 <view class="card" wx:if="{{active}}"><view class="title">{{actionLabel}}</view>
 <block wx:if="{{active==='getCustomPayment'}}"><view>{{payment.payment.paymentNo}} · {{detail.payLabel}}</view><button wx:if="{{payment.parameters}}" bindtap="pay">继续原单付款</button></block>
 <block wx:else>
 <block wx:if="{{active==='saveCustomQuote'}}"><view wx:for="{{terms.items}}" wx:key="itemId" class="line">{{item.title}} × {{item.quantity}}
<label class="field">单价（元）<input type="digit" data-path="terms.items[{{index}}].unitPriceYuan" value="{{item.unitPriceYuan}}" bindinput="edit"/></label>
<label class="field">尺寸<input type="text" data-path="terms.items[{{index}}].dimension" value="{{item.dimension}}" bindinput="edit"/></label>
<label class="field">材质<input type="text" data-path="terms.items[{{index}}].material" value="{{item.material}}" bindinput="edit"/></label>
<label class="field">风格<input type="text" data-path="terms.items[{{index}}].style" value="{{item.style}}" bindinput="edit"/></label>
<label class="field">验收标准<input type="text" data-path="terms.items[{{index}}].acceptanceStandard" value="{{item.acceptanceStandard}}" bindinput="edit"/></label>
</view><label class="field">整单运费（元，自提为零）<input type="digit" data-path="terms.freightYuan" value="{{terms.freightYuan}}" bindinput="edit"/></label>
<label class="field">制作天数<input type="number" data-path="terms.productionDays" value="{{terms.productionDays}}" bindinput="edit"/></label>
<label class="field">修改约定<input type="text" data-path="terms.revisionTerms" value="{{terms.revisionTerms}}" bindinput="edit"/></label>
<label class="field">报价范围<input type="text" data-path="terms.includedAndExcluded" value="{{terms.includedAndExcluded}}" bindinput="edit"/></label>
<label class="field">售后约定<input type="text" data-path="terms.afterSaleTerms" value="{{terms.afterSaleTerms}}" bindinput="edit"/></label>
 <label class="field">承诺完成日<picker mode="date" value="{{terms.promisedDate}}" data-path="terms.promisedDate" bindchange="edit">{{terms.promisedDate || '选择日期'}}</picker></label></block>
 <button wx:if="{{active==='acceptCustomQuote' && detail.quotes[0].terms.deliveryMode==='factory_delivery'}}" bindtap="address">{{addressId?'已选择地址，点击更换':'选择收货地址'}}</button>
 <label wx:if="{{active==='requestQuoteRevision' || active==='declineCustomRequirement' || active==='saveCustomExtension' || active==='reportCustomAfterSale'}}" class="field">办理说明<textarea data-path="editor.reason" value="{{editor.reason}}" bindinput="edit"/></label>
 <label class="field" wx:if="{{active==='saveCustomExtension'}}">申请交付日<picker mode="date" value="{{editor.requestedDate}}" data-path="editor.requestedDate" bindchange="edit">{{editor.requestedDate || '选择日期'}}</picker></label>
 <block wx:if="{{active==='reportCustomAfterSale'}}"><picker range="{{typeNames}}" value="{{typeIndex}}" data-key="type" bindchange="select">问题类型 · {{typeNames[typeIndex || 0]}}</picker><picker range="{{solutionNames}}" value="{{requestedSolutionIndex}}" data-key="requestedSolution" bindchange="select">期望处理 · {{solutionNames[requestedSolutionIndex || 0]}}</picker></block>
 <block wx:if="{{active==='deliverCustomOrder' || active==='registerCustomPickup'}}"><view>逐项核对本次交接</view><checkbox-group data-path="editor.checked" bindchange="edit"><label class="field" wx:for="{{detail.items}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{marked[item.id]}}"/>{{item.title}} × {{item.quantity}} · {{item.acceptanceStandard}}</label></checkbox-group><button size="mini" bindtap="occurredNow">使用当前交接时间</button><picker mode="date" value="{{editor.date}}" data-k="date" bindchange="occurred">{{editor.date || '实际交接日期'}}</picker><picker mode="time" value="{{editor.time}}" data-k="time" bindchange="occurred">{{editor.time || '实际交接时间'}}</picker><textarea data-path="editor.remark" value="{{editor.remark}}" bindinput="edit" placeholder="交付说明"/></block>
 <block wx:if="{{active==='deliverCustomOrder' || active==='registerCustomPickup' || active==='saveCustomExtension' || active==='reportCustomAfterSale'}}"><view wx:for="{{editor.files}}" wx:key="materialId">{{item.name}}</view><button bindtap="attach" disabled="{{busy}}">添加办理凭证</button></block>
 <button class="primary" bindtap="confirm" disabled="{{busy}}">确认{{actionLabel}}</button></block></view></block></view>

<navigator wx:if="{{kind==='orders' && detail.state==='completed'}}" url="/pages/reviews/detail?type=custom_order&id={{id}}">订单评价 ›</navigator>

<navigator wx:if="{{detail}}" url="/pages/service/index?type={{kind==='orders'?'custom_order':'custom_requirement'}}&id={{id}}">咨询平台客服 ›</navigator>
