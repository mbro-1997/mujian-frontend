<view class="custom">
  <view wx:if="{{busy && !detail && !message}}" class="mj-read-state"><mj-loading label="正在读取定制记录"/></view>
 <view class="notice" wx:if="{{message}}">{{message}}</view><button wx:if="{{message || (!busy && !detail)}}" bindtap="refresh" disabled="{{busy}}">重新加载</button>
 <block wx:if="{{detail}}">
 <view class="card"><view class="bar"><text class="title">{{detail.title || '定制购买订单'}}</text><text>{{detail.label}}</text></view>
 <view class="muted">{{detail.number}}</view><view wx:if="{{detail.latestReason}}">{{detail.latestReason}}</view>
 <view wx:if="{{detail.responseTime}}" class="line"><text>工厂响应期限</text>　{{detail.responseTime}}</view>
 <view wx:if="{{needsSupport}}"><text wx:if="{{overdueReview}}">已到响应期限，可联系平台协助。</text><button open-type="contact" session-from="{{detail.number}}">联系平台客服</button></view>
 <button wx:if="{{detail.orderId}}" bindtap="order">查看原购买订单</button></view>
 <view class="card" wx:if="{{detail.form}}"><view class="title">需求明细</view><view wx:if="{{detail.form.usageScene}}" class="line">使用场景　{{detail.form.usageScene}}</view>
 <view wx:if="{{detail.form.deliveryCity}}" class="line">交付城市　{{detail.form.deliveryCity}}</view><view wx:if="{{detail.form.expectedCompletionDate}}" class="line">期望完成　{{detail.form.expectedCompletionDate}}</view><view wx:if="{{detail.form.remark}}" class="muted">{{detail.form.remark}}</view><view wx:if="{{detail.form.budgetRangeFen}}">预算 {{detail.budgetText}}</view>
 <button wx:for="{{detail.form.attachments}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button>
 <view class="line" wx:for="{{detail.form.items}}" wx:key="id"><view>{{item.title}} × {{item.quantity}}</view><view>{{item.dimension}} · {{item.material}} · {{item.style}}</view><view>验收要求 {{item.acceptanceNotes}}</view><button wx:for="{{item.attachments}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button></view></view>
 <view class="card" wx:for="{{detail.quotes}}" wx:key="id"><view class="title">报价 V{{item.quoteVersion}} · {{item.label}}</view><navigator class="quote-support" url="/pages/service/index?type=custom_quote&id={{item.id}}">咨询此报价 ›</navigator>
 <view wx:if="{{item.validUntilText}}">有效至 {{item.validUntilText}}</view><view class="line" wx:for="{{item.terms.items}}" wx:key="itemId"><view>{{item.title}}　¥{{item.price}} × {{item.quantity}}</view><view>{{item.dimension}} · {{item.material}} · {{item.style}}</view><view>验收标准 {{item.acceptanceStandard}}</view></view>
 <view>商品 ¥{{item.goods}}　运费 ¥{{item.freight}}　合计 ¥{{item.amount}}</view><view>{{item.terms.deliveryMode==='buyer_pickup'?'买家自提':'工厂配送'}} · 工期 {{item.terms.productionDays}} 天 · 承诺 {{item.terms.promisedDate}}</view>
 <view>修改约定 {{item.terms.revisionTerms}}</view><view>报价范围 {{item.terms.includedAndExcluded}}</view><view>售后约定 {{item.terms.afterSaleTerms}}</view><view wx:if="{{item.terms.remark}}">{{item.terms.remark}}</view></view>
 <view class="card" wx:if="{{kind==='orders'}}"><view class="title">付款与履约</view><view>{{detail.payLabel}} · {{detail.payment.paymentNo}}</view><view>实退 ¥{{detail.refundAmount}}</view><view>承诺交付日 {{detail.promisedDate}}</view><view wx:if="{{detail.addressSnapshot}}">配送至 {{detail.addressSnapshot}}</view><view wx:if="{{detail.productionTime}}">开工 {{detail.productionTime}}</view><view wx:if="{{detail.pickupPending}}">待买家确认自提</view><view wx:if="{{!detail.pickupPending && detail.acceptanceTime}}">验收截止 {{detail.acceptanceTime}}</view><view wx:if="{{detail.remainingSeconds!==null && detail.acceptanceState==='paused'}}">暂停验收 · 剩余 {{detail.remainingSeconds}} 秒</view></view>
 <button wx:for="{{refunds}}" wx:key="id" data-id="{{item.id}}" bindtap="refund">{{item.label}} ¥{{item.amount}} · 查看退款进度</button>
 <view class="card" wx:for="{{detail.deliveries}}" wx:key="id"><view class="title">第 {{item.deliveryVersion}} 次交付 · {{item.label}}</view><view>{{item.deliveryTime}}</view><view>{{item.remark}}</view><button wx:for="{{item.evidence}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button></view>
 <view class="card" wx:for="{{detail.extensions}}" wx:key="id"><view class="title">延期 · {{item.label}}</view><view>{{item.originalDate}} → {{item.requestedDate}}</view><view>{{item.reason}} {{item.decisionNote}}</view><button wx:for="{{item.evidence}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button></view>
 <view class="card" wx:for="{{detail.afterSales}}" wx:key="id"><navigator url="/pages/service/index?type=custom_after_sale&id={{item.id}}">咨询此售后 ›</navigator><view class="title">售后 · {{item.label}}</view><view>{{item.problem}}</view><button wx:if="{{factory}}" data-id="{{item.id}}" bindtap="facts">工厂情况说明与凭证</button><view>{{item.resolutionNote}}</view><view>商品退款 ¥{{item.goods}}　运费退款 ¥{{item.freight}}</view><view wx:if="{{item.refundId}}">退款单 {{item.refundId}}</view><button wx:for="{{item.evidence}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button></view>
 <view class="card" wx:if="{{report}}"><view class="title">工厂情况说明</view><view class="line" wx:for="{{report.items}}" wx:key="id"><view>{{item.timeText}}　{{item.summary}}</view><button wx:for="{{item.evidence}}" wx:key="materialId" class="material-preview" data-file="{{item}}" bindtap="preview"><private-material file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/>{{item.name}}</button></view><block wx:if="{{report.canSubmit}}"><textarea id="field-report-text" adjust-position="{{false}}" maxlength="1000" value="{{reportText}}" data-path="reportText" bindinput="edit" placeholder="说明生产、交付或返工事实"/><view wx:for="{{reportFiles}}" wx:key="materialId" class="mj-photo-frame"><private-material wx:if="{{item.type==='image'}}" file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/><text class="mj-attachment-name">{{item.name}}</text><photo-remove identity="{{item.materialId}}" label="{{item.type==='image'?'移除图片':'移除附件'}}" data-group="report" data-id="{{item.materialId}}" disabled="{{busy}}" bindremove="removeDraftFile"/></view><button disabled="{{busy}}" bindtap="proof">添加工厂凭证</button><button disabled="{{busy || !reportText}}" bindtap="addStatement">提交说明</button></block></view>
 <button wx:for="{{buttons}}" wx:key="k" data-k="{{item.k}}" disabled="{{busy}}" bindtap="choose">{{item.label}}</button>
 <mj-action-sheet wx:if="{{active}}" title="{{actionLabel}}" busy="{{busy}}" binddismiss="closeEditor">
 <view wx:if="{{active==='withdrawCustomRequirement'}}" class="line">确认撤回「{{detail.title}}」？撤回后工厂将停止处理这条需求。</view>
 <block wx:if="{{active==='getCustomPayment'}}"><view>{{payment.payment.paymentNo}} · {{detail.payLabel}}</view><button wx:if="{{payment.parameters}}" bindtap="pay">继续原单付款</button></block>
 <block wx:else>
 <block wx:if="{{active==='saveCustomQuote'}}"><view wx:for="{{terms.items}}" wx:key="itemId" class="line">{{item.title}} × {{item.quantity}}
<label class="field">单价（元）<input id="field-row-{{index}}-unitPriceYuan" adjust-position="{{false}}" always-embed type="digit" data-path="terms.items[{{index}}].unitPriceYuan" value="{{item.unitPriceYuan}}" bindinput="edit"/></label>
<label class="field">尺寸<input id="field-row-{{index}}-dimension" adjust-position="{{false}}" always-embed type="text" data-path="terms.items[{{index}}].dimension" maxlength="500" value="{{item.dimension}}" bindinput="edit"/></label>
<label class="field">材质<input id="field-row-{{index}}-material" adjust-position="{{false}}" always-embed type="text" data-path="terms.items[{{index}}].material" maxlength="500" value="{{item.material}}" bindinput="edit"/></label>
<label class="field">风格<input id="field-row-{{index}}-style" adjust-position="{{false}}" always-embed type="text" data-path="terms.items[{{index}}].style" maxlength="500" value="{{item.style}}" bindinput="edit"/></label>
<label class="field">验收标准<input id="field-row-{{index}}-acceptanceStandard" adjust-position="{{false}}" always-embed type="text" data-path="terms.items[{{index}}].acceptanceStandard" maxlength="2000" value="{{item.acceptanceStandard}}" bindinput="edit"/></label>
</view><label class="field">整单运费（元，自提为零）<input id="field-terms-freightYuan" adjust-position="{{false}}" always-embed type="digit" data-path="terms.freightYuan" value="{{terms.freightYuan}}" bindinput="edit"/></label>
<label class="field">制作天数<input id="field-terms-productionDays" adjust-position="{{false}}" always-embed type="number" data-path="terms.productionDays" value="{{terms.productionDays}}" bindinput="edit"/></label>
<label class="field">修改约定<input id="field-terms-revisionTerms" adjust-position="{{false}}" always-embed type="text" data-path="terms.revisionTerms" maxlength="1000" value="{{terms.revisionTerms}}" bindinput="edit"/></label>
<label class="field">报价范围<input id="field-terms-includedAndExcluded" adjust-position="{{false}}" always-embed type="text" data-path="terms.includedAndExcluded" maxlength="1000" value="{{terms.includedAndExcluded}}" bindinput="edit"/></label>
<label class="field">售后约定<input id="field-terms-afterSaleTerms" adjust-position="{{false}}" always-embed type="text" data-path="terms.afterSaleTerms" maxlength="1000" value="{{terms.afterSaleTerms}}" bindinput="edit"/></label>
 <label class="field">承诺完成日<picker mode="date" value="{{terms.promisedDate}}" data-path="terms.promisedDate" bindchange="edit"><view class="mj-system-picker"><text>{{terms.promisedDate || '选择日期'}}</text></view></picker></label></block>
 <button wx:if="{{active==='acceptCustomQuote' && detail.quotes[0].terms.deliveryMode==='factory_delivery'}}" bindtap="address">{{addressId?'已选择地址，点击更换':'选择收货地址'}}</button>
 <label wx:if="{{active==='requestQuoteRevision' || active==='declineCustomRequirement' || active==='saveCustomExtension' || active==='reportCustomAfterSale'}}" class="field">办理说明<textarea id="field-editor-reason" adjust-position="{{false}}" data-path="editor.reason" maxlength="1000" value="{{editor.reason}}" bindinput="edit"/></label>
 <label class="field" wx:if="{{active==='saveCustomExtension'}}">申请交付日<picker mode="date" value="{{editor.requestedDate}}" data-path="editor.requestedDate" bindchange="edit"><view class="mj-system-picker"><text>{{editor.requestedDate || '选择日期'}}</text></view></picker></label>
 <block wx:if="{{active==='reportCustomAfterSale'}}"><dict-select range="{{typeNames}}" value="{{typeIndex}}" data-key="type" bindchange="select" title="问题类型" display="{{typeNames[typeIndex || 0]}}" quiet="{{returnRefresh}}"/><dict-select range="{{solutionNames}}" value="{{requestedSolutionIndex}}" data-key="requestedSolution" bindchange="select" title="期望处理" display="{{solutionNames[requestedSolutionIndex || 0]}}" quiet="{{returnRefresh}}"/></block>
 <block wx:if="{{active==='deliverCustomOrder' || active==='registerCustomPickup'}}"><view>逐项核对本次交接</view><checkbox-group data-path="editor.checked" bindchange="edit"><label class="field" wx:for="{{detail.items}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{marked[item.id]}}"/>{{item.title}} × {{item.quantity}} · {{item.acceptanceStandard}}</label></checkbox-group><view>{{active==='deliverCustomOrder'?'实际送达时间':'实际交接时间'}}</view><button size="mini" bindtap="occurredNow">使用当前时间</button><picker mode="date" value="{{editor.date}}" data-k="date" bindchange="occurred"><view class="mj-system-picker"><text>{{editor.date || (active==='deliverCustomOrder'?'实际送达日期':'实际交接日期')}}</text></view></picker><picker mode="time" value="{{editor.time}}" data-k="time" bindchange="occurred"><view class="mj-system-picker"><text>{{editor.time || (active==='deliverCustomOrder'?'实际送达时间':'实际交接时间')}}</text></view></picker><textarea id="field-editor-remark" adjust-position="{{false}}" data-path="editor.remark" maxlength="1000" value="{{editor.remark}}" bindinput="edit" placeholder="交付说明"/></block>
 <block wx:if="{{active==='deliverCustomOrder' || active==='registerCustomPickup' || active==='saveCustomExtension' || active==='reportCustomAfterSale'}}"><view wx:for="{{editor.files}}" wx:key="materialId" class="mj-photo-frame"><private-material wx:if="{{item.type==='image'}}" file="{{item}}" source-id="{{id}}" kind="{{kind}}" factory="{{factory}}"/><text class="mj-attachment-name">{{item.name}}</text><photo-remove identity="{{item.materialId}}" label="{{item.type==='image'?'移除图片':'移除附件'}}" data-group="editor" data-id="{{item.materialId}}" disabled="{{busy}}" bindremove="removeDraftFile"/></view><button bindtap="attach" disabled="{{busy}}">添加办理凭证</button></block>
 <view class="hint" wx:if="{{active==='deliverCustomOrder'}}">提交交付后，买家有 48 小时验收</view>
 <button class="primary sheet-submit" bindtap="confirm" disabled="{{busy}}">确认{{actionLabel}}</button></block></mj-action-sheet>
 <view class="card"><navigator wx:if="{{kind==='orders' && detail.state==='completed'}}" url="/pages/reviews/detail?type=custom_order&id={{id}}">订单评价 ›</navigator>

<navigator wx:if="{{detail}}" url="/pages/service/index?type={{kind==='orders'?'custom_order':'custom_requirement'}}&id={{id}}">咨询平台客服 ›</navigator>
</view>
 </block></view>
