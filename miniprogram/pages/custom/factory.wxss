.public-factory{padding:16px 14px calc(32px + env(safe-area-inset-bottom));min-height:100vh;background:#f3f5f1;color:#222b23;box-sizing:border-box}
.pf-hero,.pf-section{padding:16px;background:#fff;border:1px solid #dce2da;border-radius:14px}
.pf-hero{padding:20px 16px;border-top:4px solid #e5bf28}
.pf-identity{display:flex;align-items:center;gap:12px}
.pf-monogram{flex:none;width:48px;height:48px;display:grid;place-items:center;background:#ffe350;color:#233025;border-radius:14px;font-size:24px;font-weight:700}
.pf-name{min-width:0;font-size:22px;font-weight:700;line-height:1.3;overflow-wrap:anywhere}
.pf-business{margin-top:16px;padding-top:12px;border-top:1px solid #e3e8e1;color:#535e55;font-size:14px;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}
.pf-caption{font-size:12px;color:#626d64;margin-bottom:4px}
.pf-section{margin-top:12px}
.pf-title{font-size:17px;font-weight:700}
.pf-copy{margin:6px 0 14px;font-size:13px;color:#59645b;line-height:1.55}
.public-factory button.pf-action,.public-factory button.pf-link{box-sizing:border-box;display:flex;align-items:center;min-height:44px;width:100%;margin:0;text-decoration:none;font-size:14px;font-weight:650;color:#253026}
.pf-action{justify-content:center;border-radius:10px;background:#ffe350}
.pf-link{justify-content:space-between;gap:12px;padding:10px 0;background:white;border-bottom:1px solid #e3e8e1;text-align:left}
.pf-link:last-child{border-bottom:0}
.pf-link-word{min-width:0;overflow-wrap:anywhere}.pf-arrow{flex:none;color:#69736b}
