<import src="../../navigation/factory-root.wxml"/><view wx:if="{{rootMessage}}" class="feedback error">{{rootMessage}}<button bindtap="resolveRoot">重试</button></view><view wx:elif="{{!rootReady}}" class="empty"><mj-loading label="正在恢复身份"/></view><template wx:elif="{{factoryRoot}}" is="factory-root" data="{{rootLoading,rootIndex,factoryProfile,factoryContext,factoryMenus,tradeOverview,tradeOrders,tradePage,tradeTotal,tradeExhausted,tradeMessage,tradeBusy,items,message,busy,tab,keyword,submittedKeyword,page,total,assetType,selection,warehouseFilters,warehouseLoaded}}"/><block wx:else><block wx:if="{{factoryContext.roleCode==='demander'}}">
  <view class="scheme-board">
    <view class="scheme-heading"><view><view class="scheme-h1">我的方案</view><text wx:if="{{page}}" class="subtle">{{filter==='all'?'全部方案':filter==='editing'?'编辑中':'已归档'}} · {{total}} 个</text></view><button class="scheme-new" bindtap="create">＋ 新建方案</button></view>
    <view wx:if="{{statusOpen}}" class="mj-dropdown-dismiss" catchtap="toggleStatus"></view>
    <view class="scheme-filter-row {{statusOpen?'mj-dropdown-open':''}}">
      <button class="status-trigger" disabled="{{busy}}" aria-expanded="{{statusOpen}}" bindtap="toggleStatus"><text>状态</text><view class="mj-selected-label">{{filter==='all'?'全部方案':filter==='editing'?'编辑中':'已归档'}}</view><view class="chev {{statusOpen?'up':''}}"/></button>
      <button class="scheme-reset" disabled="{{busy}}" bindtap="resetStatus">重置</button>
      <view wx:if="{{statusOpen}}" class="scheme-options"><button wx:for="{{schemeStatuses}}" wx:key="value" data-value="{{item.value}}" bindtap="selectSchemeStatus">{{item.label}}<text wx:if="{{filter===item.value}}">✓</text></button></view>
    </view>
    <view wx:if="{{message}}" class="scheme-message">{{message}}<button wx:if="{{retryDeleteId}}" data-id="{{retryDeleteId}}" bindtap="deleteRow">重试删除</button><button wx:else bindtap="retry">重试</button></view>
    <view wx:if="{{!items.length && !message}}" class="pl-empty"><mj-loading wx:if="{{busy && !returnRefresh}}" label="正在加载"/><text wx:else>暂无方案</text></view>
    <view class="scheme-card" wx:for="{{items}}" wx:key="id">
      <swipe-delete data-id="{{item.id}}" label="删除方案" enabled="{{item.status==='editing' || item.status==='archived'}}"
        opened="{{swipeId===item.id}}" busy="{{busy}}" bindreveal="revealRow" bindremove="deleteRow" bindactivate="open">
        <view class="scheme-open" role="button" aria-label="查看{{item.listTitle}}详情">
          <view class="scheme-line"><text class="scheme-title">{{item.listTitle}}</text><text class="scheme-state {{item.status==='editing'?'editing':''}}">{{item.statusLabel}}</text></view>
          <view wx:if="{{item.note}}" class="scheme-description">{{item.note}}</view>
          <view class="scheme-budget"><text>{{item.quantityTotal}} 件道具</text><text>预估日租 <text class="amount">{{item.dailyText}}</text></text></view>
        </view>
      </swipe-delete>
    </view>
    <view wx:if="{{items.length && !exhausted && items.length < total}}" class="pl-empty"><mj-loading wx:if="{{busy && !returnRefresh}}" label="正在加载"/><text wx:else>上拉加载更多</text></view>
  </view>
</block><block wx:else><import src="../../navigation/renter-empty.wxml"/><template is="renter-empty" data="{{loggedIn:factoryContext,subject:'方案'}}"/></block><login-sheet visible="{{loginVisible}}" return-path="/pages/plan/index" bindclose="closeLogin" bindauthenticated="loginSucceeded"/></block>