@import "../../navigation/root.wxss";

@import "../../navigation/renter-empty.wxss";

@import "../../styles/planning-list.wxss";

.scheme-board{min-height:100vh;box-sizing:border-box;padding:18px 16px calc(88px + env(safe-area-inset-bottom));background:var(--mj-canvas);color:var(--mj-ink)}
.scheme-heading,.scheme-filter-row,.scheme-line,.scheme-budget,.status-trigger{display:flex;align-items:center;justify-content:space-between;gap:8px}
.scheme-board button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:auto;margin:0;min-width:0;min-height:44px;line-height:1.3;font-size:14px;border:0;font-weight:600}
.scheme-board button::after,.scheme-detail button::after{border:0}
.scheme-h1{font-size:25px;font-weight:700}.scheme-board .subtle,.scheme-budget{font-size:12px;color:var(--mj-muted)}
.scheme-board .scheme-new{padding:0 14px;background:var(--mj-accent);color:#242713;border-radius:12px}
.scheme-filter-row{position:relative;margin:14px 0 12px}.scheme-board .status-trigger{justify-content:flex-start;padding:0 12px;gap:7px;background:#fff;border:1px solid var(--mj-line);border-radius:9px}
.status-trigger text{font-size:12px;color:var(--mj-muted)}.chev{width:7px;height:7px;border:solid currentColor;border-width:0 1.5px 1.5px 0;transform:translateY(-2px) rotate(45deg)}.chev.up{transform:rotate(225deg)}
.scheme-board .scheme-reset{background:var(--mj-paper);color:var(--mj-ink);padding:0 16px;border:1px solid var(--mj-line);border-radius:var(--mj-control)}.scheme-options{position:absolute;top:48px;left:0;width:174px;padding:4px;z-index:3;background:white;border:1px solid var(--mj-line);border-radius:10px;box-shadow:0 7px 20px #192e201a}
.scheme-options button{width:100%;display:flex;justify-content:space-between;align-items:center;background:white;padding:0 12px}
.scheme-card{background:white;border:1px solid var(--mj-line);border-radius:14px;margin:10px 0;overflow:hidden}.scheme-open{padding:14px;min-width:0;min-height:44px}.scheme-title{font-size:17px;font-weight:700;min-width:0;overflow-wrap:anywhere}
.scheme-state{flex:none;border-radius:6px;padding:2px 7px;font-size:11px;color:#626962;background:#edeeec}.scheme-state.editing{color:var(--mj-active-ink);background:var(--mj-active-bg)}
.scheme-description{margin:5px 0 9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--mj-muted);font-size:13px}
.scheme-budget{justify-content:flex-start;flex-wrap:wrap;min-width:0}.scheme-budget .amount{font-size:15px;color:var(--mj-ink);font-weight:700}
.scheme-message{padding:12px;background:#fff6ce}
