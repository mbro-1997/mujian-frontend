<view class="planning"><block wx:if="{{detail}}"><view class="muted">朋友分享给你 · 仅浏览</view><view class="card"><view class="intro">{{detail.name}}</view><view class="muted">{{detail.description}}</view><view class="stats"><view><text>道具数量</text>{{detail.quantityTotal}} 件</view><view wx:if="{{!detail.hidePrice}}"><text>预估日租</text>¥{{detail.daily}}</view></view></view><view class="card"><view class="item" wx:for="{{items}}" wx:key="index"><view class="item-main"><view class="picture"><public-prop-image image="{{item.display.image}}" resource-type="share" resource-id="{{token}}" resource-version="{{detail.contentVersion+':'+detail.hidePrice}}" bindinaccessible="inaccessible"/></view><view class="item-body"><view class="title">{{item.display.name}}</view><view class="muted">{{item.display.typeLabel}} · {{item.stylesText}}</view><view class="muted">数量 {{item.quantity}} · {{item.remark}}</view></view><view class="item-rent" wx:if="{{!detail.hidePrice}}">¥{{item.rent}} / 天</view></view></view></view><view class="notice">{{detail.disclaimer}}</view></block><view wx:else class="empty"><view class="intro">{{busy?'正在读取分享…':invalid?'分享链接已失效':'暂时无法读取分享'}}</view><view class="muted">{{message}}</view></view><view class="footer"><button class="primary" bindtap="home">浏览首页</button></view></view>