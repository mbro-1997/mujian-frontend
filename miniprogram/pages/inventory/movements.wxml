<view class="navigation-return" wx:if="{{!nativeBackAvailable}}" bindtap="navigationBack">‹ 返回</view><view class="prop-page"><view class="panel"><picker mode="date" value="{{startDate}}" data-key="startDate" bindchange="filter"><view class="mj-system-picker"><text>开始 {{startDate||'不限'}}</text></view></picker><picker mode="date" value="{{endDate}}" data-key="endDate" bindchange="filter"><view class="mj-system-picker"><text>结束 {{endDate||'不限'}}</text></view></picker><view class="filter-row"><text>流水来源：</text><dict-select range="{{sourceLabels}}" value="{{sourceIndex}}" data-key="source" bindchange="filter" display="{{sourceLabels[sourceIndex]}}" quiet="{{returnRefresh}}"/></view><view class="filter-row"><text>流水类型：</text><dict-select range="{{typeLabels}}" value="{{movementIndex}}" data-key="movement" bindchange="filter" display="{{typeLabels[movementIndex]}}" quiet="{{returnRefresh}}"/></view><button class="mj-filter-reset" wx:if="{{source || movement || startDate || endDate}}" bindtap="resetFilters" disabled="{{busy}}">重置筛选</button></view><view class="heading">库存流水</view><view class="muted">仅显示已生效变化，待审申请不计入流水。</view><view wx:if="{{message}}" class="feedback error">{{message}}<button bindtap="load">重试</button></view><view wx:elif="{{busy && !returnRefresh}}" class="loading"><mj-loading label="正在加载流水"/></view><view wx:elif="{{!items.length}}" class="empty">暂无库存流水</view><view class="panel" wx:for="{{items}}" wx:key="id"><view class="row"><text>{{item.type}}</text><text>{{item.quantity>0?'+':''}}{{item.quantity}}</text></view><view class="muted">{{item.createdAtText}}</view><view class="row" wx:for="{{item.values}}" wx:for-item="fact" wx:key="label"><text>{{fact.label}}</text><text>{{fact.before}} → {{fact.after}}</text></view><view>{{item.remark||'—'}}</view><view class="muted sn-code">来源审核 {{item.relatedAuditId||'—'}}</view></view><view class="pager" wx:if="{{total>20 || page>1}}"><button bindtap="prev" disabled="{{page===1}}">上一页</button><text>{{page}} · {{total}} 条</text><button bindtap="next" disabled="{{page*20>=total}}">下一页</button></view></view>
