<view class="navigation-return" wx:if="{{!nativeBackAvailable}}" bindtap="navigationBack">‹ 返回</view><view class="prop-page"><view class="panel" wx:if="{{sku}}"><view class="heading">{{sku.fields.propName}}</view><view class="muted">{{sku.assetType==='A_ASSET'?'A 类 · 实物管理':'B 类 · 数量台账'}}</view></view><view wx:if="{{message}}" class="feedback error">{{message}}<button bindtap="load">重试</button></view><view wx:if="{{sku.pendingApplicationId && sku.inventorySummary}}" class="feedback">SKU 审核中，暂不能调整库存或变更实物状态。</view><view wx:if="{{busy && !returnRefresh}}" class="loading"><mj-loading label="正在加载库存"/></view><view wx:if="{{sku && sku.inventorySummary===null}}" class="empty">首次上架审核通过后生成库存记录</view><block wx:elif="{{sku.assetType==='A_ASSET'}}"><view class="panel summary"><view wx:for="{{summary}}" wx:key="label"><view>{{item.value}}</view><text class="muted">{{item.label}}</text></view></view><view class="panel filter-row"><text>实物状态：</text><dict-select range="{{labels}}" value="{{statusIndex}}" bindchange="filter" display="{{labels[statusIndex]}}" quiet="{{returnRefresh}}"/></view><button class="mj-filter-reset" wx:if="{{status}}" bindtap="resetFilters" disabled="{{busy}}">重置筛选</button><view class="panel" wx:for="{{items}}" wx:key="id"><view class="muted">{{item.statusChangedAtText||'—'}} · {{item.statusRemark||item.remark||'—'}}</view><view class="row"><text class="sn-code">{{item.snCode}}</text><text class="pill">{{item.state}}</text></view><view wx:if="{{item.pendingAdjustmentId}}" class="muted">库存调整审核中</view><button data-id="{{item.id}}" bindtap="logs">查看实物状态记录</button><button wx:if="{{item.currentQrId}}" data-code="{{item.currentQrId}}" bindtap="qr">查看标签 / 贴标</button><button wx:if="{{item.canCompleteRepair}}" data-id="{{item.id}}" bindtap="repair" disabled="{{busy}}">维修完成</button></view><view class="empty" wx:if="{{(!busy||returnRefresh)&&!message&&!items.length}}">暂无此状态实物</view><view class="pager" wx:if="{{total>20 || page>1}}"><button bindtap="prev" disabled="{{page===1}}">上一页</button><text>{{page}} · 共 {{total}} 件</text><button bindtap="next" disabled="{{page*20>=total}}">下一页</button></view></block><view wx:elif="{{stock}}" class="panel"><view class="heading">当前库存</view><view class="summary"><view><view>{{stock.totalQuantity}}</view><text class="muted">总量</text></view><view><view>{{stock.rentableBaseQuantity}}</view><text class="muted">可租基数</text></view><view><view>{{stock.availableQuantity}}</view><text class="muted">当前可用</text></view><view><view>{{stock.lockedQuantity}}</view><text class="muted">锁定</text></view><view><view>{{stock.rentingQuantity}}</view><text class="muted">租赁中</text></view><view><view>{{stock.lostQuantity}}</view><text class="muted">累计丢失</text></view><view><view>{{stock.scrappedQuantity}}</view><text class="muted">累计报废</text></view></view><view class="muted">总量与可租基数已扣除永久退出；累计损失不重复扣减。</view><button bindtap="movements">查看库存流水</button><button wx:if="{{sku.currentQrId}}" data-code="{{sku.currentQrId}}" bindtap="qr">查看 / 下载 SKU 标签</button><view wx:else class="muted">暂无活动标签，请联系平台核对。</view><button bindtap="scan">扫描 SKU 标签 · 仅识别</button></view><view class="footer-actions"><button bindtap="load" loading="{{busy && !returnRefresh}}">刷新</button><button class="primary-btn" bindtap="adjust" disabled="{{!sku.canAdjustInventory||busy}}">申请库存调整</button></view></view>
