<view class="navigation-return" wx:if="{{!nativeBackAvailable}}" bindtap="navigationBack">‹ 返回</view><view class="prop-page"><view class="panel" wx:if="{{sku}}"><view class="heading">{{sku.fields.propName}}</view><view class="muted">{{sku.assetType==='A_ASSET'?'A 类 · 实物管理':'B 类 · 数量台账'}}</view></view><view wx:if="{{message}}" class="feedback error">{{message}}<button bindtap="load">重试</button></view><view wx:if="{{sku.pendingApplicationId && sku.inventorySummary}}" class="feedback">SKU 审核中，暂不能变更实物状态。</view><view wx:if="{{busy && !returnRefresh}}" class="loading"><mj-loading label="正在加载库存"/></view><view wx:if="{{sku && sku.inventorySummary===null}}" class="empty">首次上架审核通过后生成库存记录</view><block wx:elif="{{sku.assetType==='A_ASSET'}}"><view class="panel" wx:for="{{items}}" wx:key="id"><view class="muted">{{item.statusChangedAtText||'—'}} · {{item.statusRemark||item.remark||'—'}}</view><view class="row"><text class="sn-code">{{item.snCode}}</text><text class="pill">{{item.state}}</text></view><view wx:if="{{item.pendingAdjustmentId}}" class="muted">库存调整审核中</view><button data-id="{{item.id}}" bindtap="logs">查看实物状态记录（删去）</button><inventory-label wx:if="{{item.currentQrId}}" sku="{{sku}}" qr-id="{{item.currentQrId}}" target-id="{{item.id}}" bindconfirmed="load"/><button wx:if="{{item.canCompleteRepair}}" data-id="{{item.id}}" bindtap="repair" disabled="{{busy}}">维修完成</button></view><view class="empty" wx:if="{{(!busy||returnRefresh)&&!message&&!items.length}}">暂无实物</view><view class="pager" wx:if="{{total>20 || page>1}}"><button bindtap="prev" disabled="{{page===1}}">上一页</button><text>{{page}} · 共 {{total}} 件</text><button bindtap="next" disabled="{{page*20>=total}}">下一页</button></view></block><view wx:elif="{{sku}}" class="panel"><view class="sn-code">{{sku.skuCode}}</view>
<inventory-label wx:if="{{sku.currentQrId}}" sku="{{sku}}" qr-id="{{sku.currentQrId}}" target-id="{{sku.id}}"/><view wx:else class="muted">暂无活动标签，请联系平台核对。</view><button bindtap="scan">扫描 SKU 标签 · 仅识别</button></view></view>
