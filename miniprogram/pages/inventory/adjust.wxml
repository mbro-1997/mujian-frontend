<view class="navigation-return" wx:if="{{!nativeBackAvailable}}" bindtap="navigationBack">‹ 返回</view><view class="prop-page">
  <view wx:if="{{busy && !sku && !message}}" class="mj-read-state"><mj-loading label="正在读取库存资料"/></view><view class="panel"><view class="heading">库存调整申请</view><view>{{sku.fields.propName}}</view><view class="muted">提交后等待审核，通过前不改变库存。</view></view><view class="feedback error" wx:if="{{message}}">{{message}}</view><view class="panel" wx:if="{{sku.canAdjustInventory}}"><view class="form-row"><label>调整类型 *</label><dict-select range="{{labels}}" value="{{typeIndex}}" bindchange="type" display="{{type==='increase'?'增加':type==='decrease'?'减少':type==='repair'?'维修':'异常扣减'}}" quiet="{{returnRefresh}}"/></view><view class="form-row" wx:if="{{type==='abnormal_decrease'}}"><label>异常结果 *</label><dict-select range="{{abnormalLabels}}" value="{{abnormalIndex}}" bindchange="abnormal" display="{{abnormal==='lost'?'丢失 / 盘亏':abnormal==='scrapped'?'报废':'请选择异常结果'}}" quiet="{{returnRefresh}}"/></view><view wx:if="{{sku.assetType==='B_CONSUMABLE'||type==='increase'}}" class="form-row"><label>调整数量 *</label><input id="field-quantity" adjust-position="{{false}}" always-embed type="number" value="{{quantity}}" data-key="quantity" bindinput="input"/></view><view class="form-row"><label>调整原因 *</label><textarea id="field-reason" adjust-position="{{false}}" maxlength="255" value="{{reason}}" data-key="reason" bindinput="input"/></view></view><view class="panel" wx:if="{{sku.canAdjustInventory&&sku.assetType==='A_ASSET'&&type!=='increase'}}"><view class="heading">选择实物 · 已选 {{selected.length}} 件</view><view class="muted">减少/维修仅可选空闲；异常可选空闲或维修实物。待审实物不可重复申请。</view><view class="panel {{item.checked?'active':''}} {{!item.selectable?'disabled':''}}" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="select"><view class="sn-code">{{item.checked?'☑':'□'}} {{item.snCode}}</view><view>{{item.state}}{{item.pendingAdjustmentId?' · 调整审核中':''}}</view></view><button bindtap="more" wx:if="{{page*100<total}}" loading="{{busy && !returnRefresh}}">加载更多实物</button></view><view class="footer-actions single"><button class="primary-btn" bindtap="submit" loading="{{busy && !returnRefresh}}" disabled="{{busy||!sku.canAdjustInventory}}">提交调整申请</button></view></view>
