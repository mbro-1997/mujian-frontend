<view class="navigation-return" wx:if="{{!nativeBackAvailable}}" bindtap="navigationBack">‹ 返回实物列表</view><view class="prop-page"><view class="panel"><view class="heading">实物状态记录</view><view class="muted">仅记录当前实物的状态变化，数量流水请在 B 类道具中查看。</view></view><view wx:if="{{busy && !returnRefresh}}" class="empty"><mj-loading label="正在加载"/></view><view wx:elif="{{message}}" class="feedback error">{{message}}<button bindtap="load">重试</button></view><view wx:elif="{{!items.length}}" class="empty">暂无状态记录</view><view class="panel" wx:for="{{items}}" wx:key="id"><view class="heading">{{item.from}} → {{item.to}}</view><view>{{item.source}}</view><view class="muted">{{item.createdTime}}</view><view class="value">{{item.reason||'未填写说明'}}</view></view><view class="pager" wx:if="{{total>20 || page>1}}"><button bindtap="prev" disabled="{{busy||page===1}}">上一页</button><text>{{page}} · 共 {{total}} 条</text><button bindtap="next" disabled="{{busy||page*20>=total}}">下一页</button></view></view>