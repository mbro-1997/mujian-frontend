<view class="planning planning-detail"><view class="error" wx:if="{{message}}">{{message}}<button bindtap="recover">查询原操作结果</button><button bindtap="refresh">重新读取</button></view><button wx:if="{{canRestoreDraft}}" disabled="{{busy}}" bindtap="restoreDraft">恢复上次输入</button><view wx:if="{{!detail && !message}}" class="empty"><mj-loading wx:if="{{busy && !returnRefresh}}" label="正在读取"/><text wx:else>暂无可查看的内容</text></view><block wx:if="{{detail}}"><view class="card"><view class="row"><view class="title">{{detail.name}}</view><text class="badge {{detail.status==='selecting'?'current':''}}">{{detail.statusLabel}}</text></view><view class="detail-dates"><text>租赁时间</text>{{detail.startDate}} 至 {{detail.endDate}} · {{detail.rentalDays}}天</view><view class="detail-metrics"><view class="pl-metric"><text>道具</text>{{detail.quantityTotal}} 件</view><view class="pl-metric"><text>预估日租</text>{{hidePrice?'******':'¥'+detail.daily}}</view><view class="pl-metric"><text>押金</text>{{hidePrice?'******':'¥'+detail.deposit}}</view></view><view wx:if="{{reason}}" class="{{detail.submission.reasonCode==='RENTAL_WINDOW_CLOSED'?'cutoff-note':'notice'}}">{{reason}}</view><view class="muted">整段租金预估 ¥{{rentEstimate}}；不锁定库存。</view></view><view class="card"><view class="title">道具列表</view>
<block wx:for="{{items}}" wx:key="id"><view wx:if="{{!index || item.display.factoryId!==items[index-1].display.factoryId}}" class="factory-title">{{item.display.factoryName}}</view><view class="item checklist-item"><swipe-delete label="删除{{item.display.name}}" data-id="{{item.id}}" enabled="{{detail.actions.canEdit}}" opened="{{swipeId===item.id}}" busy="{{busy}}" bindreveal="revealRow" bindremove="removeRow">
<view class="checklist-item-body"><view class="item-main"><view class="picture"><public-prop-image image="{{item.display.image}}" resource-type="checklist" resource-id="{{id}}" resource-version="{{detail.contentVersion||detail.version}}" bindinaccessible="inaccessible"/></view><view class="item-body"><view class="title">{{item.display.name}}</view><view class="muted">{{item.display.typeLabel}} · {{item.stylesText}}</view><view wx:if="{{item.availability.maxRentableQuantity > 0 && item.quantity <= item.availability.maxRentableQuantity}}" class="success">可租 · 本租期最多 {{item.availability.maxRentableQuantity}} 件</view><view class="unavailable" wx:if="{{item.availability && (item.availability.maxRentableQuantity === 0 || item.quantity > item.availability.maxRentableQuantity)}}">不可租 / 数量不足 · 当前上限 {{item.availability.maxRentableQuantity}}</view><view wx:if="{{!detail.actions.canEdit}}" class="muted">数量 {{item.quantity}} · {{item.remark}}</view></view><view class="item-rent">{{hidePrice?'***':'¥'+item.rent+'/天'}}</view></view></view></swipe-delete>
<view wx:if="{{detail.actions.canEdit}}" class="checklist-item-controls"><view class="item-tools"><view class="quantity"><button data-index="{{index}}" data-delta="-1" bindtap="step" disabled="{{item.quantity<=1}}">−</button><input id="field-row-{{index}}-quantity" adjust-position="{{false}}" always-embed type="number" value="{{item.quantityDraft != null ? item.quantityDraft : item.quantity}}" data-index="{{index}}" data-id="{{item.id}}" data-field="quantity" bindinput="itemField" bindblur="finishChecklistQuantity"/><button data-index="{{index}}" data-delta="1" bindtap="step" disabled="{{busy || !item.availability || item.quantity >= item.availability.maxRentableQuantity}}">+</button></view></view><view class="field"><input id="field-row-{{index}}-remark" adjust-position="{{false}}" always-embed value="{{item.remark}}" maxlength="255" placeholder="备注（选填）" data-index="{{index}}" data-field="remark" bindinput="itemField"/></view></view></view></block>
<view wx:if="{{!items.length && !message}}" class="empty">暂无道具，请从首页选择加入。</view></view><view class="footer buttons"><button wx:if="{{detail.actions.canContinueSelecting}}" class="pl-action" bindtap="select">继续选品</button><button wx:if="{{detail.actions.canEdit}}" class="pl-action" bindtap="save" disabled="{{busy}}">保存</button><button wx:if="{{detail.actions.canActivate}}" class="pl-action pl-main" bindtap="activate">切换为当前</button><button wx:if="{{detail.status==='selecting'||detail.currentCheckoutBatchId}}" class="pl-action pl-main" bindtap="submit">{{detail.currentCheckoutBatchId?'查看原付款':'配送与结算'}}</button></view></block></view>
