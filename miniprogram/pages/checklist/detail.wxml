<view class="planning planning-detail"><view class="error" wx:if="{{message}}">{{message}}<button bindtap="recover">查询原操作结果</button><button bindtap="refresh">重新读取</button></view><button wx:if="{{canRestoreDraft}}" disabled="{{busy}}" bindtap="restoreDraft">恢复上次输入</button><view wx:if="{{!detail && !message}}" class="empty">{{busy?'正在读取…':'暂无可查看的内容'}}</view><block wx:if="{{detail}}"><view class="card"><view class="row"><view class="title">{{detail.name}}</view><text class="badge {{detail.status==='selecting'?'current':''}}">{{detail.statusLabel}}</text></view><view class="detail-dates"><text>租赁时间</text>{{detail.startDate}} 至 {{detail.endDate}} · {{detail.rentalDays}}天</view><view class="detail-metrics"><view class="pl-metric"><text>道具</text>{{detail.quantityTotal}} 件</view><view class="pl-metric"><text>预估日租</text>{{hidePrice?'******':'¥'+detail.daily}}</view><view class="pl-metric"><text>押金</text>{{hidePrice?'******':'¥'+detail.deposit}}</view></view><view wx:if="{{reason}}" class="notice">{{reason}}</view><view class="muted">整段租金预估 ¥{{rentEstimate}}；不锁定库存。</view></view><view class="card"><view class="title">道具列表</view><view class="item" wx:for="{{items}}" wx:key="id"><view wx:if="{{!index || item.display.factoryId!==items[index-1].display.factoryId}}" class="factory-title">{{item.display.factoryName}}</view><view class="item-main"><view class="picture"><public-prop-image image="{{item.display.image}}" resource-type="checklist" resource-id="{{id}}" resource-version="{{detail.contentVersion||detail.version}}" bindinaccessible="inaccessible"/></view><view class="item-body"><view class="title">{{item.display.name}}</view><view class="muted">{{item.display.typeLabel}} · {{item.stylesText}}</view><view wx:if="{{item.availability.isRentable}}" class="success">可租</view><view class="unavailable" wx:if="{{item.availability && !item.availability.isRentable}}">不可租 / 数量不足 · 当前上限 {{item.availability.maxRentableQuantity}}</view><view wx:if="{{!detail.actions.canEdit}}" class="muted">数量 {{item.quantity}} · {{item.remark}}</view></view><view class="item-rent">{{hidePrice?'***':'¥'+item.rent+'/天'}}</view></view><block wx:if="{{detail.actions.canEdit}}"><view class="item-tools"><view class="quantity"><button data-index="{{index}}" data-delta="-1" bindtap="step" disabled="{{item.quantity<=1}}">−</button><input type="number" value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="itemField"/><button data-index="{{index}}" data-delta="1" bindtap="step">+</button></view><button class="danger" data-index="{{index}}" bindtap="remove">删除</button></view><view class="field"><input value="{{item.remark}}" maxlength="255" placeholder="备注（选填）" data-index="{{index}}" data-field="remark" bindinput="itemField"/></view></block></view><view wx:if="{{!items.length && !message}}" class="empty">暂无道具，请从首页选择加入。</view></view><view class="footer buttons"><button wx:if="{{detail.actions.canContinueSelecting}}" class="pl-action" bindtap="select">继续选品</button><button wx:if="{{detail.actions.canEdit}}" class="pl-action" bindtap="save" disabled="{{busy}}">保存</button><button wx:if="{{detail.actions.canActivate}}" class="pl-action pl-main" bindtap="activate">切换为当前</button><button wx:if="{{detail.status==='selecting'||detail.currentCheckoutBatchId}}" class="pl-action pl-main" bindtap="submit">{{detail.currentCheckoutBatchId?'查看原付款':'配送与结算'}}</button></view></block></view>