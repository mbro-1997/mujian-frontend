<view class="trade"><view wx:if="{{message}}" class="feedback">{{message}}<button bindtap="load">刷新订单</button><button bindtap="recover">查询原操作</button></view><view wx:if="{{!detail && !message}}" class="blank">{{busy?'正在读取订单…':'暂无可查看的订单'}}</view><block wx:if="{{detail}}"><view class="section hero"><view class="row order-heading"><text class="heading order-title">{{detail.factoryName}}</text><text class="badge">{{detail.label}}</text><text wx:if="{{detail.terminationRefund}}" class="muted">{{detail.terminationRefund}}</text></view><view>{{detail.startDate}} 至 {{detail.endDate}}<text wx:if="{{detail.disputes.currentDueDate!==detail.endDate}}"> · 当前归还日 {{detail.disputes.currentDueDate}}</text></view><view class="muted">订单号 {{detail.orderNo}}</view><view wx:if="{{detail.orderStatus==='pending_accept'}}" class="notice">接单截止 {{detail.acceptDeadlineAtText}}，超过截止自动拒绝并原路退款。</view><view wx:if="{{detail.supplyWarning}}" class="reason">前序订单逾期未归还，已影响本单库存，请联系工厂协调。</view></view><view class="section"><button bindtap="extensions">查看延期申请</button></view><view wx:if="{{detail.disputes.issueIds.length}}" class="section"><button bindtap="issues">查看订单问题与补证进度 ›</button></view><view wx:if="{{fulfillmentVisible}}" class="section"><button bindtap="disputes">索赔、仲裁与补缴 ›</button><button bindtap="fulfillment">{{detail.disputes.overdueFee?'查看归还费用与核验 ›':'查看交接、归还与核验 ›'}}</button></view><view wx:if="{{canExtend}}" class="section">
  <view class="heading">延期试算</view>
  <label>增加天数<input type="number" maxlength="3" value="{{extensionDays}}" bindinput="changeExtensionDays" disabled="{{busy}}" /></label>
  <button bindtap="previewExtension" disabled="{{busy}}">查询延期租金</button>
  <block wx:if="{{extensionQuote}}"><view>预计归还日 {{extensionQuote.dueDate}}</view><view>新增租金 ¥{{extensionQuote.amount}}</view><view class="muted">最晚付款 {{extensionQuote.deadline}}</view><button class="primary" disabled="{{busy}}" bindtap="submitExtension">支付 ¥{{extensionQuote.amount}} 并提交延期</button></block>
</view><view class="section"><view class="heading">收货信息</view><view>{{detail.receiver.name}} · {{detail.receiver.phone}}</view><view class="muted">{{detail.receiver.regionText}} {{detail.receiver.detailAddress}}</view><view class="notice" wx:if="{{detail.buyerRemarkText}}">买家备注：{{detail.buyerRemarkText}}</view></view><view class="section"><view class="heading">道具明细</view><view wx:for="{{items}}" wx:key="snapshotItemId" class="item"><view class="picture"><public-prop-image image="{{item.image}}" resource-type="{{factory?'factory-order':'order'}}" resource-id="{{id}}" resource-version="{{detail.version}}" bindinaccessible="inaccessible"/></view><view class="item-body"><view class="item-title">{{item.name}}</view><view class="muted">{{item.quantity}} 件 · ¥{{item.daily}} / 天</view><view>现金租金 ¥{{item.rent}}</view><view wx:if="{{item.transportRequirement}}" class="muted">{{item.transportRequirement}}</view></view></view></view><view class="section"><view class="heading">配送安排</view><view class="row"><text>{{detail.outbound.serviceLabel}}</text><text>¥{{detail.outbound.prepaid}}</text></view><view class="muted" wx:if="{{detail.outbound.vehicleTierNameText || detail.outbound.distance!==''}}">{{detail.outbound.vehicleTierNameText}} {{detail.outbound.distance!==''?detail.outbound.distance+' km':''}}</view><view class="row"><text>{{detail.return.serviceLabel}}</text><text>¥{{detail.return.prepaid}}</text></view><view class="muted" wx:if="{{detail.return.vehicleTierNameText || detail.return.distance!==''}}">{{detail.return.vehicleTierNameText}} {{detail.return.distance!==''?detail.return.distance+' km':''}}</view><view class="muted">{{detail.transportNotice}}</view></view><view class="section"><view class="heading">付款与退款</view><view class="row"><text>原租金</text><text>¥{{detail.amounts.rentOriginal}}</text></view><view class="row"><text>租金优惠</text><text>−¥{{detail.amounts.couponDiscount}}</text></view><view class="row"><text>押金</text><text>¥{{detail.amounts.deposit}}</text></view><view class="row"><text>运费预收</text><text>¥{{detail.amounts.freight}}</text></view><view class="row"><text class="strong">现金实付</text><text class="strong">¥{{detail.paid}}</text></view><view class="row"><text>已退回</text><text>¥{{detail.refunded}}</text></view><view class="row"><text>已扣取消费</text><text>¥{{detail.deducted}}</text></view><view wx:if="{{detail.cancelReason||detail.rejectReason}}" class="muted">原因：{{detail.cancelReason||detail.rejectReason}}</view><block wx:if="{{!factory}}"><button wx:for="{{detail.refundIds}}" wx:key="*this" data-id="{{item}}" bindtap="refund">查看退款进度 {{index+1}} ›</button><button bindtap="payment">查看本次付款批次 ›</button></block></view><view class="link" bindtap="rules">取消与退款规则 ›</view>
<view class="sheet" wx:if="{{quote}}"><view class="heading">确认取消订单</view><view class="row"><text>取消费扣款</text><text>¥{{quote.deduction}}</text></view><view class="row"><text>退租金 / 押金 / 运费</text><text>¥{{quote.rent}} / {{quote.deposit}} / {{quote.freight}}</text></view><view class="row"><text>应退合计</text><text class="strong">¥{{quote.total}}</text></view><view class="muted">超过确认时限或费用档位变化，需要重新核对金额。</view><textarea value="{{reason}}" bindinput="reason" maxlength="255" placeholder="请输入取消原因"/><button class="primary" bindtap="confirmCancel" disabled="{{busy}}">确认取消并原路退款</button><button bindtap="cancelQuote" disabled="{{busy}}">重新试算</button><button bindtap="close">暂不取消</button></view>
<view class="sheet" wx:if="{{rejecting}}"><view class="heading">拒绝接单</view><view class="notice">确认后将退回这家工厂的原实付款。</view><textarea value="{{reason}}" bindinput="reason" maxlength="255" placeholder="请输入拒绝原因"/><button class="primary" bindtap="confirmReject" disabled="{{busy}}">确认拒绝</button><button bindtap="close">返回核对</button></view>
<view class="section">
<navigator wx:if="{{detail.orderStatus==='completed'}}" url="/pages/reviews/detail?type=rental_order&id={{id}}">订单评价 ›</navigator>

<navigator wx:if="{{id}}" url="/pages/service/index?type=rental_order&id={{id}}">咨询平台客服 ›</navigator>
</view>
<view class="footer" wx:if="{{!quote && !rejecting}}"><button wx:if="{{canReject}}" bindtap="reject" class="secondary" disabled="{{busy}}">拒绝接单</button><button wx:if="{{canAccept}}" bindtap="accept" class="primary" disabled="{{busy}}">确认接单</button><button wx:if="{{canCancel}}" bindtap="cancelQuote" class="secondary" disabled="{{busy}}">取消订单</button><button bindtap="load" disabled="{{busy}}">刷新状态</button></view></block></view>
