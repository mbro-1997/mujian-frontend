.page {
  min-height: 100vh;
  padding: 64rpx 32rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 24% 12%, rgba(34, 211, 238, 0.16), transparent 30%),
    #070b16;
  color: #f8fafc;
}

.card {
  min-height: 420rpx;
  padding: 48rpx 32rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 28rpx;
  background: rgba(15, 23, 42, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  text-align: center;
}

.state-visual {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 28rpx;
  background: rgba(34, 211, 238, 0.08);
  border: 1rpx solid rgba(34, 211, 238, 0.22);
}

.state-code-corner {
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  border-color: #22d3ee;
}

.corner-tl {
  left: 24rpx;
  top: 24rpx;
  border-left: 6rpx solid #22d3ee;
  border-top: 6rpx solid #22d3ee;
}

.corner-tr {
  right: 24rpx;
  top: 24rpx;
  border-right: 6rpx solid #22d3ee;
  border-top: 6rpx solid #22d3ee;
}

.corner-bl {
  left: 24rpx;
  bottom: 24rpx;
  border-left: 6rpx solid #22d3ee;
  border-bottom: 6rpx solid #22d3ee;
}

.corner-br {
  right: 24rpx;
  bottom: 24rpx;
  border-right: 6rpx solid #22d3ee;
  border-bottom: 6rpx solid #22d3ee;
}

.state-scan-line {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 64rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #67e8f9;
  box-shadow: 0 0 18rpx rgba(103, 232, 249, 0.55);
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.message {
  max-width: 560rpx;
  color: #94a3b8;
  font-size: 26rpx;
  line-height: 1.7;
}

.primary-btn,
.ghost-btn {
  width: 360rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.primary-btn {
  background: #22d3ee;
  color: #03111a;
}

.ghost-btn {
  background: rgba(148, 163, 184, 0.12);
  color: #e2e8f0;
}
