.page {
  min-height: 100vh;
  padding: 64rpx 32rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 24% 12%, rgba(34, 211, 238, 0.16), transparent 30%),
    #070b16;
  color: #f8fafc;
}

.card {
  min-height: 420rpx;
  padding: 48rpx 32rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 28rpx;
  background: rgba(15, 23, 42, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  text-align: center;
}

.loader {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(34, 211, 238, 0.16);
  border-top-color: #22d3ee;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.message {
  max-width: 560rpx;
  color: #94a3b8;
  font-size: 26rpx;
  line-height: 1.7;
}

.primary-btn,
.ghost-btn {
  width: 360rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.primary-btn {
  background: #22d3ee;
  color: #03111a;
}

.ghost-btn {
  background: rgba(148, 163, 184, 0.12);
  color: #e2e8f0;
}
