<view class="page">
  <view class="card">
    <view class="state-visual">
      <view class="state-code-corner corner-tl"></view>
      <view class="state-code-corner corner-tr"></view>
      <view class="state-code-corner corner-bl"></view>
      <view class="state-code-corner corner-br"></view>
      <view class="state-scan-line"></view>
    </view>
    <view class="title">{{title}}</view>
    <view class="message">{{message}}</view>
    <button wx:if="{{showRoleButton}}" class="primary-btn" bindtap="goRole">去登录</button>
    <button wx:if="{{showHomeButton}}" class="ghost-btn" bindtap="goHome">返回首页</button>
  </view>
</view>
