<view class="planning address-edit"><view wx:if="{{busy && id && !version && !message}}" class="mj-read-state"><mj-loading label="正在读取收货地址"/></view><view class="card"><view class="row"><view class="title">地址信息</view><view>默认地址<switch checked="{{isDefault}}" bindchange="toggle" disabled="{{busy}}" color="#ffe100"/></view></view><view class="field"><view class="field-label">联系人 *</view><view class="mj-line-field"><input id="field-receiverName" adjust-position="{{false}}" always-embed class="mj-line-control" value="{{receiverName}}" maxlength="64" data-field="receiverName" bindinput="input" placeholder="名字" disabled="{{busy}}"/></view></view><view class="field"><view class="field-label">手机号 *</view><view class="mj-line-field"><input id="field-phone" adjust-position="{{false}}" always-embed class="mj-line-control" value="{{phone}}" type="number" maxlength="11" data-field="phone" bindinput="input" placeholder="请输入手机号" disabled="{{busy}}"/></view></view><view class="field"><view class="field-label">所在地区 *</view><picker mode="region" value="{{regionValue}}" bindchange="region" disabled="{{busy}}"><view class="mj-system-picker"><text>{{regionText||'请选择省市区'}}</text></view></picker></view><view class="field"><view class="field-label">详细地址 *</view><textarea id="field-detailAddress" adjust-position="{{false}}" value="{{detailAddress}}" maxlength="255" disabled="{{busy}}" data-field="detailAddress" bindinput="input" placeholder="小区、写字楼、门牌号等"/></view></view><view class="muted">联系人手机号仅用于收货，不会更改登录手机号。</view><view wx:if="{{message}}" class="error">{{message}}<button bindtap="recover">查询原保存结果</button><button wx:if="{{id}}" bindtap="refresh">重新读取</button></view><button wx:if="{{canRestoreDraft}}" disabled="{{busy}}" bindtap="restoreDraft">恢复上次输入</button><view class="footer"><button class="primary" disabled="{{busy}}" bindtap="save">{{busy?'保存中…':'保存'}}</button></view></view>
