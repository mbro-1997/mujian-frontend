<view class="planning address-list"><view wx:if="{{message}}" class="error">{{message}}<button bindtap="recover">查询原操作结果</button><button bindtap="retry">重试</button></view><view wx:if="{{!items.length && !message}}" class="empty"><mj-loading wx:if="{{busy && !returnRefresh}}" label="正在读取"/><text wx:else>一个地址也没有，快去添加收货地址吧</text></view><view class="card" wx:for="{{items}}" wx:key="id"><view data-id="{{item.id}}" bindtap="choose"><view class="title">{{item.regionText}}｜{{item.detailAddress}}</view><view class="muted">{{item.receiverName}} · {{item.phone}}</view><text wx:if="{{item.isDefault}}" class="badge">默认地址</text></view><view class="buttons"><button data-id="{{item.id}}" bindtap="edit">编辑</button><button wx:if="{{!item.isDefault}}" data-id="{{item.id}}" bindtap="default">设为默认</button><button class="danger" data-id="{{item.id}}" bindtap="remove">删除</button></view></view><view class="footer"><button class="primary" bindtap="create">＋ 新增收货地址</button></view></view>