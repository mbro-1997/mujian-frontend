<view class="rule-page" bindtouchstart="activity"><view wx:if="{{document}}"><view class="meta">版本 {{document.version}} · 生效时间 {{document.effectiveAt}}</view><view class="card"><rich-text nodes="{{document.contentText}}"/></view></view><view wx:else><view class="hero"><text class="eyebrow">注册前确认</text><view class="title">阅读并同意平台规则</view><text>各规则可分别打开阅读，平台会保存你同意的具体版本。</text></view><view class="card"><view class="row" wx:for="{{rules}}" wx:key="documentId" data-id="{{item.documentId}}" bindtap="open"><text>{{item.title}}</text><text>›</text></view></view></view><view wx:if="{{register && !document}}" class="card"><checkbox-group bindchange="agreement"><label><checkbox value="agree" checked="{{agreed}}" color="#e5bf00"/>我已阅读并同意以上全部规则，理解下单、取消、延期、押金、赔付及运输责任等重要内容。</label></checkbox-group><button class="primary" bindtap="accept" disabled="{{!agreed || busy || rules.length !== 5}}">同意并继续</button></view><view wx:if="{{message}}" class="feedback">{{message}}</view><button wx:if="{{message}}" bindtap="load" loading="{{busy}}">重试</button><button class="secondary" bindtap="back">返回</button></view>