<view wx:if="{{!nativeBackAvailable}}" class="navigation-return" bindtap="navigationBack">‹ 返回</view>
<view class="prop-page">
  <view wx:if="{{message}}" class="feedback error">{{message}}<button bindtap="load">重试</button></view>
  <view wx:elif="{{busy && !returnRefresh}}" class="empty"><mj-loading label="正在加载申请"/></view>
  <view wx:elif="{{!items.length}}" class="empty">暂无申请记录</view>
  <view class="panel stock-card" wx:for="{{items}}" wx:key="rowKey" data-id="{{item.id}}" data-type="{{item.sourceType}}" bindtap="open" hover-class="stock-pressed" aria-role="button" aria-label="查看{{item.propName}}的当次申请">
    <view class="stock-head"><text class="stock-title">{{item.propName}}</text><text class="stock-state {{item.auditStatus}}">{{item.state}}</text></view>
    <view class="stock-summary">{{item.action}} · {{item.assetType==='A_ASSET'?'A 类':'B 类'}}<text wx:if="{{item.initialQuantity!=null}}"> · 初始 {{item.initialQuantity}} 件</text><text wx:if="{{item.quantity!=null}}"> · 申请 {{item.quantity}} 件</text><text wx:if="{{item.quantityDelta!=null}}"> · 数量变化 {{item.quantityDelta}}</text></view>
    <view wx:if="{{item.relatedSkuAuditId}}" class="stock-note">随 SKU 审核生效</view>
    <view wx:if="{{item.applyRemark}}" class="stock-excerpt">{{item.applyRemark}}</view>
    <view class="stock-code">{{item.skuCode}}</view>
    <view class="stock-foot"><text>{{item.submittedAtText}}</text><text class="stock-link">查看申请 ›</text></view>
  </view>
  <view class="pager" wx:if="{{total>20 || page>1}}">
    <button bindtap="prev" disabled="{{page===1}}">上一页</button><text>{{page}} · {{total}} 条</text><button bindtap="next" disabled="{{page*20>=total}}">下一页</button>
  </view>
</view>
