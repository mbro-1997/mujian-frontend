<view class="navigation-return" wx:if="{{!nativeBackAvailable}}" bindtap="navigationBack">‹ 返回</view><view class="prop-page"><view class="panel"><view class="heading">道具与库存申请</view><view class="muted">待审 {{counts.total}} · 资料 {{counts.sku}} · 库存 {{counts.inventory}} · 状态 {{counts.skuStatus}}</view><view class="review-filter"><text>业务分类：</text><dict-select range="{{categoryLabels}}" value="{{categoryIndex}}" bindchange="category" display="{{categoryLabels[categoryIndex]}}" quiet="{{returnRefresh}}"/></view><view class="review-filter"><text>资产类型：</text><dict-select range="{{assetLabels}}" value="{{assetIndex}}" bindchange="asset" display="{{assetLabels[assetIndex]}}" quiet="{{returnRefresh}}"/></view><view class="review-filter"><text>审核状态：</text><dict-select range="{{labels}}" value="{{statusIndex}}" bindchange="filter" display="{{labels[statusIndex]}}" quiet="{{returnRefresh}}"/></view><button class="mj-filter-reset" wx:if="{{category || assetType || status !== 'all'}}" bindtap="resetFilters" disabled="{{busy}}">重置筛选</button></view><view class="feedback error" wx:if="{{message}}">{{message}}<button bindtap="load">重试</button></view><view class="empty" wx:elif="{{busy && !returnRefresh}}"><mj-loading label="正在加载申请"/></view><view class="empty" wx:elif="{{!items.length}}">暂无该状态的申请</view><view class="panel" wx:for="{{items}}" wx:key="rowKey" data-id="{{item.id}}" data-type="{{item.sourceType}}" bindtap="open"><view class="row"><text class="heading">{{item.propName}}</text><text class="pill">{{item.state}}</text></view><view>{{item.action}} · {{item.assetType==='A_ASSET'?'A 类':'B 类'}}</view><view class="muted">{{item.skuCode}} · {{item.submittedAtText}}</view><view wx:if="{{item.relatedSkuAuditId}}" class="muted">随 SKU 审核生效</view><view wx:if="{{item.initialQuantity!==null}}">初始数量 {{item.initialQuantity}}</view><view wx:if="{{item.quantity!==null}}">申请件数 {{item.quantity}}</view><view wx:if="{{item.quantityDelta!==null}}">数量变化 {{item.quantityDelta}}</view><view>{{item.applyRemark||'—'}}</view><text class="link">查看当次申请 →</text></view><view class="pager" wx:if="{{total>20 || page>1}}"><button bindtap="prev" disabled="{{page===1}}">上一页</button><text>{{page}} · {{total}} 条</text><button bindtap="next" disabled="{{page*20>=total}}">下一页</button></view></view>
