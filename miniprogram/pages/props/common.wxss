@import "../../styles/warehouse-entries.wxss";
page {
  background: #f6f6f6;
  color: #111827;
}
.prop-page {
  padding: 12px;
  padding-bottom: calc(112px + env(safe-area-inset-bottom));
  font-size: 14px;
}
.panel {
  background: #fff;
  border: 1px solid #ededed;
  border-radius: 8px;
  padding: 12px;
  margin-bottom: 10px;
}
.heading,
.section-title {
  font-size: 18px;
  font-weight: 900;
  margin-bottom: 12px;
}
.muted {
  font-size: 12px;
  color: #6b7280;
  line-height: 1.7;
}
.feedback {
  background: #fff7cc;
  padding: 12px;
  margin-bottom: 12px;
  overflow-wrap: anywhere;
}
.error {
  background: #fff0ed;
  color: #9d231c;
}
.form-row {
  margin: 12px 0;
}
.form-row label {
  display: block;
  margin-bottom: 8px;
  font-weight: 700;
}
.input,
.select,
input,
textarea {
  box-sizing: border-box;
  background: #f9f9f9;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 10px;
  width: 100%;
  min-height: 42px;
}
textarea {
  height: 84px;
}
.field-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}
.two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.style-options,
.tabs,
.actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.chip,
.tab {
  padding: 8px 10px;
  background: #f3f4f6;
  border-radius: 18px;
}
.active {
  background: #111;
  color: white;
}
.disabled {
  opacity: 0.45;
}
.primary-btn,
.primary {
  background: #ffe100;
  color: #111827;
}
.secondary-btn {
  background: #fff;
  border: 1px solid #ddd;
}
.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  display: flex;
  gap: 12px;
  padding: 12px 14px calc(12px + env(safe-area-inset-bottom));
  border-top: 1px solid #eee;
  z-index: 5;
}
.footer-actions button {
  flex: 1;
  font-size: 15px;
}
.upload-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}
.upload,
.thumb {
  width: 100%;
  height: 78px;
  background: #f0f0f0;
  border-radius: 8px;
}
.pill {
  font-size: 11px;
  padding: 5px 8px;
  border-radius: 12px;
  background: #fff2bc;
}
.row {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin: 10px 0;
}
.value {
  overflow-wrap: anywhere;
}
.mask {
  position: fixed;
  inset: 0;
  background: #0008;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 24px;
}
.dialog {
  background: white;
  border-radius: 16px;
  width: 100%;
  padding: 22px;
}
.dialog button {
  margin-top: 12px;
}
.price {
  color: #d84634;
  font-weight: 900;
}
.sn-code {
  font-family: monospace;
  font-size: 12px;
  overflow-wrap: anywhere;
}
.empty {
  padding: 32px 16px;
  text-align: center;
  color: #777;
}

.summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.summary view {
  padding: 12px;
  background: #f8f8f8;
  text-align: center;
}
.cover {
  width: 100%;
  height: 220px;
  background: #eee;
}
.link {
  color: #15688a;
}
.pager {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16px 0;
}
.pager button {
  font-size: 13px;
}
.detail-field {
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: 12px;
  margin: 12px 0;
}
.detail-field text:first-child {
  color: #6b7280;
}
.picture-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888;
  background: #eee;
}

.navigation-return{padding:12px 16px;color:#555;font-size:14px;background:#fff;overflow-wrap:anywhere}.heading{overflow-wrap:anywhere}.row>input{min-width:0;flex:1}

.warehouse-pager{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);font-size:12px;white-space:nowrap}
.warehouse-pager .warehouse-page-button{width:100%;min-width:0;margin:0;padding:0 8px;display:flex;align-items:center;justify-content:center;height:40px;line-height:1.2}

/* Shared list pager: preserve the count on narrow screens. */
.pager{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);font-size:12px;white-space:nowrap}.pager button{width:100%;min-width:0;margin:0;padding:0 8px;display:flex;align-items:center;justify-content:center;height:40px;line-height:1.2}

/* 02 formal forms: yellow primary, gray secondary, bounded controls and safe footer. */
.prop-page button{box-sizing:border-box;width:100%;min-width:0;max-width:100%;white-space:normal;overflow-wrap:anywhere}
.prop-page .primary-btn,.prop-page .primary{background:#ffe100;color:#111827;font-weight:900}
.prop-page .secondary-btn{background:#f5f5f5;color:#6b7280;border:0}
.prop-page button[disabled]{background:#e5e7eb;color:#9ca3af;opacity:1}
.prop-page .panel>button{margin-top:10px;border-radius:8px}
.prop-page .field-grid>view,.prop-page .row>view,.prop-page .row>text,.prop-page picker{min-width:0}
.prop-page .row>text:last-child{text-align:right;overflow-wrap:anywhere}
.prop-page .row>.pill{flex-shrink:0;align-self:flex-start}
.prop-page .select{display:flex;align-items:center;justify-content:space-between;gap:8px;white-space:normal;overflow-wrap:anywhere}
.prop-page .input,.prop-page input{height:44px;min-height:44px;padding:0 11px}
.prop-page textarea{padding:11px;line-height:1.6}
.prop-page .footer-actions{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);align-items:stretch}
.prop-page .footer-actions.single{grid-template-columns:minmax(0,1fr)}
.prop-page .footer-actions button{width:100%;min-width:0;margin:0;min-height:48px;border-radius:8px;padding:10px 8px;display:flex;align-items:center;justify-content:center}
.prop-page .actions>button{flex:1 1 120px;width:auto;margin:0}
.prop-page .upload-grid button.upload{width:100%;min-width:0;margin:0;padding:0;border:1px dashed #d1d5db;border-radius:8px;font-size:28px;display:flex;align-items:center;justify-content:center}
.prop-page .detail-field{grid-template-columns:86px minmax(0,1fr);line-height:1.6}
.prop-page .detail-field>text{overflow-wrap:anywhere}
.prop-page .summary{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.prop-page .summary>view{padding:12px 4px;border-radius:8px;min-width:0;overflow-wrap:anywhere}
.prop-page .summary>view>view{padding:0;font-size:24px;font-weight:900}
.prop-page .mask{padding:20px;z-index:30}
.prop-page .dialog{box-sizing:border-box;max-height:calc(100vh - 80px - env(safe-area-inset-bottom));overflow-y:auto;padding:20px}
.prop-page .filter-row{display:grid;grid-template-columns:84px minmax(0,1fr);gap:10px;align-items:center;margin:10px 0}
.prop-page .filter-row>text{font-size:13px;color:#6b7280}
.prop-page .filter-row .select{min-width:0;width:100%}
.prop-page .loading{padding:28px 16px;text-align:center;color:#6b7280}

page { background:var(--mj-canvas); color:var(--mj-ink); }
.prop-page { padding-inline:var(--mj-edge); }
.prop-page .panel, .prop-page .dialog { background:var(--mj-paper); border-color:var(--mj-line); border-radius:var(--mj-card); padding:14px; }
.prop-page .heading,.prop-page .section-title { font-weight:700; }
.prop-page .muted { color:var(--mj-muted); }
.prop-page .select,.prop-page input,.prop-page textarea { border-color:var(--mj-line); border-radius:var(--mj-control); }
.prop-page .footer-actions button,.prop-page .dialog button { min-width:0; min-height:var(--mj-tap); border-radius:var(--mj-control); }
.prop-page .primary-btn:not([disabled]) { background:var(--mj-accent); color:var(--mj-ink); }
.prop-page .active,.prop-page .chip.active { background:var(--mj-active-bg); color:var(--mj-active-ink); }
.prop-page .panel .row > view,.prop-page .panel .row > text:first-child { min-width:0; overflow-wrap:anywhere; }

.prop-page .filter-row > text { align-self:start; line-height:var(--mj-tap); }
.prop-page .field-grid { align-items:start; }
