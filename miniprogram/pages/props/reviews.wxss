@import "common.wxss";

.review-filter{display:grid;grid-template-columns:84px minmax(0,1fr);align-items:center;gap:8px;margin-top:10px;font-size:14px}.review-filter picker{min-width:0;width:100%}.review-filter .select{display:flex;justify-content:space-between;align-items:center;gap:8px;width:100%;min-width:0;min-height:44px}.review-filter .select text:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.review-filter .select text:last-child{flex-shrink:0}
