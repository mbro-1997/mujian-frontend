<view class="navigation-return" wx:if="{{!nativeBackAvailable}}" bindtap="navigationBack">‹ 返回</view><view class="prop-page" bindtouchstart="activity">
  <view wx:if="{{busy && !sku && !message}}" class="mj-read-state"><mj-loading label="正在读取道具资料"/></view><view wx:if="{{message && !dialog}}" class="feedback error">{{message}}<button bindtap="load">刷新资料</button></view><block wx:if="{{sku}}"><view class="panel"><view class="row"><text class="heading">{{sku.fields.propName}}</text><text class="pill">{{sku.pendingApplicationId?'审核中':state}}</text></view><view class="muted">{{sku.assetType==='A_ASSET'?'A 类资产型':'B 类数量型'}}</view><view class="sn-code">{{sku.skuCode}}</view></view>
  <view class="panel">
    <view class="heading">库存管理</view>
    <view wx:if="{{!sku.inventorySummary}}" class="muted">尚未形成库存</view>
    <view wx:elif="{{inventoryError}}" class="feedback error">{{inventoryError}}<button bindtap="load">重新读取库存</button></view>
    <view wx:elif="{{counts.length}}" class="summary"><view wx:for="{{counts}}" wx:key="label"><view>{{item.value}}</view><text class="muted">{{item.label}}</text></view></view>
    <mj-loading wx:elif="{{busy}}" label="正在读取库存"/>
    <view wx:if="{{sku.inventorySummary}}" class="stock-actions">
      <button wx:if="{{sku.assetType!=='A_ASSET'}}" bindtap="movements">查看库存流水</button>
      <button class="primary-btn" bindtap="adjust" disabled="{{!sku.canAdjustInventory}}">申请库存调整</button>
    </view>
  </view>
  <prop-fields fields="{{sku.fields}}"/>
  <view class="panel">
    <view class="detail-edits">
      <button bindtap="update" disabled="{{sku.pendingApplicationId || (sku.skuStatus!=='online' && sku.skuStatus!=='offline')}}">申请更新资料</button>
      <button bindtap="edit" disabled="{{!sku.canEditOptions}}">更新风格/类型/运输建议（免审）</button>
    </view>
  </view>
  <view class="footer-actions prop-actions"><button class="primary-btn" bindtap="inventory" disabled="{{!sku.inventorySummary}}">获取标签</button><button bindtap="history">审核管理</button><button wx:if="{{sku.skuStatus==='offline'}}" data-action="up" bindtap="status" disabled="{{!sku.canApplyUp}}">申请上架</button><button wx:else data-action="down" bindtap="status" disabled="{{!sku.canApplyDown}}">申请下架</button></view></block><view class="mask" wx:if="{{dialog}}"><view class="dialog"><view class="heading">申请{{action==='up'?'上架':'下架'}}？</view><view class="muted">审核期间暂不可租，已有订单不会被本次申请直接修改。</view><textarea adjust-position="{{false}}" fixed placeholder="请填写说明" maxlength="255" value="{{reason}}" bindinput="input"/><view wx:if="{{message}}" class="feedback">{{message}}</view><button class="primary-btn" bindtap="confirm" loading="{{busy && !returnRefresh}}" disabled="{{busy||!reason}}">确认提交</button><button bindtap="close" disabled="{{busy}}">返回</button></view></view></view>
