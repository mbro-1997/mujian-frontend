<view class="navigation-return" wx:if="{{!nativeBackAvailable}}" bindtap="navigationBack">‹ 返回</view><view class="prop-page" bindtouchstart="activity"><view wx:if="{{message}}" class="feedback error">{{message}}<button bindtap="load">刷新资料</button></view><block wx:if="{{sku}}"><view class="panel"><view class="row"><text class="heading">{{sku.fields.propName}}</text><text class="pill">{{sku.pendingApplicationId?'审核中':state}}</text></view><view class="muted">{{sku.assetType==='A_ASSET'?'A 类资产型':'B 类数量型'}}</view><view class="sn-code">{{sku.skuCode}}</view></view><view wx:if="{{sku.pendingApplicationId}}" class="feedback">SKU 审核期间不能修改资料、调整库存、贴标或维修完成。<button bindtap="review">查看待审申请</button></view><prop-fields fields="{{sku.fields}}"/><view class="panel"><view wx:if="{{!sku.inventorySummary}}" class="muted">尚未形成库存</view><button bindtap="inventory" disabled="{{!sku.inventorySummary}}">{{sku.assetType==='A_ASSET'?'管理实物 / 标签':'查看库存 / 流水'}}</button><button bindtap="history">审核管理</button><button bindtap="update" disabled="{{sku.pendingApplicationId || (sku.skuStatus!=='online' && sku.skuStatus!=='offline')}}">申请更新资料</button></view><view class="footer-actions"><button bindtap="edit" disabled="{{!sku.canEditOptions}}">编辑免审资料</button><button wx:if="{{sku.skuStatus==='offline'}}" data-action="up" bindtap="status" disabled="{{!sku.canApplyUp}}">申请上架</button><button wx:else data-action="down" bindtap="status" disabled="{{!sku.canApplyDown}}">申请下架</button></view></block><view class="mask" wx:if="{{dialog}}"><view class="dialog"><view class="heading">申请{{action==='up'?'上架':'下架'}}？</view><view class="muted">审核期间暂不可租，已有订单不会被本次申请直接修改。</view><textarea placeholder="请填写说明" maxlength="255" value="{{reason}}" bindinput="input"/><view wx:if="{{message}}" class="feedback">{{message}}</view><button class="primary-btn" bindtap="confirm" loading="{{busy}}" disabled="{{busy||!reason}}">确认提交</button><button bindtap="close" disabled="{{busy}}">返回</button></view></view></view>
