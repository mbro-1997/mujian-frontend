@import "common.wxss";
.product-page .cover{height:184px;border-radius:8px;overflow:hidden;border:1px solid #eee;margin-bottom:10px}
.product-title-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:start}
.product-title{font-size:22px;line-height:1.25;font-weight:900;overflow-wrap:anywhere}
.product-state{padding:6px 10px;border-radius:15px;background:#111827;color:#ffe100;font-size:12px;font-weight:900;white-space:nowrap}
.product-state.warn{background:#fee2e2;color:#dc2626}
.product-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}
.product-prices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:12px}
.product-prices>view{background:#f8fafc;border-radius:8px;padding:10px;min-width:0}
.product-prices text{font-size:11px;color:#6b7280;font-weight:700}
.product-prices>view>view{font-size:20px;font-weight:900;color:#ef4444;margin-top:3px;overflow-wrap:anywhere}
.product-note{margin-top:10px;background:#f8fafc;border:1px solid #eef0f3;border-radius:8px;padding:10px;color:#6b7280;font-size:12px;line-height:1.5}
.product-page .detail-field{background:#f8fafc;border-radius:8px;padding:8px 10px;font-size:13px;font-weight:700;grid-template-columns:84px minmax(0,1fr);gap:8px;margin:8px 0}
.product-page .detail-field>text:first-child{font-size:12px;font-weight:600}
.product-page .footer-actions button{border-radius:26px;min-height:52px}

.current-rental-period{border:1px solid #ffe100;background:#fff7cc;border-radius:26px;padding:8px 12px;display:flex;flex-direction:column;justify-content:center;line-height:1.4;font-size:12px;min-width:0}.current-rental-period>text{font-size:10px;color:#6b7280;margin-bottom:3px}.current-rental-period>view{overflow-wrap:anywhere}
@import "../../styles/renter-surfaces.wxss";
