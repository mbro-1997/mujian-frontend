<view class="date-page" bindtouchstart="activity"><view class="date-heading"><view>选择租赁时间</view><text>新建当前清单，原选品清单会挂起</text></view><view class="date-summary"><view class="date-box"><text>取货 / 开始</text><view>{{startLabel}}</view></view><view class="date-box"><text>归还 / 结束</text><view>{{endLabel}}</view></view><view class="date-duration">{{duration>0?duration+'天':'待选'}}</view></view><view class="month"><view class="month-head"><button class="month-button" data-offset="-1" bindtap="move" disabled="{{!canPrev}}" aria-label="上个月">‹</button><text>{{monthLabel}}</text><button class="month-button" data-offset="1" bindtap="move" aria-label="下个月">›</button></view><view class="calendar-week"><text wx:for="{{week}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid"><view wx:for="{{cells}}" wx:key="date" class="calendar-day {{item.disabled?'disabled':''}} {{item.inRange?'in-range':''}} {{item.start?'range-start':''}} {{item.end?'range-end':''}}" aria-role="button" aria-disabled="{{item.disabled}}" aria-label="{{item.accessibleLabel}}" data-date="{{item.date}}" bindtap="select"><text>{{item.day}}</text><text class="day-caption">{{item.start&&item.end?'取/还':item.start?'取':item.end?'还':''}}</text></view></view></view><view class="date-notice">租期含首尾，最长120天。确认后将按所选日期显示可租数量。</view><view wx:if="{{message || pendingCreate}}" class="date-error">{{message}}<button wx:if="{{pendingCreate}}" disabled="{{busy}}" bindtap="recover">查询原创建结果</button></view><view class="date-actions"><button class="date-reset" bindtap="reset">重置</button><button class="date-confirm" bindtap="confirm">{{busy?'创建中…':'新建清单并选品'}}</button></view></view>
<login-sheet visible="{{loginVisible}}" return-path="{{loginReturnPath}}" bindclose="closeLogin" bindauthenticated="loginSucceeded"/>
