page{background:#f6f6f6}.date-page{padding:18px 16px calc(108px + env(safe-area-inset-bottom));color:#111827}.date-heading{display:flex;justify-content:space-between;gap:8px;align-items:baseline;margin-bottom:16px}.date-heading>view{font-size:21px;font-weight:900}.date-heading>text{font-size:11px;color:#6b7280}.date-summary{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) 40px;gap:8px;align-items:center;margin-bottom:18px}.date-box{border:1px solid #eee;border-radius:10px;padding:12px 10px;background:white;min-width:0}.date-box>text{font-size:11px;color:#6b7280}.date-box>view{margin-top:6px;font-size:15px;font-weight:900}.date-duration{font-size:12px;font-weight:800;text-align:center}.month{background:white;border:1px solid #eee;border-radius:12px;padding:12px}.month-head{display:flex;align-items:center;justify-content:space-between;font-size:17px;font-weight:900;margin-bottom:10px}.month-head button.month-button{width:40px;min-width:0;height:40px;padding:0;margin:0;line-height:40px;background:white;font-size:26px}.month-button[disabled]{color:#d1d5db}.calendar-week,.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));text-align:center}.calendar-week{font-size:12px;color:#9ca3af;margin-bottom:10px}.calendar-day{min-height:44px;padding:6px 0;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:15px;font-weight:700;margin-bottom:4px}.calendar-day.disabled{color:#d1d5db}.calendar-day.in-range{background:#fff7cc}.calendar-day.range-start,.calendar-day.range-end{background:#ffe100;color:#111827;border-radius:8px}.day-caption{font-size:9px;min-height:12px;line-height:12px}.date-notice{margin-top:16px;padding:12px;background:#fff7cc;border-radius:8px;font-size:12px;line-height:1.6}.date-error{padding:12px;color:#b42318;font-size:13px;line-height:1.6}.date-actions{position:fixed;bottom:0;left:0;right:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:12px;padding:14px 16px calc(14px + env(safe-area-inset-bottom));background:white;border-top:1px solid #eee}.date-actions button{box-sizing:border-box;width:100%;min-width:0;margin:0;height:52px;padding:0 8px;line-height:52px;border-radius:26px;font-size:16px;font-weight:900}.date-reset{background:#f5f5f5;color:#6b7280}.date-confirm{background:#ffe100;color:#111827}
@import "../../styles/renter-surfaces.wxss";
