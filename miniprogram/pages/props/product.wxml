<view class="prop-page product-page"><view wx:if="{{message}}" class="feedback error">{{message}}<button bindtap="load">刷新</button><button wx:if="{{loginRequired}}" bindtap="login">登录后继续</button></view><view wx:if="{{busy}}" class="loading">正在加载道具资料</view><block wx:if="{{item}}"><swiper class="cover" indicator-dots current="{{currentImage}}" bindchange="imageChanged"><swiper-item wx:for="{{details.images}}" wx:key="index"><view wx:if="{{item}}" class="cover"><public-prop-image image="{{item}}" sku-id="{{id}}" start-date="{{startDate}}" end-date="{{endDate}}" lazy="{{false}}" active="{{loadedImages[index]}}" mode="aspectFill" data-index="{{index}}" bindpreview="preview" bindinaccessible="inaccessible"/></view><view wx:else class="cover picture-fallback">图片暂不可预览 · 刷新重试</view></swiper-item></swiper><view class="panel"><view class="product-title-row"><view class="product-title">{{item.propName}}</view><text class="product-state {{availability.rentableStatus==='unavailable'?'warn':''}}">{{availability ? (availability.rentableStatus==='rentable'?'该租期可租':'该租期不可租') : '方案'}}</text></view><view class="product-tags"><text wx:for="{{item.styles}}" wx:key="code" class="pill">{{item.label}}</text></view><view class="product-prices"><view><text>租金</text><view>¥{{rent}}/天</view></view><view><text>押金</text><view>¥{{deposit}}</view></view></view></view><view class="panel" wx:if="{{availability}}"><view class="heading">{{availability.rentableStatus==='rentable'?'该租期可租':'该租期不可租'}}</view><view>{{availability.startDate}} — {{availability.endDate}}</view><view>最多可租 {{availability.maxRentableQuantity}} 件 · {{joinedQuantity===null?selectionMessage:'当前清单已加入 '+joinedQuantity+' 件'}}</view></view><view class="panel"><view class="detail-field"><text>类别</text><text>{{item.type.label}}</text></view><view class="detail-field" wx:for="{{rows}}" wx:key="label"><text>{{item.label}}</text><text>{{item.value}}</text></view></view><view class="panel"><view class="detail-field"><text>工厂</text><text bindtap="customFactory">{{item.factory.name}} ›</text></view><button bindtap="customize">按此道具风格定制</button></view><view class="footer-actions {{availability?'':'single'}}"><view wx:if="{{availability}}" class="current-rental-period"><text>当前清单租期</text><view>{{availability.startDate}} 至 {{availability.endDate}}</view></view><button class="primary-btn" bindtap="unavailable" disabled="{{busy || !verified || availability.rentableStatus==='unavailable'}}">{{availability?'加入清单':'加入方案'}}</button></view></block></view>

<login-sheet visible="{{loginVisible}}" return-path="{{loginReturnPath}}" bindclose="closeLogin" bindauthenticated="loginSucceeded"/>

<scheme-picker wx:if="{{schemeProp}}" prop="{{schemeProp}}" bindclose="closeSchemePicker"/>

<checklist-picker wx:if="{{checklistProp}}" prop="{{checklistProp}}" bindclose="closeChecklistPicker" bindadded="checklistAdded"/>
