<view class="verify-page student" bindtouchstart="activity"><view class="verify-hero"><text class="eyebrow">学生身份审核</text><view class="title">学生认证状态</view><view class="description">学生认证用于确认学生身份。可以先提交材料，学生权益生效前需完成实名认证。</view></view><view wx:if="{{loading && !current}}" class="hint"><mj-loading label="正在读取认证状态"/></view><view wx:if="{{application && !editing}}" class="verify-card"><view class="title">{{heading}}</view><view class="status-row">{{application.applicationNo}}<text>申请编号</text></view><view class="status-row">{{application.schoolName}}<text>学校</text></view><view class="status-row" wx:if="{{application.expireAt}}">{{application.expireDisplay}}<text>有效截止时刻（达到此时刻即失效）</text></view><view class="hint">实名状态：{{realnameLabel}}。学生认证与实名认证独立；首期全额押金，本次认证不发券。</view><button class="secondary" bindtap="realname" wx:if="{{current.realnameStatus !== 'verified'}}">查看实名认证</button><view class="status-row">{{application.submittedDisplay}}<text>提交时间</text></view><view class="status-row" wx:if="{{application.reviewedDisplay}}">{{application.reviewedDisplay}}<text>审核时间</text></view><view class="reject" wx:if="{{application.rejectReason}}">{{application.rejectReason}}</view><view class="hint" wx:if="{{application.status === 'pending'}}">原申请正在审核，请耐心等待。提交后不可修改材料。</view></view><view wx:if="{{message}}" class="feedback">{{message}}<button wx:if="{{!current && !unknown}}" bindtap="load" disabled="{{loading}}">重试</button></view><view wx:if="{{unknown}}" class="verify-card"><view class="title">正在确认提交结果</view><view class="request-id">提交编号：{{requestId}}</view><button class="primary" bindtap="recover" loading="{{busy && !returnRefresh}}">查询原提交</button><button class="secondary" bindtap="retryOriginal" disabled="{{busy || !canRetryOriginal}}">使用原编号重试</button><button wx:if="{{canRefillOriginal}}" class="secondary" bindtap="refillOriginal" disabled="{{busy}}">重新填写并沿用原编号</button></view><view class="verify-actions"><button wx:if="{{!editing && !unknown && current.canSubmit}}" class="primary" bindtap="resubmit">{{application ? '重新提交材料' : '填写认证资料'}}</button></view></view>