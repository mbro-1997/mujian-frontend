<view class="page">
  <view class="notice">同一订单中，同一角色只能发起一次仲裁。已完成订单不可再申请仲裁。</view>

  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="value" class="tab {{activeTab === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="changeTab">{{item.label}}</view>
  </view>

  <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
    <view class="card-head">
      <view class="title">订单 {{item.orderNo || item.orderId}}</view>
      <view class="status {{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="line">发起方：{{item.applicantRoleText || '-'}}</view>
    <view class="line">发起节点：{{item.applyStageText || '-'}}</view>
    <view class="amount-row">
      <view>申请金额 <text>¥{{item.claimAmount}}</text></view>
      <view>押金上限 <text>¥{{item.depositAmount}}</text></view>
    </view>
    <view class="content">{{item.content}}</view>
    <view class="resolution" wx:if="{{item.resolution}}">裁定结果：{{item.resolution}}</view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">{{activeTab === 'pending' ? '暂无待仲裁记录' : '暂无已仲裁记录'}}</view>
</view>
