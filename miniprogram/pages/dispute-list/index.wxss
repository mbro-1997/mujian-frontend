page {
  background: #070b16;
}

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
    #070b16;
}

.notice,
.card,
.empty {
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  box-sizing: border-box;
}

.notice {
  padding: 20rpx 24rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.55;
}

.tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 20rpx 0;
}

.tab {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(30, 41, 59, 0.72);
  color: #94a3b8;
  font-size: 25rpx;
  font-weight: 700;
}

.tab.active {
  background: #22d3ee;
  color: #03111a;
}

.card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  color: #f8fafc;
}

.card-head,
.amount-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 800;
}

.status {
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.status.pending {
  background: rgba(251, 191, 36, 0.14);
  color: #fbbf24;
}

.status.resolved {
  background: rgba(52, 211, 153, 0.14);
  color: #34d399;
}

.status.closed {
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
}

.line,
.amount-row {
  margin-top: 12rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.amount-row text {
  color: #67e8f9;
  font-weight: 800;
}

.content,
.resolution {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(30, 41, 59, 0.56);
  color: #e2e8f0;
  font-size: 25rpx;
  line-height: 1.6;
}

.resolution {
  border: 1rpx solid rgba(34, 211, 238, 0.18);
  color: #bae6fd;
}

.empty {
  min-height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 25rpx;
}
